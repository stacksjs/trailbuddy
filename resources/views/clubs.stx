@extends('layouts/default')

@section('title', 'Clubs — TrailBuddy')

@section('content')
<script client>
  import { useClubs } from '../composables/useClubs'

  useHead({ title: 'Clubs — TrailBuddy' })

  const tb = useStore('tb')
  const filter = state<'all' | 'mine' | 'Running' | 'Hiking' | 'Territory Game'>('all')

  const {
    createOpen, submitting, createError,
    fName, fType, fLocation, fDescription, fPrivate,
    isMember, onToggleMembership, openCreate, closeCreate, submitCreate,
  } = useClubs(tb)

  const filtered = derived(() => {
    if (!tb) return []
    const f = filter()
    if (f === 'all') return tb.clubs()
    if (f === 'mine') return tb.clubs().filter((c: any) => isMember(c))
    return tb.clubs().filter((c: any) => c.type === f)
  })
</script>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
      <div>
        <h1 class="text-2xl font-bold dark:text-white">Clubs</h1>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Join a community of trail enthusiasts</p>
      </div>
      <button @click="openCreate()" class="px-4 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">+ Create Club</button>
    </div>

    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
      <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">All Clubs</button>
      <button @click="filter.set('mine')" x-class="filter === 'mine' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">My Clubs</button>
      <button @click="filter.set('Running')" x-class="filter === 'Running' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Running</button>
      <button @click="filter.set('Hiking')" x-class="filter === 'Hiking' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Hiking</button>
      <button @click="filter.set('Territory Game')" x-class="filter === 'Territory Game' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Territory Game</button>
    </div>

    <div class="space-y-6">
      <template :for="club in filtered">
        <div class="card">
          <div class="flex flex-col sm:flex-row gap-6">
            <div class="w-16 h-16 rounded-2xl flex items-center justify-center text-2xl font-bold shrink-0" x-class="club.type === 'Running' ? 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600' : club.type === 'Hiking' ? 'bg-blue-100 dark:bg-blue-900/20 text-blue-600' : club.type === 'Territory Game' ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-purple-100 dark:bg-purple-900/20 text-purple-600'" :text="club.name.charAt(0)"></div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4 mb-2">
                <div>
                  <StxLink x-to="'/club/' + club.id" class="font-bold text-lg text-gray-900 dark:text-white hover:text-emerald-600 transition" :text="club.name"></StxLink>
                  <div class="flex items-center gap-3 text-xs text-gray-500 dark:text-slate-400 mt-1">
                    <span :text="club.location"></span>
                    <span :text="club.memberCount + ' members'"></span>
                    <span class="px-1.5 py-0.5 rounded bg-gray-100 dark:bg-slate-700 font-medium" :text="club.type"></span>
                    <span :if="club.isPrivate" class="px-1.5 py-0.5 rounded bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 font-medium">Private</span>
                  </div>
                </div>
                <button @click="onToggleMembership(club)" class="shrink-0 px-4 py-2 text-sm font-semibold rounded-lg transition" x-class="isMember(club) ? 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300' : 'bg-emerald-600 text-white hover:bg-emerald-700'" :text="isMember(club) ? 'Joined' : 'Join'"></button>
              </div>
              <p class="text-sm text-gray-600 dark:text-slate-400 mb-4" :text="club.description"></p>
              <div class="flex items-center gap-6 pt-3 border-t border-gray-100 dark:border-slate-700 text-sm">
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold dark:text-white" :text="club.weeklyDistance + ' mi'"></span>
                  <span class="text-gray-500 dark:text-slate-400">this week</span>
                </div>
                <div class="flex items-center gap-1.5">
                  <span class="font-semibold dark:text-white" :text="club.activitiesThisWeek"></span>
                  <span class="text-gray-500 dark:text-slate-400">activities</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </template>

      <div :if="filtered.length === 0" class="py-20 text-center">
        <div class="w-20 h-20 mx-auto mb-6 bg-indigo-100 dark:bg-indigo-900/20 rounded-2xl flex items-center justify-center">
          <Icon name="users" size="40" class="text-indigo-400" />
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No clubs found</h3>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Join a running club to train with others and share routes.</p>
        <button @click="openCreate()" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Create a Club</button>
      </div>
    </div>
  </div>

  <!-- Create-club modal (#964) -->
  <div :if="createOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div @click="closeCreate()" class="absolute inset-0 bg-black/40"></div>
    <div class="relative w-full max-w-md card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg dark:text-white">Create a club</h2>
        <button @click="closeCreate()" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-200 text-xl leading-none">×</button>
      </div>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Name</label>
          <input type="text" placeholder="Trail Crushers" x-value="fName" @input="fName.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Type</label>
            <select x-value="fType" @change="fType.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
              <option value="Running">Running</option>
              <option value="Hiking">Hiking</option>
              <option value="Mixed">Mixed</option>
              <option value="Territory Game">Territory Game</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Location</label>
            <input type="text" placeholder="Bay Area, CA" x-value="fLocation" @input="fLocation.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Description</label>
          <textarea rows="2" placeholder="What's your club about?" x-value="fDescription" @input="fDescription.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm"></textarea>
        </div>
        <label class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-300">
          <input type="checkbox" x-checked="fPrivate" @change="fPrivate.set($event.target.checked)" class="h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500" />
          Private — only members can see it
        </label>
        <p :if="createError" class="text-sm text-red-500" :text="createError"></p>
        <div class="flex gap-2 pt-1">
          <button @click="submitCreate()" class="flex-1 px-4 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition" :text="submitting ? 'Creating…' : 'Create club'"></button>
          <button @click="closeCreate()" class="px-4 py-2.5 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 transition">Cancel</button>
        </div>
      </div>
    </div>
  </div>
@endsection
