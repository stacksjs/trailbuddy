@extends('layouts/default')

@section('title', 'Challenges — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Challenges — TrailBuddy' })

  const tb = useStore('tb')
  const tab = state<'active' | 'sent' | 'received' | 'completed'>('active')

  const currentUserId = derived(() => tb?.currentUserId())

  const filtered = derived(() => {
    if (!tb) return []
    const t = tab()
    const uid = tb.currentUserId()
    if (t === 'active') return tb.challenges().filter((c: any) => c.status === 'active' || c.status === 'pending')
    if (t === 'sent') return tb.challenges().filter((c: any) => c.challenger_id === uid)
    if (t === 'received') return tb.challenges().filter((c: any) => c.challenged_id === uid)
    return tb.challenges().filter((c: any) => c.status === 'completed')
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-4xl">
    <div class="flex flex-col gap-4 items-start justify-between sm:flex-row sm:items-center mb-6">
      <div>
        <h1 class="font-bold text-2xl dark:text-white">Challenges</h1>
        <p class="mt-1 text-gray-500 text-sm dark:text-slate-400">Challenge rivals to conquer their territories</p>
      </div>
      <button class="flex items-center px-4 py-2 font-semibold text-sm text-white bg-orange-600 hover:bg-orange-700 rounded-lg transition">+ New Challenge</button>
    </div>

    <div class="flex gap-1 mb-6 border-b border-gray-200 dark:border-slate-700">
      <button @click="tab.set('active')" x-class="tab === 'active' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Active</button>
      <button @click="tab.set('sent')" x-class="tab === 'sent' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Sent</button>
      <button @click="tab.set('received')" x-class="tab === 'received' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Received</button>
      <button @click="tab.set('completed')" x-class="tab === 'completed' ? 'border-orange-600 text-orange-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-4 py-3 font-medium text-sm border-b-2 transition">Completed</button>
    </div>

    <div class="space-y-4">
      <template :for="challenge in filtered">
        <div class="card">
          <div class="flex items-center justify-between mb-4">
            <span class="px-2 py-0.5 font-semibold text-xs rounded-full" x-class="challenge.status === 'active' ? 'bg-orange-100 text-orange-700' : challenge.status === 'pending' ? 'bg-yellow-100 text-yellow-700' : challenge.winner_id === currentUserId ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'" :text="challenge.status === 'active' ? 'IN PROGRESS' : challenge.status === 'pending' ? 'PENDING' : challenge.winner_id === currentUserId ? 'WON' : 'LOST'"></span>
            <span class="text-gray-500 text-xs dark:text-slate-400" :text="tb.timeAgo(challenge.created_at)"></span>
          </div>

          <div class="flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 flex-1">
              <div class="flex items-center justify-center h-12 w-12 font-bold text-orange-600 bg-orange-100 dark:bg-orange-900/20 rounded-full" :text="challenge.challengerName.charAt(0)"></div>
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white" :text="challenge.challenger_id === currentUserId ? 'You' : challenge.challengerName"></p>
                <p class="text-xs text-gray-500 dark:text-slate-400">Challenger</p>
              </div>
            </div>
            <div class="shrink-0 w-10 h-10 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-gray-500 dark:text-slate-400">VS</div>
            <div class="flex items-center gap-3 flex-1 justify-end text-right">
              <div>
                <p class="font-semibold text-sm text-gray-900 dark:text-white" :text="challenge.challenged_id === currentUserId ? 'You' : challenge.challengedName"></p>
                <p class="text-xs text-gray-500 dark:text-slate-400">Defender</p>
              </div>
              <div class="flex items-center justify-center h-12 w-12 font-bold text-blue-600 bg-blue-100 dark:bg-blue-900/20 rounded-full" :text="challenge.challengedName.charAt(0)"></div>
            </div>
          </div>

          <div class="mt-4 p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-slate-300">
              Territory:
              <StxLink x-to="'/territory/' + challenge.territory_id" class="font-medium text-emerald-600 hover:underline" :text="challenge.territoryName"></StxLink>
            </div>
            <span class="text-xs text-gray-500 dark:text-slate-400" :text="(challenge.areaAtStake / 1000).toFixed(1) + ' km²'"></span>
          </div>
        </div>
      </template>

      <div :if="filtered.length === 0" class="py-20 text-center">
        <div class="w-20 h-20 mx-auto mb-6 bg-purple-100 dark:bg-purple-900/20 rounded-2xl flex items-center justify-center">
          <svg class="w-10 h-10 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No challenges yet</h3>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Pick a rival's territory and throw down the gauntlet.</p>
        <StxLink to="/territories" class="px-6 py-2.5 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">Find Rivals</StxLink>
      </div>
    </div>
  </div>
@endsection
