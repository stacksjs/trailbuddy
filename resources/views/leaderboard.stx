@extends('layouts/default')

@section('title', 'Leaderboard — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Leaderboard — TrailBuddy' })

  interface LeaderEntry {
    userName: string
    totalDistance: number
    totalElevation: number
    trailsCompleted: number
  }

  const tb = getStore<any>('tb')
  const period = state<'weekly' | 'monthly' | 'alltime'>('weekly')
  const metric = state<'distance' | 'elevation' | 'activities'>('distance')

  const leaders = derived<LeaderEntry[]>(() => {
    if (!tb) return []
    return tb.users.map((u: any) => {
      const userActs = tb.activities.filter((a: any) => a.user_id === u.id)
      return {
        userName: u.name,
        totalDistance: userActs.reduce((sum: number, a: any) => sum + (a.distance || 0), 0),
        totalElevation: userActs.reduce((sum: number, a: any) => sum + (a.elevation_gain || 0), 0),
        trailsCompleted: new Set(userActs.map((a: any) => a.trail_id)).size,
      }
    }).sort((a: LeaderEntry, b: LeaderEntry) => b.totalDistance - a.totalDistance)
  })
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-3xl">
    <h1 class="mb-6 font-bold text-2xl dark:text-white">Leaderboard</h1>

    <!-- Period tabs -->
    <div class="flex gap-2 mb-4">
      <button @click="period.set('weekly')" :class="period === 'weekly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 rounded-lg text-sm font-medium transition">This Week</button>
      <button @click="period.set('monthly')" :class="period === 'monthly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 rounded-lg text-sm font-medium transition">This Month</button>
      <button @click="period.set('alltime')" :class="period === 'alltime' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 rounded-lg text-sm font-medium transition">All Time</button>
    </div>

    <!-- Metric tabs -->
    <div class="flex gap-2 mb-6">
      <button @click="metric.set('distance')" :class="metric === 'distance' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-sm border-b-2 transition">Distance</button>
      <button @click="metric.set('elevation')" :class="metric === 'elevation' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-sm border-b-2 transition">Elevation</button>
      <button @click="metric.set('activities')" :class="metric === 'activities' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-3 py-1.5 font-medium text-sm border-b-2 transition">Activities</button>
    </div>

    <!-- Top 3 podium -->
    <div :if="leaders.length >= 3" class="grid gap-4 grid-cols-3 mb-8">
      <div class="pt-8 text-center card">
        <div class="flex items-center justify-center mb-2 mx-auto h-14 w-14 font-bold text-gray-600 text-xl dark:text-slate-300 bg-gray-200 dark:bg-slate-700 rounded-full" :text="(leaders[1]?.userName || 'U').charAt(0)"></div>
        <p class="font-semibold text-sm truncate dark:text-white" :text="leaders[1]?.userName || 'Athlete'"></p>
        <p class="mt-1 font-bold text-gray-400 text-lg">2nd</p>
        <p class="font-semibold text-emerald-600 text-sm" :text="(leaders[1]?.totalDistance || 0).toFixed(1) + ' mi'"></p>
      </div>
      <div class="ring-2 ring-yellow-400 pt-4 text-center card">
        <div class="mb-1 text-2xl">👑</div>
        <div class="flex items-center justify-center mb-2 mx-auto h-16 w-16 font-bold text-2xl text-yellow-600 bg-yellow-100 dark:bg-yellow-900/30 rounded-full" :text="(leaders[0]?.userName || 'U').charAt(0)"></div>
        <p class="font-bold text-sm truncate dark:text-white" :text="leaders[0]?.userName || 'Athlete'"></p>
        <p class="mt-1 font-bold text-lg text-yellow-500">1st</p>
        <p class="font-semibold text-emerald-600 text-sm" :text="(leaders[0]?.totalDistance || 0).toFixed(1) + ' mi'"></p>
      </div>
      <div class="pt-8 text-center card">
        <div class="flex items-center justify-center mb-2 mx-auto h-14 w-14 font-bold text-orange-600 text-xl bg-orange-100 dark:bg-orange-900/30 rounded-full" :text="(leaders[2]?.userName || 'U').charAt(0)"></div>
        <p class="font-semibold text-sm truncate dark:text-white" :text="leaders[2]?.userName || 'Athlete'"></p>
        <p class="mt-1 font-bold text-lg text-orange-400">3rd</p>
        <p class="font-semibold text-emerald-600 text-sm" :text="(leaders[2]?.totalDistance || 0).toFixed(1) + ' mi'"></p>
      </div>
    </div>

    <!-- Full list -->
    <div class="space-y-2">
      <template :for="(leader, index) in leaders">
        <div class="flex gap-4 items-center py-3 card">
          <span class="w-8 font-bold text-center text-sm" :class="index < 3 ? 'text-emerald-600' : 'text-gray-400 dark:text-slate-500'" :text="index + 1"></span>
          <div class="flex items-center justify-center shrink-0 h-10 w-10 font-bold text-gray-600 text-sm dark:text-slate-300 bg-gray-100 dark:bg-slate-700 rounded-full" :text="leader.userName.charAt(0)"></div>
          <div class="flex-1 min-w-0">
            <p class="font-semibold text-sm truncate dark:text-white" :text="leader.userName"></p>
            <p class="text-gray-500 text-xs dark:text-slate-400" :text="leader.trailsCompleted + ' trails completed'"></p>
          </div>
          <div class="shrink-0 text-right">
            <p class="font-bold text-emerald-600 text-sm" :text="leader.totalDistance.toFixed(1) + ' mi'"></p>
            <p class="text-gray-400 text-xs dark:text-slate-500" :text="leader.totalElevation.toLocaleString() + ' ft'"></p>
          </div>
        </div>
      </template>
    </div>

    <!-- Empty state -->
    <div :if="leaders.length === 0" class="py-20 text-center">
      <div class="w-20 h-20 mx-auto mb-6 bg-yellow-100 dark:bg-yellow-900/20 rounded-2xl flex items-center justify-center">
        <svg class="w-10 h-10 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No rankings yet</h3>
      <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Start recording activities to climb the leaderboard.</p>
      <StxLink to="/record" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Record Activity</StxLink>
    </div>
  </div>
@endsection
