@extends('layouts/default')

@section('title', 'Home — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Home — TrailBuddy' })

  const tb = useStore('tb')

  const myTerritories = derived(() => tb ? tb.myTerritories() : [])
  const totalArea = derived(() => myTerritories().reduce((s: number, t: any) => s + t.areaSize, 0))
  const liveBattles = derived(() => tb ? tb.liveConquests() : [])
  const recent = derived(() => tb ? tb.activities().slice(0, 4) : [])
  const stats = derived(() => tb?.userStats())
  const gameStats = derived(() => tb?.conquestStats())
</script>

  <!-- Hero: turf war first -->
  <section class="relative bg-gradient-to-br from-slate-900 via-emerald-900 to-teal-800 overflow-hidden">
    <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_30%_20%,#34d399,transparent_50%)]"></div>
    <div class="relative mx-auto px-4 py-16 sm:px-6 lg:px-8 lg:py-20 max-w-7xl">
      <div class="grid gap-10 items-center lg:grid-cols-2">
        <div>
          <span class="inline-flex items-center gap-1.5 mb-4 px-3 py-1 text-xs font-bold text-emerald-300 bg-emerald-500/20 rounded-full border border-emerald-400/30">
            <Icon name="zap" size="14" />
            Strava meets turf wars
          </span>
          <h1 class="mb-4 font-display text-4xl font-bold text-white md:text-5xl lg:text-6xl leading-tight">Run. Track. Capture.</h1>
          <p class="mb-8 text-lg text-slate-300 max-w-lg">Log every mile like Strava, then run through rival zones on the map to steal territory — the Interval-style game loop, on real trails.</p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <StxLink to="/record" class="inline-flex items-center justify-center gap-2 px-8 py-3.5 font-bold text-slate-900 bg-emerald-400 hover:bg-emerald-300 rounded-full shadow-lg shadow-emerald-500/30 transition">
              <Icon name="play" size="18" />
              Start capture run
            </StxLink>
            <StxLink to="/trails" class="px-8 py-3.5 text-center font-semibold text-white border-2 border-white/25 hover:bg-white/10 rounded-full transition">Explore trails</StxLink>
          </div>
        </div>

        <div class="game-dashboard-card">
          <p class="mb-4 text-xs font-bold text-emerald-400 uppercase tracking-wider">Your empire</p>
          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <p class="text-3xl font-bold text-white" :text="myTerritories().length"></p>
              <p class="metric-label text-slate-400">Zones owned</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-white" :text="(totalArea() / 1000).toFixed(1) + ' km²'"></p>
              <p class="metric-label text-slate-400">Turf controlled</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-emerald-400" :text="gameStats?.powerRating ?? 0"></p>
              <p class="metric-label text-slate-400">Power rating</p>
            </div>
            <div>
              <p class="text-3xl font-bold text-white" :text="stats?.weeklyDistance?.toFixed(1) ?? '0'"></p>
              <p class="metric-label text-slate-400">Mi this week</p>
            </div>
          </div>
          <div :if="liveBattles.length > 0" class="pt-4 border-t border-white/10">
            <p class="flex gap-2 items-center mb-2 text-xs font-semibold text-orange-400">
              <span class="h-2 w-2 bg-red-500 rounded-full animate-pulse"></span>
              <span :text="liveBattles.length + ' live battle' + (liveBattles.length > 1 ? 's' : '')"></span>
            </p>
            <StxLink to="/battles" class="text-sm text-white/80 hover:text-white underline">Watch the map →</StxLink>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Weekly activity strip (Strava) -->
  <section class="bg-white dark:bg-slate-800 border-b border-gray-100 dark:border-slate-700">
    <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="font-bold text-lg dark:text-white">This week</h2>
          <p class="text-sm text-gray-500 dark:text-slate-400" :text="(stats?.weeklyActivities ?? 0) + ' activities · ' + (stats?.currentStreak ?? 0) + ' day streak'"></p>
        </div>
        <div class="grid grid-cols-3 gap-6 sm:gap-10 text-center">
          <div>
            <p class="text-2xl font-bold text-emerald-600" :text="stats?.weeklyDistance?.toFixed(1) ?? '0'"></p>
            <p class="metric-label">Miles</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-emerald-600" :text="(stats?.weeklyElevation ?? 0).toLocaleString()"></p>
            <p class="metric-label">Elevation</p>
          </div>
          <div>
            <p class="text-2xl font-bold text-emerald-600" :text="gameStats?.totalConquests ?? 0"></p>
            <p class="metric-label">Conquests</p>
          </div>
        </div>
        <StxLink to="/stats" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 whitespace-nowrap">Full stats →</StxLink>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto px-4 py-14 sm:px-6 lg:px-8 max-w-7xl">
    <h2 class="mb-8 font-bold font-display text-2xl text-center dark:text-white md:text-3xl">How capture runs work</h2>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="card text-center">
        <div class="flex items-center justify-center mx-auto mb-3 h-12 w-12 text-emerald-600 bg-emerald-100 dark:bg-emerald-900/30 rounded-xl">
          <Icon name="footprints" size="24" />
        </div>
        <h3 class="mb-2 font-bold dark:text-white">1. Record</h3>
        <p class="text-sm text-gray-500 dark:text-slate-400">Start a capture run with GPS or simulate a trail. Strava-style pace, distance, and elevation live.</p>
      </div>
      <div class="card text-center">
        <div class="flex items-center justify-center mx-auto mb-3 h-12 w-12 text-purple-600 bg-purple-100 dark:bg-purple-900/30 rounded-xl">
          <Icon name="map" size="24" />
        </div>
        <h3 class="mb-2 font-bold dark:text-white">2. Paint turf</h3>
        <p class="text-sm text-gray-500 dark:text-slate-400">Run through enemy polygons on the map. Your path fills a capture meter — like claiming tiles in a territory game.</p>
      </div>
      <div class="card text-center">
        <div class="flex items-center justify-center mx-auto mb-3 h-12 w-12 text-orange-600 bg-orange-100 dark:bg-orange-900/30 rounded-xl">
          <Icon name="trophy" size="24" />
        </div>
        <h3 class="mb-2 font-bold dark:text-white">3. Dominate</h3>
        <p class="text-sm text-gray-500 dark:text-slate-400">Complete the capture to flip the zone, earn XP, climb the leaderboard, and defend from rivals.</p>
      </div>
    </div>
  </section>

  <!-- Recent activity feed -->
  <section class="mx-auto px-4 py-12 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex items-center justify-between mb-6">
      <h2 class="font-bold font-display text-2xl dark:text-white">Recent runs</h2>
      <StxLink to="/feed" class="text-sm font-semibold text-emerald-600">Full feed →</StxLink>
    </div>
    <div class="space-y-4">
      <template :for="activity in recent">
        <StxLink x-to="'/activity/' + activity.id" class="card flex flex-col gap-4 sm:flex-row sm:items-center hover:shadow-md transition block">
          <div class="flex gap-3 items-center flex-1 min-w-0">
            <div class="shrink-0 flex items-center justify-center h-12 w-12 font-bold text-emerald-600 bg-emerald-100 dark:bg-emerald-900/30 rounded-full" :text="activity.userName.charAt(0)"></div>
            <div class="min-w-0">
              <p class="font-bold dark:text-white truncate" :text="activity.title"></p>
              <p class="text-sm text-gray-500 dark:text-slate-400" :text="activity.activityType + ' · ' + tb.timeAgo(activity.created_at)"></p>
            </div>
          </div>
          <div class="grid grid-cols-4 gap-4 text-center shrink-0">
            <div><p class="font-bold text-emerald-600" :text="activity.distance.toFixed(1)"></p><p class="metric-label">mi</p></div>
            <div><p class="font-bold dark:text-white text-sm" :text="activity.duration"></p><p class="metric-label">time</p></div>
            <div><p class="font-bold dark:text-white text-sm" :text="activity.pace"></p><p class="metric-label">pace</p></div>
            <div><p class="font-bold dark:text-white text-sm" :text="activity.kudos_count"></p><p class="metric-label">kudos</p></div>
          </div>
        </StxLink>
      </template>
      <div :if="recent.length === 0" class="card text-center py-10">
        <Icon name="footprints" size="28" class="mx-auto mb-2 text-emerald-400" />
        <p class="font-medium text-gray-700 dark:text-slate-300">No runs yet</p>
        <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Record your first capture run to see it here.</p>
        <StxLink to="/record" class="inline-block px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Start a run</StxLink>
      </div>
    </div>
  </section>

  <!-- Territories preview -->
  <section class="bg-slate-50 dark:bg-slate-900/50 py-14">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between mb-8">
        <div>
          <h2 class="font-bold font-display text-2xl dark:text-white">Your territories</h2>
          <p class="text-gray-500 dark:text-slate-400">Hold ground or launch your next attack</p>
        </div>
        <StxLink to="/territories" class="px-5 py-2.5 font-semibold text-sm text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition">Open territory map</StxLink>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <template :for="t in myTerritories">
          <StxLink x-to="'/territory/' + t.id" class="card block hover:border-emerald-400 transition">
            <div class="flex justify-between items-start mb-2">
              <h3 class="font-bold dark:text-white" :text="t.name"></h3>
              <span class="px-2 py-0.5 text-xs font-semibold text-emerald-700 bg-emerald-100 dark:bg-emerald-900/40 rounded-full" :text="t.status"></span>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400" :text="(t.areaSize / 1000).toFixed(1) + ' km² · ' + t.defendCount + ' defenses'"></p>
          </StxLink>
        </template>
      </div>
      <div :if="myTerritories.length === 0" class="card text-center py-12">
        <Icon name="map" size="32" class="mx-auto mb-2 text-emerald-400" />
        <p class="font-semibold text-gray-900 dark:text-white mb-1">You don't hold any turf yet</p>
        <p class="text-sm text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-4">Run a closed loop to claim your first territory, then defend it from rivals.</p>
        <StxLink to="/record" class="inline-block px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Claim your first zone</StxLink>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-emerald-600 to-teal-600 py-16">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl text-center">
      <h2 class="mb-3 font-bold font-display text-3xl text-white">Rivals are on your border</h2>
      <p class="mb-8 text-white/85">Lace up, open the map, and run the lines that matter.</p>
      <StxLink to="/record" class="inline-flex items-center gap-2 px-10 py-4 font-bold text-emerald-800 bg-white hover:bg-gray-100 rounded-full shadow-xl transition">
        <Icon name="zap" size="20" />
        Go capture
      </StxLink>
    </div>
  </section>
@endsection
