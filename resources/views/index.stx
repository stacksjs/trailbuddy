@extends('layouts/default')

@section('title', 'Home — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Home — TrailBuddy' })

  const tb = useStore('tb')
  const activeFilter = state<'all' | 'easy' | 'moderate' | 'hard'>('all')

  const popular = derived(() => tb ? tb.trails().slice(0, 6) : [])
  const recent = derived(() => tb ? tb.activities().slice(0, 3) : [])
  const featured = derived(() => tb ? (tb.trails().find((t: any) => t.difficulty === 'hard') || tb.trails()[0]) : null)

  const filteredPopular = derived(() => {
    const list = popular()
    const f = activeFilter()
    return f === 'all' ? list : list.filter((t: any) => t.difficulty === f)
  })
</script>

  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-emerald-600 via-teal-600 to-emerald-700 overflow-hidden">
    <div class="relative mx-auto px-4 py-20 sm:px-6 lg:px-8 lg:py-28 max-w-7xl">
      <div class="grid gap-12 items-center lg:grid-cols-2">
        <div>
          <span class="inline-block mb-4 px-3 py-1 text-xs font-semibold text-white bg-white/20 rounded-full backdrop-blur-sm">🏃 Discover · Track · Conquer</span>
          <h1 class="mb-6 font-display text-4xl font-bold text-white md:text-5xl lg:text-6xl leading-tight">Your Trail Adventure Starts Here</h1>
          <p class="mb-8 text-lg text-white/80 max-w-lg">Find amazing trails, track your runs and hikes, and compete for territory with runners worldwide.</p>
          <div class="flex flex-col gap-3 sm:flex-row">
            <StxLink to="/trails" class="px-6 py-3 text-center font-semibold text-emerald-700 bg-white hover:bg-gray-100 rounded-full shadow-lg transition">Explore Trails</StxLink>
            <StxLink to="/record" class="px-6 py-3 text-center font-semibold text-white border-2 border-white/30 hover:bg-white/10 rounded-full transition">Start Recording</StxLink>
          </div>
        </div>

        <div :if="featured" class="relative">
          <StxLink x-to="'/trail/' + featured.id" class="block bg-white rounded-2xl shadow-2xl overflow-hidden hover:scale-[1.02] transition-transform">
            <div class="relative h-56 overflow-hidden">
              <img x-src="featured.image || 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&h=600&fit=crop'" x-alt="featured.name" class="w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 capitalize font-semibold text-xs rounded-full" x-class="'difficulty-' + featured.difficulty" :text="featured.difficulty"></span>
              </div>
              <div class="absolute bottom-4 left-4 right-4 text-white">
                <h3 class="font-bold text-xl mb-1" :text="featured.name"></h3>
                <p class="text-sm text-white/80" :text="featured.location"></p>
              </div>
            </div>
            <div class="p-5 grid grid-cols-3 gap-3">
              <div class="text-center">
                <p class="font-bold text-gray-900 text-lg" :text="featured.distance + ' mi'"></p>
                <p class="metric-label">Distance</p>
              </div>
              <div class="text-center">
                <p class="font-bold text-gray-900 text-lg" :text="featured.elevation.toLocaleString()"></p>
                <p class="metric-label">Elev (ft)</p>
              </div>
              <div class="text-center">
                <p class="font-bold text-gray-900 text-lg">★ <span :text="featured.rating"></span></p>
                <p class="metric-label">Rating</p>
              </div>
            </div>
          </StxLink>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Strip -->
  <section class="bg-white dark:bg-slate-800 border-b border-gray-100 dark:border-slate-700">
    <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div><p class="text-3xl font-bold text-emerald-600">12K+</p><p class="metric-label mt-1">Trails</p></div>
        <div><p class="text-3xl font-bold text-emerald-600">250K+</p><p class="metric-label mt-1">Runners</p></div>
        <div><p class="text-3xl font-bold text-emerald-600">8M+</p><p class="metric-label mt-1">Miles Logged</p></div>
        <div><p class="text-3xl font-bold text-emerald-600">45K+</p><p class="metric-label mt-1">Territories</p></div>
      </div>
    </div>
  </section>

  <!-- Popular Trails -->
  <section class="mx-auto px-4 py-16 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex flex-col gap-4 items-start justify-between sm:flex-row sm:items-center mb-8">
      <div>
        <h2 class="font-bold font-display text-3xl text-gray-900 dark:text-white md:text-4xl">Popular Trails</h2>
        <p class="mt-2 text-gray-500 dark:text-slate-400">Discover the best-rated trails near you</p>
      </div>
      <div class="flex gap-2 overflow-x-auto">
        <button @click="activeFilter.set('all')" x-class="activeFilter === 'all' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">All</button>
        <button @click="activeFilter.set('easy')" x-class="activeFilter === 'easy' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Easy</button>
        <button @click="activeFilter.set('moderate')" x-class="activeFilter === 'moderate' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Moderate</button>
        <button @click="activeFilter.set('hard')" x-class="activeFilter === 'hard' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Hard</button>
      </div>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <template :for="trail in filteredPopular">
        <StxLink x-to="'/trail/' + trail.id" class="block overflow-hidden p-0 card hover:shadow-lg transition group">
          <div class="relative h-48 overflow-hidden">
            <img x-src="trail.image || 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=800&h=600&fit=crop'" x-alt="trail.name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute top-3 left-3">
              <span class="px-2 py-1 capitalize font-semibold text-xs rounded-full" x-class="'difficulty-' + trail.difficulty" :text="trail.difficulty"></span>
            </div>
          </div>
          <div class="p-4">
            <div class="flex items-start justify-between mb-1">
              <h3 class="font-bold text-gray-900 dark:text-white group-hover:text-emerald-600 transition" :text="trail.name"></h3>
              <span class="text-sm font-semibold text-yellow-500" :text="'★ ' + trail.rating"></span>
            </div>
            <p class="text-sm text-gray-500 dark:text-slate-400 mb-3" :text="trail.location"></p>
            <div class="flex items-center gap-4 text-xs text-gray-500 dark:text-slate-400 pt-3 border-t border-gray-100 dark:border-slate-700">
              <span :text="trail.distance + ' mi'"></span>
              <span :text="trail.elevation.toLocaleString() + ' ft'"></span>
              <span :text="'~' + trail.estimatedTime"></span>
            </div>
          </div>
        </StxLink>
      </template>
    </div>

    <div class="mt-10 text-center">
      <StxLink to="/trails" class="inline-flex items-center gap-2 px-6 py-3 font-semibold text-emerald-600 hover:text-emerald-700 border-2 border-emerald-200 hover:border-emerald-500 rounded-full transition">View All Trails →</StxLink>
    </div>
  </section>

  <!-- Recent Activity -->
  <section class="mx-auto px-4 py-16 sm:px-6 lg:px-8 max-w-7xl">
    <div class="mb-8 text-center">
      <h2 class="mb-2 font-bold font-display text-3xl text-gray-900 dark:text-white md:text-4xl">Recent Activity</h2>
      <p class="text-gray-500 dark:text-slate-400">See what the community is up to</p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      <template :for="activity in recent">
        <StxLink x-to="'/activity/' + activity.id" class="card block hover:shadow-md transition">
          <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 font-bold text-sm" :text="activity.userName.charAt(0)"></div>
            <div>
              <p class="font-semibold text-sm text-gray-900 dark:text-white" :text="activity.userName"></p>
              <p class="text-xs text-gray-500 dark:text-slate-400" :text="activity.activityType + ' · ' + tb.timeAgo(activity.created_at)"></p>
            </div>
          </div>
          <p class="font-bold text-gray-900 dark:text-white mb-3" :text="activity.title"></p>
          <div class="grid grid-cols-3 gap-2 text-center">
            <div>
              <p class="font-bold text-sm text-emerald-600" :text="activity.distance.toFixed(1)"></p>
              <p class="metric-label">mi</p>
            </div>
            <div>
              <p class="font-bold text-sm dark:text-white" :text="activity.duration"></p>
              <p class="metric-label">time</p>
            </div>
            <div>
              <p class="font-bold text-sm dark:text-white" :text="activity.elevation_gain.toLocaleString()"></p>
              <p class="metric-label">ft</p>
            </div>
          </div>
        </StxLink>
      </template>
    </div>

    <div class="mt-8 text-center">
      <StxLink to="/feed" class="text-emerald-600 hover:text-emerald-700 font-semibold text-sm">View full feed →</StxLink>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-emerald-600 to-teal-600 py-16">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl text-center">
      <h2 class="mb-4 font-bold font-display text-3xl text-white md:text-4xl">Ready to hit the trails?</h2>
      <p class="mb-8 text-white/80 text-lg">Record your first adventure and start building your empire.</p>
      <div class="flex flex-col gap-3 items-center justify-center sm:flex-row">
        <StxLink to="/record" class="px-8 py-3 font-semibold text-emerald-700 bg-white hover:bg-gray-100 rounded-full shadow-lg transition">Start Recording</StxLink>
        <StxLink to="/territories" class="px-8 py-3 font-semibold text-white border-2 border-white/30 hover:bg-white/10 rounded-full transition">View Territories</StxLink>
      </div>
    </div>
  </section>
@endsection
