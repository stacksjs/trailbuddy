    const reviews = [
      { id: 1, trail_id: 3, user_id: 1, userName: 'You', rating: 5, text: 'Absolutely stunning! The waterfall was roaring. Best trail run I\'ve done this year.', conditions: 'Wet but manageable', created_at: ago(0, 3) },
      { id: 2, trail_id: 3, user_id: 2, userName: 'Sarah Chen', rating: 5, text: 'Magical place. Go early to beat the crowds. The mist from the falls is refreshing on a warm day.', conditions: 'Perfect', created_at: ago(5) },
      { id: 3, trail_id: 3, user_id: 5, userName: 'Jake Thompson', rating: 4, text: 'Great trail but very crowded on weekends. Would recommend a weekday visit.', conditions: 'Good', created_at: ago(12) },
      { id: 4, trail_id: 1, user_id: 2, userName: 'Sarah Chen', rating: 5, text: 'The summit views are unreal. Bring layers — it\'s cold and windy at the top even in summer.', conditions: 'Windy at summit', created_at: ago(0, 8) },
      { id: 5, trail_id: 1, user_id: 3, userName: 'Marcus Johnson', rating: 4, text: 'Tough but rewarding. The scramble section near the top requires good footwork.', conditions: 'Some snow patches', created_at: ago(15) },
      { id: 6, trail_id: 6, user_id: 3, userName: 'Marcus Johnson', rating: 5, text: 'Sedona never disappoints. This loop has it all — technical terrain, views, and red rock beauty.', conditions: 'Hot and dry', created_at: ago(1, 6) },
