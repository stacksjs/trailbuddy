@extends('layouts/default')

@section('title', 'Conquests — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Conquests — TrailBuddy' })

  const tb = getStore<any>('tb')
  const filter = state<'all' | 'attacks' | 'defenses' | 'lost'>('all')

  const filtered = derived(() => {
    if (!tb) return []
    const f = filter()
    const uid = tb.currentUserId
    if (f === 'all') return tb.conquests
    if (f === 'attacks') return tb.conquests.filter((c: any) => c.attacker_id === uid)
    if (f === 'defenses') return tb.conquests.filter((c: any) => c.defender_id === uid)
    return tb.conquests.filter((c: any) => c.defender_id === uid && c.status === 'conquered')
  })

  const underAttack = derived(() =>
    tb ? tb.conquests.filter((c: any) => c.defender_id === tb.currentUserId && c.status === 'active').slice(0, 5) : []
  )
</script>

  <!-- Hero -->
  <section class="relative overflow-hidden pb-16 pt-24 bg-gradient-to-br from-orange-600 via-red-600 to-orange-700">
    <div class="relative mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl text-center">
      <h1 class="mb-6 font-bold font-display text-4xl text-white md:text-5xl lg:text-6xl">Your Conquests</h1>
      <p class="mb-8 mx-auto max-w-2xl text-white/80 text-xl">Track every territory you've taken and every attack on your empire.</p>
      <div class="flex flex-col gap-4 items-center justify-center sm:flex-row">
        <StxLink to="/territories" class="px-8 py-4 w-full sm:w-auto font-semibold text-lg text-orange-700 bg-white hover:bg-gray-100 rounded-full shadow-xl transition">View Map</StxLink>
        <StxLink to="/record" class="px-8 py-4 w-full sm:w-auto font-semibold text-lg text-white hover:bg-white/10 border-2 border-white/30 rounded-full transition">Start a Conquest Run</StxLink>
      </div>
    </div>
  </section>

  <div class="mx-auto px-4 py-8 sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <!-- Stats -->
        <div :if="tb.conquestStats" class="grid gap-4 grid-cols-2 sm:grid-cols-4 mb-8">
          <div class="text-center card">
            <p class="font-bold text-2xl text-orange-600" :text="tb.conquestStats.totalConquests"></p>
            <p class="metric-label">Conquered</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-red-600" :text="tb.conquestStats.territoriesLost"></p>
            <p class="metric-label">Lost</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-emerald-600" :text="tb.conquestStats.successfulDefenses"></p>
            <p class="metric-label">Defended</p>
          </div>
          <div class="text-center card">
            <p class="font-bold text-2xl text-blue-600" :text="tb.conquestStats.winRate + '%'"></p>
            <p class="metric-label">Win Rate</p>
          </div>
        </div>

        <h2 class="font-bold font-display text-2xl text-gray-900 dark:text-white mb-6">Battle Log</h2>

        <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
          <button @click="filter.set('all')" :class="filter === 'all' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">All</button>
          <button @click="filter.set('attacks')" :class="filter === 'attacks' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">My Attacks</button>
          <button @click="filter.set('defenses')" :class="filter === 'defenses' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Defenses</button>
          <button @click="filter.set('lost')" :class="filter === 'lost' ? 'bg-orange-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Lost</button>
        </div>

        <div class="space-y-4">
          <template :for="conquest in filtered">
            <div class="card">
              <div class="flex gap-4 items-start">
                <div class="flex items-center justify-center shrink-0 h-12 w-12 rounded-xl" :class="conquest.attacker_id === tb.currentUserId ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-red-100 dark:bg-red-900/20 text-red-600'">
                  <span class="font-bold" :text="conquest.attacker_id === tb.currentUserId ? '⚔' : '🛡'"></span>
                </div>
                <div class="flex-1 min-w-0">
                  <div class="flex gap-2 items-center mb-1">
                    <span class="px-2 py-0.5 font-semibold text-xs rounded-full" :class="conquest.attacker_id === tb.currentUserId ? 'bg-orange-100 text-orange-700' : conquest.status === 'defended' ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'" :text="conquest.attacker_id === tb.currentUserId ? 'ATTACK' : conquest.status === 'defended' ? 'DEFENDED' : 'CONQUERED'"></span>
                    <span class="text-xs text-gray-500 dark:text-slate-400" :text="tb.timeAgo(conquest.created_at)"></span>
                  </div>
                  <p class="font-semibold text-gray-900 dark:text-white">
                    <span :text="conquest.attacker_id === tb.currentUserId ? 'You conquered' : conquest.attackerName + ' attacked'"></span>
                    <StxLink :to="'/territory/' + conquest.territory_id" class="text-emerald-600 hover:underline" :text="' ' + conquest.territoryName"></StxLink>
                  </p>
                  <p class="text-sm text-gray-500 dark:text-slate-400 mt-1" :text="conquest.description"></p>
                </div>
              </div>
            </div>
          </template>

          <div :if="filtered.length === 0" class="py-20 text-center">
            <div class="w-20 h-20 mx-auto mb-6 bg-orange-100 dark:bg-orange-900/20 rounded-2xl flex items-center justify-center">
              <svg class="w-10 h-10 text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No conquests yet</h3>
            <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Find a territory on the map and run through it.</p>
            <StxLink to="/territories" class="px-6 py-2.5 bg-orange-600 text-white text-sm font-semibold rounded-lg hover:bg-orange-700 transition">Find Territories</StxLink>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <div class="card">
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Empire Status</h3>
          <div :if="tb.conquestStats" class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-orange-50 dark:bg-orange-900/10 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Power Rating</span>
              <span class="font-bold text-orange-600" :text="tb.conquestStats.powerRating"></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Longest Streak</span>
              <span class="font-bold dark:text-white" :text="tb.conquestStats.longestConquestStreak + ' wins'"></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-slate-700/50 rounded-xl">
              <span class="text-sm text-gray-600 dark:text-slate-400">Rivals Beaten</span>
              <span class="font-bold dark:text-white" :text="tb.conquestStats.uniqueRivalsBeaten"></span>
            </div>
          </div>
        </div>

        <div class="card">
          <h3 class="font-bold text-lg text-gray-900 dark:text-white mb-4 flex items-center">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse mr-2"></span>
            Under Attack
          </h3>
          <div class="space-y-3">
            <template :for="conquest in underAttack">
              <div class="flex items-center gap-3 p-3 bg-red-50 dark:bg-red-900/10 rounded-xl">
                <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center text-red-600 text-xs font-bold" :text="conquest.attackerName.charAt(0)"></div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-semibold text-gray-900 dark:text-white truncate" :text="conquest.attackerName"></p>
                  <p class="text-xs text-red-600" :text="'Targeting ' + conquest.territoryName"></p>
                </div>
                <StxLink :to="'/territory/' + conquest.territory_id" class="text-xs px-2 py-1 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">Defend</StxLink>
              </div>
            </template>
            <div :if="underAttack.length === 0" class="text-center py-6 text-gray-400 dark:text-slate-500 text-sm">
              <p>No active threats.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
@endsection
