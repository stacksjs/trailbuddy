@extends('layouts/default')

@section('title', 'Sign Up - WildLoop')

@section('content')
<script client>
  import { isSignedIn, redirectAfterAuth, signUp } from '../assets/scripts/auth'

  useHead({ title: 'Sign Up - WildLoop' })

  const name = state('')
  const email = state('')
  const password = state('')
  const passwordConfirm = state('')
  const showPassword = state(false)
  const terms = state(false)
  const loading = state(false)
  const error = state('')
  const success = state('')

  const passwordStrength = () => {
    const pw = password()
    if (!pw) return { level: '', text: '', width: '0%' }
    let strength = 0
    if (pw.length >= 6) strength++
    if (pw.length >= 10) strength++
    if (/[A-Z]/.test(pw)) strength++
    if (/[0-9]/.test(pw)) strength++
    if (/[^A-Za-z0-9]/.test(pw)) strength++

    if (strength <= 2) return { level: 'bg-red-500', text: 'Weak password', color: 'text-red-500', width: '33%' }
    if (strength <= 3) return { level: 'bg-yellow-500', text: 'Medium password', color: 'text-yellow-600', width: '66%' }
    return { level: 'bg-emerald-500', text: 'Strong password', color: 'text-emerald-600', width: '100%' }
  }

  const passwordsMatch = () => {
    const confirm = passwordConfirm()
    if (!confirm) return true
    return password() === confirm
  }

  onMount(() => {
    // Already signed in: nothing to do on a sign-up page.
    if (isSignedIn()) navigate('/')
  })

  async function handleRegister(e) {
    e.preventDefault()
    error.set('')
    success.set('')

    // Read the fields themselves, not the signal mirror. A password manager
    // or browser autofill sets `value` without firing an input event, so the
    // signals stay empty while the boxes visibly hold details.
    const fields = e.target?.elements
    const nameValue = (fields?.name?.value ?? name()).trim()
    const emailValue = (fields?.email?.value ?? email()).trim()
    const passwordValue = fields?.password?.value ?? password()
    const confirmValue = fields?.password_confirmation?.value ?? passwordConfirm()

    if (!nameValue || !emailValue || !passwordValue) {
      error.set('Fill in your name, email and a password.')
      return
    }
    if (confirmValue && passwordValue !== confirmValue) {
      error.set('Those passwords do not match.')
      return
    }
    // The checkbox is `required`, so the browser blocks submit on its own.
    // Checked here too, from the field rather than the signal, so the reason
    // is stated rather than left to a native tooltip.
    if (fields?.terms && !fields.terms.checked) {
      error.set('Accept the terms to create your account.')
      return
    }

    loading.set(true)

    // signUp never throws: every outcome comes back as a result, already
    // phrased for a person.
    const result = await signUp({ name: nameValue, email: emailValue, password: passwordValue })

    if (result.ok) {
      success.set('Account created. Taking you to your feed.')
      redirectAfterAuth('/')
      return
    }

    error.set(result.failure.message)
    loading.set(false)
  }
</script>

  <div class="flex items-center justify-center px-4 py-12 min-h-screen bg-gray-50 dark:bg-slate-900">
    <div class="max-w-md w-full">
      <!-- Register Form Card -->
      <div class="p-8 bg-white dark:bg-slate-800 border border-gray-100 rounded-2xl dark:border-slate-700 shadow-xl">
        <div class="mb-8 text-center">
          <StxLink to="/" class="inline-flex items-center mb-6 font-bold text-emerald-600 text-xl">
            <span class="mr-2 h-7 w-7 inline-block rounded-full border-[3px] border-emerald-500 border-t-transparent align-middle" aria-hidden="true"></span> WildLoop
          </StxLink>
          <h1 class="mb-2 font-bold text-3xl text-gray-900 dark:text-white">Join WildLoop</h1>
          <p class="text-gray-500 dark:text-slate-400">Start your trail adventure today</p>
        </div>

        <!-- Error Alert -->
        <div :if="error" role="alert" aria-live="assertive" class="flex gap-3 items-start mb-6 p-4 text-red-700 text-sm dark:text-red-300 bg-red-50 dark:bg-red-950/40 border border-red-200 rounded-xl dark:border-red-900"><i class="i-hugeicons-alert-circle h-5 w-5 shrink-0 mt-px" aria-hidden="true"></i><span>{{ error }}</span></div>

        <!-- Success Alert -->
        <div :if="success" role="status" aria-live="polite" class="flex gap-3 items-start mb-6 p-4 text-emerald-700 text-sm dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 rounded-xl dark:border-emerald-900"><i class="i-hugeicons-checkmark-circle-02 h-5 w-5 shrink-0 mt-px" aria-hidden="true"></i><span>{{ success }}</span></div>

        <!-- Register Form -->
        <form @submit="handleRegister" class="space-y-5">
          <div>
            <label for="name" class="block mb-2 font-medium text-gray-700 text-sm dark:text-slate-300">Full Name</label>
            <input
              type="text"
              id="name"
              x-value="name"
              @input="e => name.set(e.target.value)"
              required
              minlength="5"
              class="px-4 py-3 w-full text-gray-900 dark:text-white bg-white dark:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 transition"
              placeholder="John Doe"
            />
          </div>

          <div>
            <label for="email" class="block mb-2 font-medium text-gray-700 text-sm dark:text-slate-300">Email</label>
            <input
              type="email"
              id="email"
              x-value="email"
              @input="e => email.set(e.target.value)"
              required
              class="px-4 py-3 w-full text-gray-900 dark:text-white bg-white dark:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 transition"
              placeholder="you@example.com"
            />
          </div>

          <div>
            <label for="password" class="block mb-2 font-medium text-gray-700 text-sm dark:text-slate-300">Password</label>
            <div class="relative">
              <input
                :type="showPassword() ? 'text' : 'password'"
                id="password"
                x-value="password"
                @input="e => password.set(e.target.value)"
                required
                minlength="6"
                class="pr-12 px-4 py-3 w-full text-gray-900 dark:text-white bg-white dark:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 transition"
                placeholder="Minimum 6 characters"
              />
              <button type="button" @click="showPassword.set(!showPassword())" class="absolute right-3 top-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-slate-300 -translate-y-1/2">
                <Icon :if="!showPassword" name="eye" size="20" />
                <Icon :if="showPassword" name="eye-off" size="20" />
              </button>
            </div>
            <!-- Password strength indicator -->
            <div :if="password" class="mt-2">
              <div class="overflow-hidden h-1 bg-gray-200 dark:bg-slate-600 rounded-full">
                <div x-class="passwordStrength().level" class="h-full rounded-full transition-all" x-style="'width: ' + passwordStrength().width"></div>
              </div>
              <p x-class="passwordStrength().color" class="mt-1 text-xs">{{ passwordStrength().text }}</p>
            </div>
          </div>

          <div>
            <label for="password_confirmation" class="block mb-2 font-medium text-gray-700 text-sm dark:text-slate-300">Confirm Password</label>
            <input
              type="password"
              id="password_confirmation"
              x-value="passwordConfirm"
              @input="e => passwordConfirm.set(e.target.value)"
              required
              class="px-4 py-3 w-full text-gray-900 dark:text-white bg-white dark:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500 transition"
              placeholder="Confirm your password"
            />
            <p :if="!passwordsMatch" class="mt-1 text-red-500 text-xs">Passwords do not match</p>
          </div>

          <div class="flex items-start">
            <input type="checkbox" id="terms" required @change="e => terms.set(e.target.checked)" class="mt-1 h-4 w-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500" />
            <label for="terms" class="ml-2 text-gray-600 text-sm dark:text-slate-400">
              I agree to the <StxLink to="/terms" class="text-emerald-600 hover:text-emerald-700">Terms of Service</StxLink> and <StxLink to="/privacy" class="text-emerald-600 hover:text-emerald-700">Privacy Policy</StxLink>
            </label>
          </div>

          <button
            type="submit"
            x-disabled="loading()"
            class="px-4 py-3 w-full font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2 disabled:opacity-50 transition"
          >
            <span :if="!loading">Create Account</span>
            <span :if="loading" class="inline-flex items-center">
              <svg class="-ml-1 mr-2 h-4 w-4 text-white animate-spin" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Creating account...
            </span>
          </button>
        </form>

        <!-- Divider -->
        <div class="relative my-8">
          <div class="flex absolute inset-0 items-center">
            <div class="w-full border-gray-200 border-t dark:border-slate-600"></div>
          </div>
          <div class="flex relative justify-center text-sm">
            <span class="px-4 text-gray-500 dark:text-slate-400 bg-white dark:bg-slate-800">Or sign up with</span>
          </div>
        </div>

        <!-- Social Login -->
        <div class="grid gap-4 grid-cols-2">
          <button class="flex items-center justify-center px-4 py-3 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 transition">
            <svg class="mr-2 h-5 w-5" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Google
          </button>
          <button class="flex items-center justify-center px-4 py-3 text-gray-700 dark:text-slate-300 hover:bg-gray-50 dark:hover:bg-slate-700 border border-gray-200 rounded-xl dark:border-slate-600 transition">
            <svg class="mr-2 h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </button>
        </div>

        <!-- Login Link -->
        <p class="mt-8 text-center text-gray-500 text-sm dark:text-slate-400">
          Already have an account?
          <StxLink to="/login" class="font-semibold text-emerald-600 hover:text-emerald-700">Sign in</StxLink>
        </p>
      </div>
    </div>
  </div>
@endsection
