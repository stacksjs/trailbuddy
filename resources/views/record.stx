@extends('layouts/default')

@section('title', 'Capture Run - WildLoop')

@section('content')
<script client>
  import { useRecorder } from '../composables/useRecorder'
  import { useActivityImport } from '../composables/useActivityImport'

  useHead({ title: 'Capture Run - WildLoop' })

  const wl = useStore('wl')
  const { importing, importMessage, importError, importFile } = useActivityImport(wl)
  const {
    recording,
    paused,
    activityType,
    visibility,
    mode,
    runMode,
    elapsed,
    distance,
    elevation,
    gpsStatus,
    selectedTrailId,
    targetTerritoryId,
    conqueredIds,
    captureProgress,
    sessionXp,
    conquestToast,
    saveStatus,
    saveMessage,
    wrongTurn,
    trailOptions,
    simulate,
    startManual,
    togglePause,
    stop,
    fmtDuration,
    mountRecordMap,
  } = useRecorder({ mapElId: 'record-map', wl })

  onMount(() => mountRecordMap())

  const attackable = derived(() => wl ? wl.attackableTerritories() : [])
  const targetZone = derived(() => {
    const id = targetTerritoryId()
    return id && wl ? wl.findTerritory(id) : null
  })

  const activeCaptures = derived(() => {
    const prog = captureProgress()
    return Object.entries(prog)
      .filter(([, pct]) => pct > 0 && pct < 100)
      .map(([id, pct]) => ({ id: Number(id), pct, name: wl?.findTerritory(Number(id))?.name ?? 'Zone' }))
  })
</script>

  <div class="mx-auto px-4 py-6 max-w-4xl">
    <div class="flex flex-col gap-2 items-center mb-4 sm:flex-row sm:justify-between">
      <div class="text-center sm:text-left">
        <h1 class="font-bold text-2xl dark:text-white">Capture Run</h1>
        <p class="text-gray-500 text-sm dark:text-slate-400">Live pace, distance and elevation. Close a loop and the ground inside it is yours.</p>
      </div>
      <div class="flex items-center gap-2">
        <StxLink :if="!recording" to="/routes" class="px-3 py-2 text-xs font-semibold text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800 rounded-lg">Plan route</StxLink>
        <select x-value="visibility" @change="visibility.set($event.target.value)" x-class="recording ? 'hidden' : ''" class="px-3 py-2 text-xs font-medium bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400 rounded-lg border-0" aria-label="Activity visibility">
          <option value="public">🌐 Public</option>
          <option value="followers">👥 Followers</option>
          <option value="private">🔒 Private</option>
        </select>
        <div class="flex gap-2 p-1 bg-gray-100 dark:bg-slate-800 rounded-lg">
          <button @click="runMode.set('capture')" x-class="runMode === 'capture' ? 'bg-emerald-600 text-white shadow' : 'text-gray-600 dark:text-slate-400'" class="px-4 py-2 font-semibold text-xs rounded-md transition">Capture</button>
          <button @click="runMode.set('free')" x-class="runMode === 'free' ? 'bg-emerald-600 text-white shadow' : 'text-gray-600 dark:text-slate-400'" class="px-4 py-2 font-semibold text-xs rounded-md transition">Free Run</button>
        </div>
      </div>
    </div>

    <!-- Target zone (capture mode) -->
    <div x-class="runMode === 'capture' && !recording ? 'mb-4 card border-2 border-orange-200 dark:border-orange-800/50' : 'hidden'">
      <p class="mb-2 font-semibold text-sm dark:text-white">Target a zone to attack</p>
      <div class="flex flex-wrap gap-2 items-center">
        <button @click="targetTerritoryId.set(null)" x-class="!targetTerritoryId ? 'ring-2 ring-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'bg-gray-100 dark:bg-slate-700'" class="px-3 py-1.5 text-xs font-medium rounded-lg transition">Any nearby</button>
        <template :for="zone in attackable">
          <button @click="targetTerritoryId.set(zone.id)" x-class="targetTerritoryId === zone.id ? 'ring-2 ring-orange-500 bg-orange-50 dark:bg-orange-900/20' : 'bg-gray-100 dark:bg-slate-700'" class="px-3 py-1.5 text-xs font-medium rounded-lg transition">{{ zone.name }}</button>
        </template>
        <span :if="attackable.length === 0" class="text-xs text-gray-500 dark:text-slate-400">No claimable zones in range yet. Head toward the orange areas on the map.</span>
      </div>
      <p :if="targetZone" class="mt-2 text-orange-600 text-xs">Focus run: cross <span class="font-semibold">{{ targetZone.name }}</span> to fill the capture meter</p>
    </div>

    <!-- Map -->
    <div class="relative mb-4 rounded-2xl overflow-hidden shadow-md ring-1 ring-slate-200 dark:ring-slate-700">
      <div id="record-map" class="ts-map-container h-[22rem] sm:h-[28rem] w-full"></div>

      <div class="flex absolute right-3 top-3 z-[1000] gap-1.5 items-center px-2.5 py-1 font-medium text-xs rounded-full bg-white/90 backdrop-blur-sm shadow-sm" x-class="gpsStatus === 'active' ? 'text-emerald-700' : gpsStatus === 'searching' ? 'text-yellow-700' : 'text-gray-600'">
        <div class="h-2 w-2 rounded-full" x-class="gpsStatus === 'active' ? 'bg-emerald-500 animate-pulse' : gpsStatus === 'searching' ? 'bg-yellow-500 animate-pulse' : 'bg-gray-400'"></div>
        <span>{{ gpsStatus === 'active' ? (mode === 'simulated' ? 'Simulating' : 'GPS Active') : gpsStatus === 'searching' ? 'Searching...' : 'GPS Off' }}</span>
      </div>

      <div class="absolute bottom-3 left-3 z-[1000] px-3 py-2 bg-white/90 backdrop-blur-sm rounded-lg shadow-sm">
        <div class="flex flex-wrap gap-3 items-center text-xs">
          <span class="flex gap-1 items-center"><span class="h-3 w-3 bg-emerald-500 rounded"></span>Yours</span>
          <span class="flex gap-1 items-center"><span class="h-3 w-3 bg-amber-500 rounded"></span>Enemy</span>
          <span class="flex gap-1 items-center"><span class="h-3 w-3 bg-purple-500 rounded"></span>Capturing</span>
          <span class="flex gap-1 items-center"><span class="h-2 w-2 bg-sky-500 rounded-full"></span>Route</span>
        </div>
      </div>

      <div :if="conquestToast" class="capture-toast absolute top-3 left-1/2 -translate-x-1/2 z-[1000] px-5 py-2.5 font-bold text-white bg-emerald-600 rounded-full shadow-xl">{{ conquestToast }}</div>
    </div>

    <!-- Live capture meters -->
    <div :if="recording && activeCaptures.length > 0" class="mb-4 space-y-2">
      <template :for="cap in activeCaptures">
        <div class="card py-3">
          <div class="flex justify-between mb-1 text-xs">
            <span class="font-semibold dark:text-white">{{ 'Capturing ' + cap.name }}</span>
            <span class="text-purple-600 font-bold">{{ cap.pct + '%' }}</span>
          </div>
          <div class="capture-bar"><div class="capture-bar-fill" :style="'width:' + cap.pct + '%'"></div></div>
        </div>
      </template>
    </div>

    <!-- Live activity stats -->
    <div class="mb-6 card">
      <div class="mb-4 text-center">
        <p class="font-bold font-mono text-5xl sm:text-6xl tracking-tight dark:text-white">{{ fmtDuration(elapsed) }}</p>
        <p class="mt-1 metric-label">Elapsed</p>
      </div>
      <div class="grid gap-4 grid-cols-2 sm:grid-cols-5">
        <div class="stat-tile">
          <p class="font-bold text-2xl dark:text-white">{{ distance.toFixed(2) }}</p>
          <p class="metric-label">Miles</p>
        </div>
        <div class="stat-tile">
          <p class="font-bold text-2xl dark:text-white">{{ distance > 0.01 ? fmtDuration(Math.round(elapsed / distance)) : '--:--' }}</p>
          <p class="metric-label">Pace</p>
        </div>
        <div class="stat-tile">
          <p class="font-bold text-2xl dark:text-white">{{ elevation.toLocaleString() }}</p>
          <p class="metric-label">Elev ft</p>
        </div>
        <div class="stat-tile">
          <p class="font-bold text-2xl text-emerald-600">{{ conqueredIds.length }}</p>
          <p class="metric-label">Captured</p>
        </div>
        <div class="stat-tile">
          <p class="font-bold text-2xl text-purple-600">{{ sessionXp }}</p>
          <p class="metric-label">XP</p>
        </div>
      </div>
    </div>

    <div :if="saveMessage" class="mb-4 px-4 py-3 text-sm rounded-xl" x-class="saveStatus === 'saved' ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-900/20' : saveStatus === 'queued' ? 'bg-amber-50 text-amber-700 dark:bg-amber-900/20' : saveStatus === 'error' ? 'bg-red-50 text-red-700 dark:bg-red-900/20' : 'bg-sky-50 text-sky-700 dark:bg-sky-900/20'">
      <span class="font-semibold">{{ saveMessage }}</span>
    </div>
    <div :if="wrongTurn && recording" role="alert" class="mb-4 px-4 py-3 font-semibold text-sm text-amber-800 bg-amber-100 dark:bg-amber-900/30 dark:text-amber-200 rounded-xl">
      Wrong-turn alert: you are more than about 425 ft from the selected trail route.
    </div>

    <!-- Simulate -->
    <div x-class="recording ? 'hidden' : 'mb-6 card'">
      <div class="flex items-center justify-between mb-3">
        <h3 class="font-semibold text-sm dark:text-white">Quick simulate</h3>
        <span class="text-xs text-gray-500">Preview a trail route • saved as simulation • never scores</span>
      </div>
      <div class="flex gap-2">
        <select @change="selectedTrailId.set(Number($event.target.value))" x-disabled="trailOptions.length === 0" class="flex-1 px-3 py-2 text-sm bg-white dark:bg-slate-800 border border-gray-200 dark:border-slate-700 rounded-lg disabled:opacity-50">
          <option :if="trailOptions.length === 0" disabled>No trails available yet</option>
          <template :for="opt in trailOptions">
            <option x-value="opt.id" x-selected="opt.id === selectedTrailId" :text="opt.name"></option>
          </template>
        </select>
        <button @click="simulate()" x-disabled="trailOptions.length === 0" class="px-4 py-2 font-semibold text-sm text-white bg-sky-600 hover:bg-sky-700 rounded-lg transition whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed">Preview route</button>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex gap-4 items-center justify-center">
      <button @click="startManual()" x-class="recording ? 'hidden' : 'record-btn-start'">▶</button>
      <button @click="togglePause()" x-class="!recording ? 'hidden' : paused ? 'record-btn-resume' : 'record-btn-pause'">{{ paused ? '▶' : '⏸' }}</button>
      <button @click="stop()" x-class="recording ? 'record-btn-stop' : 'hidden'">⏹</button>
    </div>

    <div x-class="recording ? 'hidden' : 'mt-8 card'">
      <h2 class="font-semibold text-sm dark:text-white">Import an activity</h2>
      <p class="mt-1 text-xs text-gray-500 dark:text-slate-400">GPX, TCX, and checksum-validated FIT files import privately. Imported tracks cannot capture territory.</p>
      <label class="inline-flex mt-3 px-4 py-2 font-semibold text-sm text-white bg-slate-700 hover:bg-slate-800 rounded-lg cursor-pointer">
        {{ importing ? 'Importing…' : 'Choose file' }}
        <input type="file" accept=".gpx,.tcx,.fit,application/gpx+xml,application/vnd.garmin.tcx+xml" @change="importFile($event)" class="sr-only" />
      </label>
      <p :if="importMessage" class="mt-2 text-sm text-emerald-600">{{ importMessage }}</p>
      <p :if="importError" class="mt-2 text-sm text-red-500">{{ importError }}</p>
    </div>

    <p class="mt-4 text-center text-gray-500 text-sm dark:text-slate-400">
      <span :if="!recording">Hit ▶ to start GPS capture, or simulate a trail route</span>
      <span :if="recording">{{ runMode === 'capture' ? 'Stay inside the highlighted zone. The capture bar fills as you run' : 'Free run, no territory capture' }}</span>
    </p>
  </div>
@endsection
