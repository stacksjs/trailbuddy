@extends('layouts/default')

@section('title', 'Record Activity — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Record Activity — TrailBuddy' })

  const tb = useStore('tb')
  const recording = state(false)
  const paused = state(false)
  const activityType = state<'Trail Run' | 'Hike' | 'Walk' | 'Bike'>('Trail Run')
  const elapsed = state(0)
  const distance = state(0)
  const elevation = state(0)
  const gpsStatus = state<'searching' | 'active' | 'stopped'>('searching')

  const rec = {
    fmt(secs: number): string {
      const h = Math.floor(secs / 3600)
      const m = Math.floor((secs % 3600) / 60)
      const s = secs % 60
      if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
      return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`
    },
    start() {
      recording.set(true)
      paused.set(false)
      gpsStatus.set('active')
      ;(window as any)._tbRecord = (window as any)._tbRecord || {}
      ;(window as any)._tbRecord.timer = setInterval(() => {
        if (!paused()) elapsed.set(elapsed() + 1)
      }, 1000)
    },
    pause() {
      paused.set(!paused())
    },
    stop() {
      recording.set(false)
      paused.set(false)
      gpsStatus.set('stopped')
      const w = (window as any)._tbRecord
      if (w?.timer) clearInterval(w.timer)
      if (!tb) return
      tb.addActivity({
        user_id: tb.currentUserId(),
        userName: 'You',
        trail_id: null,
        trail_name: `${activityType()} Activity`,
        title: `${activityType()} — ${new Date().toLocaleDateString()}`,
        activityType: activityType(),
        distance: distance(),
        duration: this.fmt(elapsed()),
        moving_time: this.fmt(elapsed()),
        pace: distance() > 0 ? `${this.fmt(Math.round(elapsed() / distance()))}/mi` : '--',
        elevation_gain: elevation(),
        calories: Math.round(elapsed() / 60 * 10),
        heartRateAvg: null,
        heartRateMax: null,
        cadence: null,
        splits: [],
        kudos_count: 0,
        comments: [],
      })
    },
  }

  onMount(() => {
    try {
      if (typeof L === 'undefined' || !tb) return
      const el = document.getElementById('record-map')
      if (!el) return
      const map = L.map('record-map', { scrollWheelZoom: false })
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 18 }).addTo(map)
      map.setView([37.7749, -122.4194], 15)
      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            map.setView([pos.coords.latitude, pos.coords.longitude], 15)
            L.marker([pos.coords.latitude, pos.coords.longitude]).addTo(map).bindPopup('You are here').openPopup()
            gpsStatus.set('active')
          },
          () => gpsStatus.set('searching'),
          { enableHighAccuracy: true }
        )
      }
    } catch (err) {
      console.error('record map init failed:', err)
    }
  })
</script>

  <div class="mx-auto px-4 py-6 max-w-lg">
    <!-- Activity type selector -->
    <div x-class="recording ? 'hidden' : 'mb-8'">
      <h1 class="mb-6 font-bold text-2xl text-center dark:text-white">Record Activity</h1>
      <div class="grid gap-3 grid-cols-2">
        <button @click="activityType.set('Trail Run')" x-class="activityType === 'Trail Run' ? 'ring-2 ring-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'bg-white dark:bg-slate-800'" class="flex flex-col gap-2 items-center py-6 transition card">
          <span class="text-2xl">🏃</span>
          <span class="font-medium text-sm dark:text-white">Trail Run</span>
        </button>
        <button @click="activityType.set('Hike')" x-class="activityType === 'Hike' ? 'ring-2 ring-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'bg-white dark:bg-slate-800'" class="flex flex-col gap-2 items-center py-6 transition card">
          <span class="text-2xl">🥾</span>
          <span class="font-medium text-sm dark:text-white">Hike</span>
        </button>
        <button @click="activityType.set('Walk')" x-class="activityType === 'Walk' ? 'ring-2 ring-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'bg-white dark:bg-slate-800'" class="flex flex-col gap-2 items-center py-6 transition card">
          <span class="text-2xl">🚶</span>
          <span class="font-medium text-sm dark:text-white">Walk</span>
        </button>
        <button @click="activityType.set('Bike')" x-class="activityType === 'Bike' ? 'ring-2 ring-emerald-500 bg-emerald-50 dark:bg-emerald-900/20' : 'bg-white dark:bg-slate-800'" class="flex flex-col gap-2 items-center py-6 transition card">
          <span class="text-2xl">🚴</span>
          <span class="font-medium text-sm dark:text-white">Bike</span>
        </button>
      </div>
    </div>

    <!-- GPS Map -->
    <div class="relative mb-6 rounded-2xl overflow-hidden">
      <div id="record-map" class="h-64 rounded-2xl"></div>
      <div class="flex absolute right-3 top-3 z-[1000] gap-1.5 items-center px-2.5 py-1 font-medium text-xs rounded-full bg-white/90 backdrop-blur-sm shadow-sm" x-class="gpsStatus === 'active' ? 'text-emerald-700' : gpsStatus === 'searching' ? 'text-yellow-700' : 'text-gray-600'">
        <div class="h-2 w-2 rounded-full" x-class="gpsStatus === 'active' ? 'bg-emerald-500 animate-pulse' : gpsStatus === 'searching' ? 'bg-yellow-500 animate-pulse' : 'bg-gray-400'"></div>
        <span :text="gpsStatus === 'active' ? 'GPS Active' : gpsStatus === 'searching' ? 'Searching...' : 'GPS Off'"></span>
      </div>
    </div>

    <!-- Stats -->
    <div class="mb-6 card">
      <div class="mb-4 text-center">
        <p class="font-bold font-mono text-5xl tracking-tight dark:text-white" :text="rec.fmt(elapsed)"></p>
        <p class="mt-1 metric-label">Duration</p>
      </div>
      <div class="grid gap-4 grid-cols-3">
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white" :text="distance.toFixed(2)"></p>
          <p class="metric-label">Miles</p>
        </div>
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white">--:--</p>
          <p class="metric-label">Pace</p>
        </div>
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white" :text="elevation.toLocaleString()"></p>
          <p class="metric-label">Elev (ft)</p>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex gap-4 items-center justify-center">
      <button @click="rec.start()" x-class="recording ? 'hidden' : 'flex items-center justify-center h-20 w-20 text-white bg-emerald-600 hover:bg-emerald-700 rounded-full shadow-lg transition text-2xl'">▶</button>
      <button @click="rec.pause()" x-class="!recording ? 'hidden' : paused ? 'flex items-center justify-center h-20 w-20 bg-yellow-500 text-white hover:bg-yellow-600 rounded-full shadow-lg transition text-2xl' : 'flex items-center justify-center h-20 w-20 bg-emerald-600 text-white hover:bg-emerald-700 rounded-full shadow-lg transition text-2xl'" :text="paused ? '▶' : '⏸'"></button>
      <button @click="rec.stop()" x-class="recording ? 'flex items-center justify-center h-16 w-16 text-white bg-red-500 hover:bg-red-600 rounded-full shadow-lg transition text-xl' : 'hidden'">⏹</button>
    </div>

    <p class="mt-4 text-center text-gray-500 text-sm dark:text-slate-400" :text="activityType"></p>
  </div>
@endsection
