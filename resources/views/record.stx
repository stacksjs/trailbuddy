@extends('layouts/default')

@section('title', 'Record Activity — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Record Activity — TrailBuddy' })

  const recording = state(false)
  const paused = state(false)
  const activityType = state('Trail Run')
  const elapsed = state(0)
  const distance = state(0)
  const elevation = state(0)
  const pace = state('--:--')
  const gpsStatus = state('searching')
  let timer = null

  const formatTime = (secs) => {
    const h = Math.floor(secs / 3600)
    const m = Math.floor((secs % 3600) / 60)
    const s = secs % 60
    if (h > 0) return h + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
    return String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0')
  }

  function startRecording() {
    recording.set(true)
    paused.set(false)
    gpsStatus.set('active')
    timer = setInterval(() => {
      if (!paused()) elapsed.set(elapsed() + 1)
    }, 1000)
  }

  function pauseRecording() {
    paused.set(!paused())
  }

  function stopRecording() {
    recording.set(false)
    paused.set(false)
    gpsStatus.set('stopped')
    if (timer) clearInterval(timer)

    // Save activity to localStorage
    const activities = window.tb.getList('activities')
    const newId = Math.max(...activities.map(a => a.id), 0) + 1
    const newActivity = {
      id: newId,
      user_id: 1,
      userName: 'You',
      trail_id: null,
      trail_name: activityType() + ' Activity',
      title: activityType() + ' — ' + new Date().toLocaleDateString(),
      activityType: activityType(),
      distance: distance(),
      duration: formatTime(elapsed()),
      moving_time: formatTime(elapsed()),
      pace: distance() > 0 ? formatTime(Math.round(elapsed() / distance())) + '/mi' : '--',
      elevation_gain: elevation(),
      calories: Math.round(elapsed() / 60 * 10),
      heartRateAvg: null,
      heartRateMax: null,
      cadence: null,
      splits: [],
      kudos_count: 0,
      comments: [],
      created_at: new Date().toISOString(),
    }
    activities.unshift(newActivity)
    window.tb.set('activities', activities)
  }
</script>

  <div class="mx-auto px-4 py-6 max-w-lg">
    <!-- Activity type selector -->
    <div @show="!recording()" class="mb-8">
      <h1 class="mb-6 font-bold text-2xl text-center dark:text-white">Record Activity</h1>
      <div class="grid gap-3 grid-cols-2">
        <button @click="activityType.set('Trail Run')" :class="bg-emerald-50 dark:bg-emerald-900/20' dark:bg-slate-800' ring-emerald-500 : ? 'bg-white 'ring-2 'Trail === activityType() Run'" class="flex flex-col gap-2 items-center py-6 transition card">
          <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span class="font-medium text-sm dark:text-white">Trail Run</span>
        </button>
        <button @click="activityType.set('Hike')" :class="bg-emerald-50 dark:bg-emerald-900/20' dark:bg-slate-800' ring-emerald-500 : ? 'bg-white 'Hike' 'ring-2 === activityType()" class="flex flex-col gap-2 items-center py-6 transition card">
          <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
          <span class="font-medium text-sm dark:text-white">Hike</span>
        </button>
        <button @click="activityType.set('Walk')" :class="bg-emerald-50 dark:bg-emerald-900/20' dark:bg-slate-800' ring-emerald-500 : ? 'bg-white 'ring-2 'Walk' === activityType()" class="flex flex-col gap-2 items-center py-6 transition card">
          <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
          <span class="font-medium text-sm dark:text-white">Walk</span>
        </button>
        <button @click="activityType.set('Bike')" :class="bg-emerald-50 dark:bg-emerald-900/20' dark:bg-slate-800' ring-emerald-500 : ? 'bg-white 'Bike' 'ring-2 === activityType()" class="flex flex-col gap-2 items-center py-6 transition card">
          <svg class="h-8 w-8 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-medium text-sm dark:text-white">Bike</span>
        </button>
      </div>
    </div>

    <!-- Map area -->
    <div class="flex overflow-hidden relative items-center justify-center mb-6 h-64 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-slate-700 dark:to-slate-800 rounded-2xl">
      <div class="text-center text-gray-400 dark:text-slate-500">
        <svg class="mb-2 mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <p class="font-medium text-sm">GPS Map</p>
        <p class="mt-1 text-xs">Your route will appear here</p>
      </div>
      <!-- GPS status -->
      <div class="flex absolute right-3 top-3 gap-1.5 items-center px-2.5 py-1 font-medium text-xs rounded-full" :class="text-emerald-700' text-gray-600' text-yellow-700' : : ? ? 'active' 'bg-emerald-100 'bg-gray-100 'bg-yellow-100 'searching' === === gpsStatus() gpsStatus()">
        <div class="h-2 w-2 rounded-full" :class="animate-pulse' animate-pulse' : : ? ? 'active' 'bg-emerald-500 'bg-gray-400' 'bg-yellow-500 'searching' === === gpsStatus() gpsStatus()"></div>
        <span :text="gpsStatus() === 'active' ? 'GPS Active' : gpsStatus() === 'searching' ? 'Searching...' : 'GPS Off'"></span>
      </div>
    </div>

    <!-- Stats display -->
    <div class="mb-6 card">
      <div class="mb-4 text-center">
        <p class="font-bold font-mono text-5xl tracking-tight dark:text-white" :text="formatTime(elapsed())"></p>
        <p class="mt-1 metric-label">Duration</p>
      </div>
      <div class="grid gap-4 grid-cols-3">
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white" :text="distance().toFixed(2)"></p>
          <p class="metric-label">Miles</p>
        </div>
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white" :text="pace()"></p>
          <p class="metric-label">Pace</p>
        </div>
        <div class="text-center">
          <p class="font-bold text-2xl dark:text-white" :text="elevation().toLocaleString()"></p>
          <p class="metric-label">Elev (ft)</p>
        </div>
      </div>
    </div>

    <!-- Controls -->
    <div class="flex gap-4 items-center justify-center">
      <button @show="!recording()" @click="startRecording()" class="flex items-center justify-center h-20 w-20 text-white bg-emerald-600 hover:bg-emerald-700 rounded-full shadow-lg transition">
        <svg class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>

      <button @show="recording()" @click="pauseRecording()" class="flex items-center justify-center h-20 w-20 rounded-full shadow-lg transition" :class="text-white' text-white' hover:bg-emerald-700 hover:bg-yellow-600 : ? 'bg-emerald-600 'bg-yellow-500 paused()">
        <svg @show="!paused()" class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z" />
        </svg>
        <svg @show="paused()" class="h-8 w-8" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>

      <button @show="recording()" @click="stopRecording()" class="flex items-center justify-center h-16 w-16 text-white bg-red-500 hover:bg-red-600 rounded-full shadow-lg transition">
        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6 6h12v12H6z" />
        </svg>
      </button>
    </div>

    <!-- Activity type label -->
    <p class="mt-4 text-center text-gray-500 text-sm dark:text-slate-400" :text="activityType()"></p>
  </div>
@endsection
