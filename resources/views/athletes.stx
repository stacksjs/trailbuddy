@extends('layouts/default')

@section('title', 'Find Athletes — TrailBuddy')

@section('content')
<script client>
  import { searchAthletes, toggleFollow } from '../assets/scripts/game-api'

  useHead({ title: 'Find Athletes — TrailBuddy' })

  const tb = useStore('tb')
  const query = state('')
  const athletes = state<any[]>([])
  const searching = state(false)
  const searched = state(false)
  const error = state('')

  let debounceTimer: ReturnType<typeof setTimeout> | null = null

  async function runSearch(q: string) {
    searching.set(true)
    error.set('')
    const results = await searchAthletes(q)
    searching.set(false)
    searched.set(true)
    // null = request failed (vs [] = genuinely no matches) — keep the two
    // distinct so a network error doesn't read as "no athletes found".
    if (results === null) {
      error.set('Could not load athletes. Check your connection and try again.')
      athletes.set([])
    }
    else {
      athletes.set(results)
    }
  }

  function retrySearch() {
    void runSearch(query().trim())
  }

  function onQueryInput(value: string) {
    query.set(value)
    if (debounceTimer) clearTimeout(debounceTimer)
    debounceTimer = setTimeout(() => { void runSearch(query().trim()) }, 250)
  }

  // Load the discover list (most active athletes) on first visit.
  onMount(() => { void runSearch('') })

  async function onFollow(userId: number) {
    if (!tb || userId === tb.currentUserId()) return
    const wasFollowing = tb.isFollowing(userId)
    tb.setFollowing(userId, !wasFollowing) // optimistic
    const res = await toggleFollow(userId)
    if (res && res.success) tb.setFollowing(userId, !!res.following)
    else tb.setFollowing(userId, wasFollowing) // rollback
  }

  function areaKm2(m2: number): string {
    return (m2 / 1000000).toFixed(2)
  }
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-3xl">
    <div class="mb-6">
      <h1 class="font-bold text-2xl dark:text-white">Find Athletes</h1>
      <p class="text-sm text-gray-500 dark:text-slate-400">Search by name, or browse the most active runners</p>
    </div>

    <div class="relative mb-6">
      <Icon name="search" size="18" class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
      <input
        type="text"
        placeholder="Search athletes…"
        x-value="query"
        @input="onQueryInput($event.target.value)"
        class="w-full pl-10 pr-4 py-3 border border-gray-200 dark:border-slate-600 rounded-xl bg-white dark:bg-slate-800 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
      />
    </div>

    <!-- Loading -->
    <div :if="searching" class="py-16 text-center text-sm text-gray-500 dark:text-slate-400">
      <svg class="mx-auto mb-3 h-6 w-6 text-emerald-500 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      Searching athletes…
    </div>

    <!-- Error (distinct from empty) -->
    <div :if="error && !searching" class="py-16 text-center">
      <div class="w-16 h-16 mx-auto mb-4 bg-red-100 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
        <Icon name="alert-triangle" size="28" class="text-red-400" />
      </div>
      <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">Couldn't load athletes</h3>
      <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">{{ error }}</p>
      <button @click="retrySearch()" class="px-5 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Try again</button>
    </div>

    <div :if="!searching && !error" class="space-y-3">
      <template :for="athlete in athletes">
        <div class="card flex items-center gap-4">
          <StxLink x-to="'/athlete/' + athlete.id" class="flex items-center gap-3 flex-1 min-w-0 group">
            <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-lg font-bold shrink-0">{{ athlete.name.charAt(0) }}</div>
            <div class="min-w-0">
              <p class="font-bold dark:text-white group-hover:text-emerald-600 transition truncate">{{ athlete.name }}</p>
              <p class="text-xs text-gray-500 dark:text-slate-400">
                <span>{{ athlete.activityCount + ' activities' }}</span>
                <span class="mx-1">·</span>
                <span>{{ athlete.followerCount + ' followers' }}</span>
                <span :if="athlete.territoriesOwned > 0" class="mx-1">·</span>
                <span :if="athlete.territoriesOwned > 0">{{ athlete.territoriesOwned + ' territories (' + areaKm2(athlete.totalAreaOwned) + ' km²)' }}</span>
              </p>
            </div>
          </StxLink>
          <button
            :if="tb && athlete.id !== tb.currentUserId()"
            @click="onFollow(athlete.id)"
            x-class="tb.isFollowing(athlete.id) ? 'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
            class="px-4 py-2 font-semibold text-xs rounded-lg transition shrink-0"
>{{ tb.isFollowing(athlete.id) ? 'Following' : 'Follow' }}</button>
          <span :if="tb && athlete.id === tb.currentUserId()" class="px-3 py-2 text-xs text-gray-400 shrink-0">That's you</span>
        </div>
      </template>

      <div :if="searched && athletes.length === 0" class="py-16 text-center">
        <div class="w-16 h-16 mx-auto mb-4 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
          <Icon name="search" size="28" class="text-emerald-400" />
        </div>
        <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1">No athletes found</h3>
        <p class="text-sm text-gray-500 dark:text-slate-400">{{ 'Nothing matched “' + query + '” — try another name.' }}</p>
      </div>
    </div>
  </div>
@endsection
