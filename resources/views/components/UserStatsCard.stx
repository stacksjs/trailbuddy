<script server>
import { defineProps, withDefaults } from 'stx'

interface UserStats {
  totalDistance: number
  totalTime: string
  totalElevation: number
  trailsCompleted: number
  currentStreak: number
  longestStreak: number
}

interface UserStatsCardProps {
  stats?: UserStats
}

const defaultStats: UserStats = {
  totalDistance: 0,
  totalTime: '0h 0m',
  totalElevation: 0,
  trailsCompleted: 0,
  currentStreak: 0,
  longestStreak: 0
}

const { stats } = withDefaults(defineProps<UserStatsCardProps>(), {
  stats: defaultStats
})

function formatNumber(num: number): string {
  return num.toLocaleString()
}
</script>

<template>
  <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-sm">
    <h3 class="flex items-center mb-4 font-bold text-gray-900 text-lg">
      <Icon name="bar-chart-3" size="20" class="mr-2 text-emerald-500" />
      Your Stats
    </h3>
    <div class="space-y-4">
      <div class="flex items-center justify-between p-3 bg-emerald-50 rounded-xl">
        <div>
          <p class="font-bold text-2xl text-emerald-700">{{ stats.totalDistance }}</p>
          <p class="text-emerald-600 text-sm">Total Miles</p>
        </div>
        <Icon name="trending-up" size="32" class="text-emerald-300" />
      </div>
      <div class="grid gap-3 grid-cols-2">
        <div class="p-3 bg-gray-50 rounded-xl">
          <p class="font-bold text-gray-900 text-lg">{{ stats.totalTime }}</p>
          <p class="text-gray-500 text-xs">Time Active</p>
        </div>
        <div class="p-3 bg-gray-50 rounded-xl">
          <p class="font-bold text-gray-900 text-lg">{{ formatNumber(stats.totalElevation) }}</p>
          <p class="text-gray-500 text-xs">Elevation (ft)</p>
        </div>
        <div class="p-3 bg-gray-50 rounded-xl">
          <p class="font-bold text-gray-900 text-lg">{{ stats.trailsCompleted }}</p>
          <p class="text-gray-500 text-xs">Trails Done</p>
        </div>
        <div class="p-3 bg-orange-50 rounded-xl">
          <p class="font-bold text-lg text-orange-600">{{ stats.currentStreak }}</p>
          <p class="text-orange-500 text-xs">Day Streak</p>
        </div>
      </div>
    </div>
  </div>
</template>
