<script server>
import { defineProps, withDefaults } from 'stx'

interface SearchFilterProps {
  activeFilter?: string
}

const { activeFilter } = withDefaults(defineProps<SearchFilterProps>(), {
  activeFilter: 'all'
})

const filters = [
  { id: 'all', label: 'All Trails' },
  { id: 'easy', label: 'Easy' },
  { id: 'moderate', label: 'Moderate' },
  { id: 'hard', label: 'Hard' },
  { id: 'dog-friendly', label: 'Dog Friendly' }
]
</script>

<script client>
import { state } from 'stx'

// Local state for current filter
const currentFilter = state('all')

// Handle filter change
function selectFilter(filterId) {
  currentFilter.set(filterId)
  // Dispatch custom event for parent to handle
  window.dispatchEvent(new CustomEvent('filter-change', { detail: { filter: filterId } }))
}
</script>

<template>
  <section class="relative z-20 -mt-8 mx-auto px-4 sm:px-6 lg:px-8 max-w-5xl">
    <div class="p-6 bg-white rounded-2xl shadow-xl">
      <div class="flex flex-col gap-4 md:flex-row">
        <!-- Search input -->
        <div class="relative flex-1">
          <svg class="absolute left-4 top-1/2 h-5 w-5 text-gray-400 transform -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" placeholder="Search trails, parks, or cities..." class="pl-12 pr-4 py-3 w-full bg-gray-50 border border-gray-200 rounded-xl focus:border-transparent focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <!-- Location -->
        <div class="relative">
          <svg class="absolute left-4 top-1/2 h-5 w-5 text-gray-400 transform -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <input type="text" placeholder="Near me" class="pl-12 pr-4 py-3 w-full md:w-48 bg-gray-50 border border-gray-200 rounded-xl focus:border-transparent focus:outline-none focus:ring-2 focus:ring-emerald-500" />
        </div>
        <!-- Search button -->
        <button class="px-8 py-3 font-semibold text-white bg-emerald-600 hover:bg-emerald-700 rounded-xl shadow-lg hover:shadow-xl transition">
          Search
        </button>
      </div>

      <!-- Quick filters - SSR the buttons, client handles active state -->
      <div class="flex flex-wrap gap-2 mt-4">
        @foreach(filters as filter)
          <button
            @click="selectFilter('{{ filter.id }}')"
            x-class="currentFilter() === filter.id ? 'bg-emerald-600 text-white border-emerald-600' : 'text-gray-600 border-gray-200 hover:border-emerald-500 hover:text-emerald-600'"
            class="px-4 py-2 font-medium text-sm border rounded-full transition"
          >
            {{ filter.label }}
          </button>
        @endforeach
      </div>
    </div>
  </section>
</template>
