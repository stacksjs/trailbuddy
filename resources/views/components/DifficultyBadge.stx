<script server>
import { defineProps } from 'stx'

type Difficulty = 'easy' | 'moderate' | 'hard'

interface DifficultyBadgeProps {
  difficulty: Difficulty
}

const { difficulty } = defineProps<DifficultyBadgeProps>()

function getDifficultyClass(diff: Difficulty): string {
  const classes: Record<Difficulty, string> = {
    easy: 'difficulty-easy',
    moderate: 'difficulty-moderate',
    hard: 'difficulty-hard'
  }
  return classes[diff] || 'difficulty-moderate'
}
</script>

<template>
  <span class="px-3 py-1 capitalize font-semibold text-xs rounded-full {{ }} getDifficultyClass(difficulty)">
    {{ difficulty }}
  </span>
</template>
