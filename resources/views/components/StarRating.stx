<script server>
import { defineProps } from 'stx'

interface StarRatingProps {
  rating: number
  reviewCount?: number
  showCount?: boolean
}

const { rating, reviewCount, showCount } = defineProps<StarRatingProps>()

function formatNumber(num: number): string {
  return num.toLocaleString()
}
</script>

<template>
  <div class="flex items-center space-x-1 text-sm">
    <Icon name="star" size="16" class="text-yellow-400" />
    <span class="font-semibold text-gray-900">{{ rating }}</span>
    @if(showCount && reviewCount)
      <span class="text-gray-400">({{ formatNumber(reviewCount) }})</span>
    @endif
  </div>
</template>
