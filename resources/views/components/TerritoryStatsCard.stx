<script server>
import { defineProps, withDefaults } from 'stx'

interface TerritoryStatsCardProps {
  totalTerritoriesOwned?: number
  totalAreaOwned?: number
  territoriesClaimed?: number
  territoriesConquered?: number
  territoriesLost?: number
  territoriesDefended?: number
  weeklyRank?: number
  allTimeRank?: number
}

const props = withDefaults(defineProps<TerritoryStatsCardProps>(), {
  totalTerritoriesOwned: 0,
  totalAreaOwned: 0,
  territoriesClaimed: 0,
  territoriesConquered: 0,
  territoriesLost: 0,
  territoriesDefended: 0,
  weeklyRank: 999,
  allTimeRank: 999
})

function formatArea(sqMeters: number): string {
  if (sqMeters >= 1000000) {
    return `${(sqMeters / 1000000).toFixed(2)} km²`
  } else if (sqMeters >= 10000) {
    return `${(sqMeters / 10000).toFixed(1)} ha`
  }
  return `${Math.round(sqMeters).toLocaleString()} m²`
}
</script>

<template>
  <div class="p-6 bg-white border border-gray-100 rounded-2xl shadow-sm">
    <h3 class="flex items-center mb-4 font-bold text-gray-900 text-lg">
      <Icon name="globe" size="20" class="mr-2 text-emerald-600" />
      Your Territory Empire
    </h3>

    <!-- Main Stats -->
    <div class="grid gap-4 grid-cols-2 mb-6">
      <div class="p-4 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl">
        <p class="font-medium text-emerald-600 text-xs tracking-wide uppercase">Territories</p>
        <p class="mt-1 font-bold text-3xl text-gray-900">{{ props.totalTerritoriesOwned }}</p>
        <p class="mt-1 text-gray-500 text-xs">currently owned</p>
      </div>
      <div class="p-4 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl">
        <p class="font-medium text-blue-600 text-xs tracking-wide uppercase">Total Area</p>
        <p class="mt-1 font-bold text-2xl text-gray-900">{{ formatArea(props.totalAreaOwned) }}</p>
        <p class="mt-1 text-gray-500 text-xs">controlled</p>
      </div>
    </div>

    <!-- Detailed Stats -->
    <div class="space-y-3">
      <div class="flex items-center justify-between py-2 border-b border-gray-100">
        <span class="flex items-center text-gray-600 text-sm">
          <Icon name="check-circle" size="16" class="mr-2 text-green-500" />
          Territories Claimed
        </span>
        <span class="font-semibold text-gray-900">{{ props.territoriesClaimed }}</span>
      </div>
      <div class="flex items-center justify-between py-2 border-b border-gray-100">
        <span class="flex items-center text-gray-600 text-sm">
          <Icon name="flame" size="16" class="mr-2 text-orange-500" />
          Territories Conquered
        </span>
        <span class="font-semibold text-gray-900">{{ props.territoriesConquered }}</span>
      </div>
      <div class="flex items-center justify-between py-2 border-b border-gray-100">
        <span class="flex items-center text-gray-600 text-sm">
          <Icon name="shield" size="16" class="mr-2 text-blue-500" />
          Successfully Defended
        </span>
        <span class="font-semibold text-gray-900">{{ props.territoriesDefended }}</span>
      </div>
      <div class="flex items-center justify-between py-2">
        <span class="flex items-center text-gray-600 text-sm">
          <Icon name="x-circle" size="16" class="mr-2 text-red-500" />
          Territories Lost
        </span>
        <span class="font-semibold text-gray-900">{{ props.territoriesLost }}</span>
      </div>
    </div>

    <!-- Rankings -->
    <div class="grid gap-3 grid-cols-2 mt-6">
      <div class="p-3 text-center bg-yellow-50 rounded-xl">
        <p class="font-medium text-xs text-yellow-700">Weekly Rank</p>
        <p class="font-bold text-2xl text-yellow-600">#{{ props.weeklyRank }}</p>
      </div>
      <div class="p-3 text-center bg-purple-50 rounded-xl">
        <p class="font-medium text-purple-700 text-xs">All-Time Rank</p>
        <p class="font-bold text-2xl text-purple-600">#{{ props.allTimeRank }}</p>
      </div>
    </div>
  </div>
</template>
