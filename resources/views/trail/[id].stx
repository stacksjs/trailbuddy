@extends('layouts/default')

@section('title', 'Trail Details — TrailBuddy')

@section('content')
<script server>
export async function getStaticPaths() {
  return { paths: Array.from({ length: 12 }, (_, i) => ({ params: { id: String(i + 1) } })) }
}
</script>

<script client>
  useHead({ title: 'Trail Details — TrailBuddy' })

  const tb = useStore('tb')
  const saved = state(false)
  const reviewTab = state<'reviews' | 'conditions'>('reviews')

  const trailId = Number(
    (typeof window !== 'undefined'
      && ((window as any).stx?._rp?.id ?? (window as any).__stx_rp?.id))
    ?? 1
  )

  const trail = derived(() => tb ? tb.trails().find((t: any) => t.id === trailId) ?? null : null)
  const reviews = derived(() => tb ? tb.reviews().filter((r: any) => r.trail_id === trailId) : [])
  const segments = derived(() => tb ? tb.segments().filter((s: any) => s.trail_id === trailId) : [])

  onMount(() => {
    setTimeout(() => {
      if (typeof L === 'undefined' || !tb) return
      const coords = tb.trailRoutes()[trailId]
      if (!coords) return
      const el = document.getElementById('trail-map') as any
      if (!el) return
      // Guard against double-init on SPA re-navigation
      if (el._leaflet_id) {
        try { el._leaflet_map?.remove() } catch { /* noop */ }
        el._leaflet_id = null
      }
      const map = L.map('trail-map', { scrollWheelZoom: false })
      el._leaflet_map = map
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 18, detectRetina: true }).addTo(map)
      const polyline = L.polyline(coords, { color: '#059669', weight: 4, opacity: 0.9 }).addTo(map)
      map.fitBounds(polyline.getBounds(), { padding: [30, 30] })
    }, 100)
  })
</script>

  <div :if="trail">
    <!-- Hero -->
    <section class="relative h-72 sm:h-96 bg-gradient-to-br from-emerald-700 to-teal-800 overflow-hidden">
      <img x-src="trail.image || 'https://images.unsplash.com/photo-1551632811-561732d1e306?w=1600&h=900&fit=crop'" x-alt="trail.name" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/20"></div>
      <div class="relative h-full flex items-end px-4 mx-auto max-w-7xl sm:px-6 lg:px-8 pb-8">
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-3">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold capitalize" x-class="'difficulty-' + trail.difficulty" x-text="trail.difficulty"></span>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-white/20 text-white" x-text="trail.distance + ' mi'"></span>
          </div>
          <h1 class="font-display text-3xl md:text-4xl font-bold text-white mb-2" x-text="trail.name"></h1>
          <p class="text-white/70" x-text="trail.location"></p>
        </div>
        <div class="flex gap-2">
          <button @click="saved.set(!saved())" class="p-3 rounded-xl backdrop-blur-sm transition" x-class="saved ? 'bg-red-500 text-white' : 'bg-white/20 text-white hover:bg-white/30'">
            <Icon name="heart" size="20" />
          </button>
          <StxLink to="/record" class="px-5 py-3 bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition">Start</StxLink>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <!-- Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="card text-center">
              <p class="text-2xl font-bold text-emerald-600" x-text="trail.distance"></p>
              <p class="metric-label">Miles</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-blue-600" x-text="trail.elevation.toLocaleString()"></p>
              <p class="metric-label">Elev (ft)</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-orange-600" x-text="trail.estimatedTime"></p>
              <p class="metric-label">Est. Time</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold" x-text="trail.rating"></p>
              <p class="metric-label" x-text="trail.reviewCount + ' reviews'"></p>
            </div>
          </div>

          <!-- Description -->
          <div class="card">
            <h2 class="font-bold text-lg dark:text-white mb-3">About This Trail</h2>
            <p class="text-gray-600 dark:text-slate-400 leading-relaxed" x-text="trail.description"></p>
            <div class="flex flex-wrap gap-2 mt-4">
              <template :for="tag in trail.tags">
                <span class="px-2.5 py-1 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 text-xs font-medium rounded-full" x-text="tag"></span>
              </template>
            </div>
          </div>

          <!-- Map -->
          <div class="card p-0 overflow-hidden">
            <div id="trail-map" class="h-64"></div>
          </div>

          <!-- Segments -->
          <div :if="segments.length > 0">
            <h2 class="font-bold text-lg dark:text-white mb-4">Segments</h2>
            <div class="space-y-3">
              <template :for="seg in segments">
                <div class="card flex items-center gap-4">
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-sm dark:text-white" x-text="seg.name"></p>
                    <p class="text-xs text-gray-500 dark:text-slate-400" x-text="seg.distance + ' mi · ' + Math.abs(seg.elevation) + ' ft'"></p>
                  </div>
                  <div class="text-right">
                    <p class="text-sm font-bold dark:text-white" x-text="seg.yourTime || '—'"></p>
                    <p class="text-xs text-gray-500" x-text="seg.yourRank ? '#' + seg.yourRank : 'Not attempted'"></p>
                  </div>
                  <div class="text-right">
                    <p class="text-xs text-yellow-600 font-medium">CR</p>
                    <p class="text-xs text-gray-500" x-text="seg.leaderTime + ' · ' + seg.leaderName"></p>
                  </div>
                </div>
              </template>
            </div>
          </div>

          <!-- Reviews -->
          <div>
            <div class="flex gap-1 mb-4 border-b border-gray-200 dark:border-slate-700">
              <button @click="reviewTab.set('reviews')" x-class="reviewTab === 'reviews' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500'" class="px-4 py-3 text-sm font-medium border-b-2 transition" x-text="'Reviews (' + reviews.length + ')'"></button>
              <button @click="reviewTab.set('conditions')" x-class="reviewTab === 'conditions' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500'" class="px-4 py-3 text-sm font-medium border-b-2 transition">Conditions</button>
            </div>

            <div :if="reviewTab === 'reviews'" class="space-y-4">
              <template :for="review in reviews">
                <div class="card">
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-3">
                      <div class="w-9 h-9 rounded-full bg-emerald-100 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 text-sm font-bold" x-text="review.userName.charAt(0)"></div>
                      <div>
                        <p class="font-semibold text-sm dark:text-white" x-text="review.userName"></p>
                        <p class="text-xs text-gray-500" x-text="tb.timeAgo(review.created_at)"></p>
                      </div>
                    </div>
                    <span class="text-yellow-400" x-text="'★'.repeat(review.rating)"></span>
                  </div>
                  <p class="text-sm text-gray-600 dark:text-slate-400" x-text="review.text"></p>
                </div>
              </template>
            </div>

            <div :if="reviewTab === 'conditions'" class="card">
              <h3 class="font-semibold text-sm dark:text-white mb-2">Current Conditions</h3>
              <p class="text-sm text-gray-600 dark:text-slate-400" x-text="trail.conditions"></p>
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Trail Info</h3>
            <div class="space-y-3">
              <div class="flex justify-between"><span class="text-sm text-gray-500">Difficulty</span><span class="text-sm font-medium capitalize" x-class="'difficulty-' + trail.difficulty" x-text="trail.difficulty"></span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Distance</span><span class="text-sm font-medium dark:text-white" x-text="trail.distance + ' mi'"></span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Elevation</span><span class="text-sm font-medium dark:text-white" x-text="trail.elevation.toLocaleString() + ' ft'"></span></div>
              <div class="flex justify-between"><span class="text-sm text-gray-500">Time</span><span class="text-sm font-medium dark:text-white" x-text="trail.estimatedTime"></span></div>
            </div>
          </div>

          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Weather</h3>
            <div class="text-center py-4">
              <Icon name="sun" size="40" class="mx-auto mb-2 text-yellow-500" />
              <p class="text-2xl font-bold dark:text-white">72°F</p>
              <p class="text-sm text-gray-500">Clear skies</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if="!trail" class="text-center py-32">
    <p class="text-gray-500 font-medium">Trail not found</p>
    <StxLink to="/trails" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Browse Trails</StxLink>
  </div>
@endsection
