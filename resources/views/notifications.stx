@extends('layouts/default')

@section('title', 'Notifications — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Notifications — TrailBuddy' })

  const tb = useStore('tb')
  const filter = state<'all' | 'unread' | 'conquest' | 'kudos' | 'challenge'>('all')

  const unreadCount = derived(() => tb ? tb.unreadCount() : 0)

  const filtered = derived(() => {
    if (!tb) return []
    const f = filter()
    if (f === 'all') return tb.notifications()
    if (f === 'unread') return tb.notifications().filter((n: any) => !n.read)
    return tb.notifications().filter((n: any) =>
      n.type === f || (f === 'conquest' && n.type.startsWith('conquest'))
    )
  })

  const iconBg = (type: string): string => {
    if (type === 'kudos') return 'bg-red-100 dark:bg-red-900/20'
    if (type === 'comment') return 'bg-blue-100 dark:bg-blue-900/20'
    if (type === 'conquest_attack') return 'bg-orange-100 dark:bg-orange-900/20'
    if (type === 'conquest_defend') return 'bg-emerald-100 dark:bg-emerald-900/20'
    if (type === 'conquest_win') return 'bg-yellow-100 dark:bg-yellow-900/20'
    if (type === 'challenge') return 'bg-purple-100 dark:bg-purple-900/20'
    if (type === 'achievement') return 'bg-yellow-100 dark:bg-yellow-900/20'
    if (type === 'club') return 'bg-indigo-100 dark:bg-indigo-900/20'
    return 'bg-gray-100 dark:bg-slate-700'
  }

  const iconColor = (type: string): string => {
    if (type === 'kudos') return 'text-red-500'
    if (type === 'comment') return 'text-blue-500'
    if (type === 'conquest_attack') return 'text-orange-500'
    if (type === 'conquest_defend') return 'text-emerald-500'
    if (type === 'conquest_win' || type === 'achievement') return 'text-yellow-500'
    if (type === 'challenge') return 'text-purple-500'
    if (type === 'club') return 'text-indigo-500'
    return 'text-gray-500'
  }
</script>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center justify-between mb-6">
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-bold dark:text-white">Notifications</h1>
        <span :if="unreadCount > 0" class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-500 text-white" :text="unreadCount"></span>
      </div>
      <button :if="unreadCount > 0" @click="tb.markAllNotificationsRead()" class="text-sm text-emerald-600 hover:text-emerald-700 font-medium transition">Mark all read</button>
    </div>

    <!-- Filter tabs -->
    <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
      <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">All</button>
      <button @click="filter.set('unread')" x-class="filter === 'unread' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Unread</button>
      <button @click="filter.set('conquest')" x-class="filter === 'conquest' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Conquests</button>
      <button @click="filter.set('kudos')" x-class="filter === 'kudos' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Kudos</button>
      <button @click="filter.set('challenge')" x-class="filter === 'challenge' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium whitespace-nowrap transition">Challenges</button>
    </div>

    <!-- Notification list -->
    <div class="space-y-2">
      <template :for="notif in filtered">
        <StxLink x-to="notif.link || '#'" @click="tb.markNotificationRead(notif.id)" class="card flex items-start gap-4 transition block" x-class="!notif.read ? 'bg-emerald-50/50 dark:bg-emerald-900/5 border-emerald-200 dark:border-emerald-800/30' : ''">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" x-class="iconBg(notif.type)">
            <span x-class="iconColor(notif.type)" class="font-bold">●</span>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-gray-900 dark:text-white" :text="notif.title"></p>
            <p class="text-sm text-gray-600 dark:text-slate-400 mt-0.5" :text="notif.message"></p>
            <p class="text-xs text-gray-400 dark:text-slate-500 mt-1" :text="tb.timeAgo(notif.created_at)"></p>
          </div>
          <div :if="!notif.read" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0 mt-2"></div>
        </StxLink>
      </template>

      <!-- Empty state -->
      <div :if="filtered.length === 0" class="py-20 text-center">
        <div class="w-20 h-20 mx-auto mb-6 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
          <svg class="w-10 h-10 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">You're all caught up!</h3>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto">No new notifications.</p>
      </div>
    </div>
  </div>
@endsection
