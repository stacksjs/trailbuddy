@extends('layouts/default')

@section('title', 'Activity Feed — TrailBuddy')

@section('content')
<script client>
  import { routePreviewDataUri } from '../composables/useRoutePreview'
  import { useManualActivity } from '../composables/useManualActivity'
  import { toggleFollow, toggleKudos } from '../assets/scripts/game-api'

  useHead({ title: 'Activity Feed — TrailBuddy' })

  const tb = useStore('tb')

  const {
    manualOpen, submitting, manualError,
    mType, mDistance, mDuration, mElevation, mTrailId, mDate, mNotes,
    openManualEntry, closeManualEntry, submitManualEntry,
  } = useManualActivity(tb)
  const filter = state<'all' | 'Trail Run' | 'Hike' | 'Walk' | 'Bike'>('all')
  const scope = state<'all' | 'following'>('all')
  const kudosed = state<Record<number, boolean>>({})

  async function onFollow(userId: number) {
    if (!tb || userId === tb.currentUserId()) return
    const wasFollowing = tb.isFollowing(userId)
    tb.setFollowing(userId, !wasFollowing) // optimistic
    const res = await toggleFollow(userId)
    if (res && res.success) tb.setFollowing(userId, !!res.following)
    else tb.setFollowing(userId, wasFollowing) // rollback
  }

  async function onKudos(activity: { id: number, kudos_count: number }) {
    if (!tb) return
    const wasKudosed = kudosed()[activity.id] ?? false
    // Optimistic toggle for a snappy UI.
    kudosed.set({ ...kudosed(), [activity.id]: !wasKudosed })
    tb.setActivityKudos(activity.id, Math.max(0, activity.kudos_count + (wasKudosed ? -1 : 1)))
    const res = await toggleKudos(activity.id, tb.currentUserId())
    if (res && res.success) {
      kudosed.set({ ...kudosed(), [activity.id]: !!res.kudosed })
      if (typeof res.kudosCount === 'number') tb.setActivityKudos(activity.id, res.kudosCount)
    }
    else {
      kudosed.set({ ...kudosed(), [activity.id]: wasKudosed })
      tb.setActivityKudos(activity.id, activity.kudos_count)
    }
  }

  const filtered = derived(() => {
    if (!tb) return []
    const f = filter()
    const s = scope()
    const me = tb.currentUserId()
    let list = tb.activities()
    if (s === 'following')
      list = list.filter((a: any) => a.user_id === me || tb.isFollowing(a.user_id))
    if (f !== 'all')
      list = list.filter((a: any) => a.activityType === f)
    return list
  })

  function activityRoutePreview(activity: { trail_id?: number | null }): string | null {
    if (!tb || !activity.trail_id) return null
    const coords = tb.trailRoutes()[activity.trail_id]
    return coords ? routePreviewDataUri(coords) : null
  }
</script>

  <div class="mx-auto px-4 py-6 sm:px-6 lg:px-8 max-w-3xl">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-bold text-2xl dark:text-white">Activity Feed</h1>
        <p class="text-sm text-gray-500 dark:text-slate-400">Runs, kudos, and conquest highlights</p>
      </div>
      <div class="flex items-center gap-2">
        <button @click="openManualEntry()" class="px-4 py-2 font-semibold text-sm text-emerald-700 dark:text-emerald-400 border border-emerald-600/40 hover:border-emerald-600 rounded-lg transition">Log activity</button>
        <StxLink to="/record" class="px-4 py-2 font-semibold text-sm text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition">Capture run</StxLink>
      </div>
    </div>

    <div :if="tb && tb.liveConquests().length > 0" class="mb-6 p-4 bg-orange-50 dark:bg-orange-900/10 border border-orange-200 dark:border-orange-800/40 rounded-xl">
      <p class="flex gap-2 items-center mb-2 font-semibold text-sm text-orange-800 dark:text-orange-300">
        <span class="h-2 w-2 bg-red-500 rounded-full animate-pulse"></span>
        Live turf battles
      </p>
      <StxLink to="/battles" class="text-sm font-semibold text-emerald-600">See who's attacking →</StxLink>
    </div>

    <!-- Scope: Following vs Everyone -->
    <div class="flex gap-2 mb-4">
      <button @click="scope.set('all')" x-class="scope === 'all' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-3 py-1.5 font-semibold text-sm border-b-2 transition">Everyone</button>
      <button @click="scope.set('following')" x-class="scope === 'following' ? 'border-emerald-600 text-emerald-600' : 'border-transparent text-gray-500 dark:text-slate-400'" class="px-3 py-1.5 font-semibold text-sm border-b-2 transition">Following</button>
    </div>

    <!-- Filter tabs -->
    <div class="flex overflow-x-auto gap-2 mb-6 pb-2">
      <button @click="filter.set('all')" x-class="filter === 'all' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">All</button>
      <button @click="filter.set('Trail Run')" x-class="filter === 'Trail Run' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Runs</button>
      <button @click="filter.set('Hike')" x-class="filter === 'Hike' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Hikes</button>
      <button @click="filter.set('Walk')" x-class="filter === 'Walk' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Walks</button>
      <button @click="filter.set('Bike')" x-class="filter === 'Bike' ? 'bg-emerald-600 text-white' : 'bg-gray-100 text-gray-600 dark:text-slate-400 dark:bg-slate-800'" class="px-4 py-2 font-medium text-sm whitespace-nowrap rounded-lg transition">Rides</button>
    </div>

    <!-- Activity cards -->
    <div class="space-y-6">
      <template :for="activity in filtered">
        <div class="card">
          <div class="flex items-center justify-between mb-4">
            <div class="flex gap-3 items-center">
              <div class="flex items-center justify-center h-10 w-10 font-bold text-emerald-600 text-sm bg-emerald-100 dark:bg-emerald-900/30 rounded-full">{{ activity.userName.charAt(0) }}</div>
              <div>
                <StxLink x-to="'/athlete/' + activity.user_id" class="font-semibold text-sm dark:text-white hover:text-emerald-600 transition">{{ activity.userName }}</StxLink>
                <p class="text-gray-500 text-xs dark:text-slate-400">
                  <span>{{ activity.activityType }}</span>
                  <span class="mx-1">·</span>
                  <span>{{ tb.timeAgo(activity.created_at) }}</span>
                </p>
              </div>
            </div>
            <button
              :if="activity.user_id !== tb.currentUserId()"
              @click="onFollow(activity.user_id)"
              x-class="tb.isFollowing(activity.user_id) ? 'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300' : 'bg-emerald-600 text-white hover:bg-emerald-700'"
              class="px-3 py-1.5 font-semibold text-xs rounded-lg transition"
>{{ tb.isFollowing(activity.user_id) ? 'Following' : 'Follow' }}</button>
          </div>

          <StxLink x-to="'/activity/' + activity.id" class="font-bold text-gray-900 text-lg dark:text-white hover:text-emerald-600 transition block">{{ activity.title }}</StxLink>
          <p :if="activity.title.includes('Capture')" class="mt-1 text-xs text-purple-600 font-medium">Territory capture run</p>

          <div :if="activityRoutePreview(activity)" class="route-preview mt-3" x-style="'background-image:url(' + activityRoutePreview(activity) + ')'"></div>
          <div :else class="mt-3 rounded-xl overflow-hidden h-40 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-slate-700 dark:to-slate-800 flex items-center justify-center">
            <div class="text-center text-gray-400 dark:text-slate-500">
              <Icon name="map" size="32" class="mx-auto mb-1" />
              <p class="text-xs">Route Map</p>
            </div>
          </div>

          <div class="grid gap-3 grid-cols-2 sm:grid-cols-4 mt-4">
            <div class="text-center">
              <p class="font-bold text-lg dark:text-white">{{ activity.distance.toFixed(1) }}</p>
              <p class="metric-label">Miles</p>
            </div>
            <div class="text-center">
              <p class="font-bold text-lg dark:text-white">{{ activity.duration }}</p>
              <p class="metric-label">Time</p>
            </div>
            <div class="text-center">
              <p class="font-bold text-lg dark:text-white">{{ activity.pace }}</p>
              <p class="metric-label">Pace</p>
            </div>
            <div class="text-center">
              <p class="font-bold text-lg dark:text-white">{{ activity.elevation_gain.toLocaleString() }}</p>
              <p class="metric-label">Elev (ft)</p>
            </div>
          </div>

          <div class="flex gap-6 items-center mt-4 pt-4 border-gray-100 border-t dark:border-slate-700">
            <button @click="onKudos(activity)" x-class="kudosed[activity.id] ? 'text-red-500' : 'text-gray-500 dark:text-slate-400 hover:text-red-500'" class="flex items-center gap-1 transition text-sm">
              <Icon name="heart" size="20" />
              <span>{{ activity.kudos_count + ' Kudos' }}</span>
            </button>
            <StxLink x-to="'/activity/' + activity.id" class="flex items-center gap-1 text-gray-500 dark:text-slate-400 hover:text-emerald-500 transition text-sm">
              <Icon name="message-circle" size="20" />
              Comment
            </StxLink>
          </div>
        </div>
      </template>

      <!-- Empty state -->
      <div :if="filtered.length === 0" class="py-20 text-center">
        <div class="w-20 h-20 mx-auto mb-6 bg-emerald-100 dark:bg-emerald-900/20 rounded-2xl flex items-center justify-center">
          <Icon name="zap" size="40" class="text-emerald-400" />
        </div>
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">No activities yet</h3>
        <p class="text-gray-500 dark:text-slate-400 max-w-sm mx-auto mb-6">Your feed is empty. Head outside and record your first trail run!</p>
        <StxLink to="/record" class="px-6 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Record Activity</StxLink>
      </div>
    </div>
  </div>

  <!-- Manual entry modal (#955) -->
  <div :if="manualOpen" class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div @click="closeManualEntry()" class="absolute inset-0 bg-black/40"></div>
    <div class="relative w-full max-w-md card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg dark:text-white">Log an activity</h2>
        <button @click="closeManualEntry()" class="text-gray-400 hover:text-gray-600 dark:hover:text-slate-200 text-xl leading-none">×</button>
      </div>
      <div class="space-y-3">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Type</label>
            <select x-value="mType" @change="mType.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
              <option value="Trail Run">Trail Run</option>
              <option value="Hike">Hike</option>
              <option value="Walk">Walk</option>
              <option value="Bike">Bike</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Date</label>
            <input type="date" x-value="mDate" @input="mDate.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Miles</label>
            <input type="text" inputmode="decimal" placeholder="5.2" x-value="mDistance" @input="mDistance.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Duration</label>
            <input type="text" placeholder="45:30" x-value="mDuration" @input="mDuration.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Elev (ft)</label>
            <input type="text" inputmode="numeric" placeholder="350" x-value="mElevation" @input="mElevation.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Trail (optional)</label>
          <select @change="mTrailId.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
            <option value="">No trail</option>
            <template :for="trail in tb.trails()">
              <option x-value="trail.id" x-selected="String(trail.id) === mTrailId" :text="trail.name"></option>
            </template>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Notes</label>
          <textarea rows="2" placeholder="How did it go?" x-value="mNotes" @input="mNotes.set($event.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm"></textarea>
        </div>
        <p :if="manualError" class="text-sm text-red-500">{{ manualError }}</p>
        <div class="flex gap-2 pt-1">
          <button @click="submitManualEntry()" class="flex-1 px-4 py-2.5 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">{{ submitting ? 'Saving…' : 'Log activity' }}</button>
          <button @click="closeManualEntry()" class="px-4 py-2.5 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 transition">Cancel</button>
        </div>
        <p class="text-xs text-gray-400">Manual entries don't capture territory — record with GPS to claim ground.</p>
      </div>
    </div>
  </div>
@endsection
