@extends('layouts/default')

@section('title', 'Activity Details — TrailBuddy')

@section('content')
<script client>
  import { createTrailMap, drawTrailRoute, runWhenMapReady, type TrailMapHandle } from '../../composables/useTrailMap'
  import { useActivityEditor } from '../../composables/useActivityEditor'
  import { useMentions } from '../../composables/useMentions'
  import { useRouteParam } from '../../composables/useRouteParam'
  import { fetchActivityDetail, postComment, toggleKudos } from '../../assets/scripts/game-api'

  useHead({ title: 'Activity Details — TrailBuddy' })

  const tb = useStore('tb')
  const hasKudos = state(false)
  const newComment = state('')
  const comments = state<Array<{ id: number, userName: string, body: string, createdAt: string }>>([])

  // -1 is a no-match sentinel so an unresolved param renders "not found"
  // rather than silently loading activity 1 (#987).
  const activityId = useRouteParam('id') ?? -1

  const activity = derived(() => tb ? tb.findActivity(activityId) : null)
  const isOwner = derived(() => !!(tb && activity() && activity().user_id === tb.currentUserId()))

  const { mentionMatches, onCommentInput, pickMention, clearMentions, mentionSegments } = useMentions(tb, newComment)

  const {
    editing, saving, deleted, confirmingDelete, editorError,
    formType, formNotes, formDistance, formDuration, formElevation, formVisibility,
    openEditor, closeEditor, saveEdit, deleteRun, cancelDelete,
  } = useActivityEditor(tb)

  // Hydrate real comments from the API on load (falls back to whatever the
  // store activity already carries).
  onMount(async () => {
    const detail = await fetchActivityDetail(activityId)
    if (detail && Array.isArray(detail.comments))
      comments.set(detail.comments)
    else if (activity()?.comments)
      comments.set(activity().comments)
    // The API is authoritative for GPS-lock + notes (persisted store copies
    // from before #954 don't carry them).
    if (detail && tb && typeof detail.hasGps === 'boolean')
      tb.patchActivity(activityId, { hasGps: detail.hasGps, notes: detail.notes ?? '', visibility: detail.visibility ?? 'public' })
  })

  const handlers = {
    async toggleKudos() {
      if (!tb || !activity()) return
      const was = hasKudos()
      hasKudos.set(!was)
      tb.toggleKudos(activityId, was ? -1 : 1)
      const res = await toggleKudos(activityId, tb.currentUserId())
      if (res && res.success) {
        hasKudos.set(!!res.kudosed)
        if (typeof res.kudosCount === 'number') tb.setActivityKudos(activityId, res.kudosCount)
      }
      else {
        hasKudos.set(was)
      }
    },
    async submitComment() {
      const text = newComment().trim()
      if (!text || !tb) return
      newComment.set('')
      clearMentions()
      const created = await postComment(activityId, tb.currentUserId(), text)
      if (created)
        comments.set([...comments(), created])
    },
  }

  let activityMap: TrailMapHandle | null = null

  async function mountActivityMap() {
    if (!tb) return
    const a = tb.findActivity(activityId)
    if (!a || !a.trail_id) return
    const route = tb.trailRoutes()[a.trail_id]
    if (!route || route.length < 2) return
    activityMap?.destroy()
    activityMap = await createTrailMap('activity-map', { scrollWheelZoom: false })
    if (!activityMap) return
    await drawTrailRoute(activityMap.map, route, { color: '#059669', weight: 4, opacity: 0.9 })
    activityMap.fitPoints(route, [30, 30])
  }

  onMount(() => runWhenMapReady('activity-map', mountActivityMap))

  onDestroy(() => {
    activityMap?.destroy()
    activityMap = null
  })
</script>

  <div :if="activity" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="card mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-lg font-bold">{{ activity.userName.charAt(0) }}</div>
          <div>
            <p class="font-bold dark:text-white">{{ activity.userName }}</p>
            <p class="text-sm text-gray-500 dark:text-slate-400">
              <span>{{ activity.activityType }}</span>
              <span class="mx-1">·</span>
              <span>{{ tb.timeAgo(activity.created_at) }}</span>
            </p>
          </div>
        </div>
        <div :if="isOwner" class="flex items-center gap-2">
          <button
            @click="editing ? closeEditor() : openEditor(activity)"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300 hover:border-emerald-500 hover:text-emerald-600 transition"
>{{ editing ? 'Close' : 'Edit' }}</button>
          <button
            :if="confirmingDelete"
            @click="cancelDelete()"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg border border-gray-200 dark:border-slate-600 text-gray-600 dark:text-slate-300 transition">Keep it</button>
          <button
            @click="deleteRun(activity)"
            x-class="confirmingDelete ? 'bg-red-600 text-white border-red-600' : 'border-gray-200 dark:border-slate-600 text-red-500 hover:border-red-400'"
            class="px-3 py-1.5 text-xs font-semibold rounded-lg border transition"
>{{ confirmingDelete ? 'Confirm delete' : 'Delete' }}</button>
        </div>
      </div>

      <div class="flex items-center gap-2 mb-2">
        <h1 class="text-2xl font-bold dark:text-white">{{ activity.title }}</h1>
        <span :if="activity.visibility && activity.visibility !== 'public'" class="px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-300">{{ activity.visibility === 'private' ? '🔒 Private' : '👥 Followers' }}</span>
      </div>
      <StxLink :if="activity.trail_id" x-to="'/trail/' + activity.trail_id" class="text-sm text-emerald-600 hover:underline">{{ '→ ' + activity.trail_name }}</StxLink>
      <p :if="activity.notes && !editing" class="mt-3 text-sm text-gray-600 dark:text-slate-300">{{ activity.notes }}</p>
      <p :if="editorError && !editing" class="mt-2 text-sm text-red-500">{{ editorError }}</p>

      <!-- Owner edit panel (#954) -->
      <div :if="editing" class="mt-4 pt-4 border-t border-gray-100 dark:border-slate-700 space-y-3">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div>
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Type</label>
            <select x-value="formType" @change="e => formType.set(e.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
              <option value="Trail Run">Trail Run</option>
              <option value="Hike">Hike</option>
              <option value="Walk">Walk</option>
              <option value="Bike">Bike</option>
            </select>
          </div>
          <div :if="!activity.hasGps">
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Miles</label>
            <input type="text" inputmode="decimal" x-value="formDistance" @input="e => formDistance.set(e.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
          <div :if="!activity.hasGps">
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Duration</label>
            <input type="text" placeholder="45:30" x-value="formDuration" @input="e => formDuration.set(e.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
          <div :if="!activity.hasGps">
            <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Elev (ft)</label>
            <input type="text" inputmode="numeric" x-value="formElevation" @input="e => formElevation.set(e.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Notes</label>
          <textarea rows="2" x-value="formNotes" @input="e => formNotes.set(e.target.value)" placeholder="How did it go?" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm"></textarea>
        </div>
        <div>
          <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1">Who can see this</label>
          <select x-value="formVisibility" @change="e => formVisibility.set(e.target.value)" class="w-full px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm">
            <option value="public">Public — everyone</option>
            <option value="followers">Followers only</option>
            <option value="private">Private — just me</option>
          </select>
        </div>
        <p :if="activity.hasGps" class="text-xs text-gray-400">Distance, time and elevation come from the GPS track and can't be edited.</p>
        <p :if="editorError" class="text-sm text-red-500">{{ editorError }}</p>
        <div class="flex gap-2">
          <button @click="saveEdit(activity)" class="px-4 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">{{ saving ? 'Saving…' : 'Save changes' }}</button>
          <button @click="closeEditor()" class="px-4 py-2 text-sm font-medium text-gray-500 dark:text-slate-400 hover:text-gray-700 transition">Cancel</button>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="card p-0 overflow-hidden mb-6">
      <div id="activity-map" class="h-64"></div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-4 mb-6">
      <div class="card text-center">
        <p class="text-xl font-bold text-emerald-600">{{ activity.distance.toFixed(1) }}</p>
        <p class="metric-label">Miles</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white">{{ activity.moving_time || activity.duration }}</p>
        <p class="metric-label">Moving Time</p>
        <p :if="activity.moving_time && activity.moving_time !== activity.duration" class="text-xs text-gray-400 mt-1">{{ 'Elapsed ' + activity.duration }}</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white">{{ activity.pace }}</p>
        <p class="metric-label">Pace</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-blue-600">{{ activity.elevation_gain.toLocaleString() }}</p>
        <p class="metric-label">Elev (ft)</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-orange-600">{{ activity.calories || 0 }}</p>
        <p class="metric-label">Calories</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-red-500">{{ activity.heartRateAvg || '--' }}</p>
        <p class="metric-label">Avg HR</p>
      </div>
    </div>

    <!-- Splits -->
    <div :if="activity.splits && activity.splits.length > 0" class="card mb-6">
      <h2 class="font-bold text-lg dark:text-white mb-4">Splits</h2>
      <div class="space-y-2">
        <template :for="split in activity.splits">
          <div class="grid grid-cols-3 gap-2 items-center p-3 rounded-lg">
            <span class="text-sm font-medium dark:text-white">{{ 'Mile ' + split.mile }}</span>
            <span class="text-center text-sm font-semibold dark:text-white">{{ split.pace }}</span>
            <span class="text-right text-sm text-gray-600 dark:text-slate-400">{{ split.elev + ' ft' }}</span>
          </div>
        </template>
      </div>
    </div>

    <!-- Kudos & Comments -->
    <div class="card mb-6">
      <div class="flex items-center gap-6">
        <button @click="handlers.toggleKudos()" class="flex items-center gap-2 transition" x-class="hasKudos ? 'text-red-500' : 'text-gray-500 hover:text-red-500'">
          <Icon name="heart" size="18" />
          <span class="font-medium">{{ activity.kudos_count + ' Kudos' }}</span>
        </button>
        <span class="flex items-center gap-2 text-gray-500">
          <Icon name="message-circle" size="18" />
          <span class="font-medium">{{ comments.length + ' Comments' }}</span>
        </span>
      </div>
    </div>

    <!-- Comments -->
    <div class="card">
      <h2 class="font-bold text-lg dark:text-white mb-4">Comments</h2>
      <div class="space-y-4 mb-4">
        <template :for="comment in comments">
          <div class="flex gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-gray-600 dark:text-slate-300 shrink-0">{{ comment.userName.charAt(0) }}</div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-semibold dark:text-white">{{ comment.userName }}</span>
                <span class="text-xs text-gray-400">{{ tb.timeAgo(comment.createdAt) }}</span>
              </div>
              <p class="text-sm text-gray-600 dark:text-slate-400">
                <template :for="seg in mentionSegments(comment.body)">
                  <StxLink :if="seg.userId" x-to="'/athlete/' + seg.userId" class="text-emerald-600 font-medium hover:underline">{{ seg.text }}</StxLink>
                  <span :if="!seg.userId">{{ seg.text }}</span>
                </template>
              </p>
            </div>
          </div>
        </template>
        <div :if="comments.length === 0" class="text-center py-4 text-gray-400 text-sm">
          <p>No comments yet. Be the first!</p>
        </div>
      </div>

      <div class="pt-4 border-t border-gray-100 dark:border-slate-700">
        <!-- @mention autocomplete (#971) — appears while typing "@…" -->
        <div :if="mentionMatches.length > 0" class="mb-2 ml-11 flex flex-wrap gap-2">
          <template :for="candidate in mentionMatches">
            <button
              @click="pickMention(candidate.name)"
              class="px-3 py-1.5 text-xs font-medium rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40 hover:bg-emerald-100 transition"
>{{ '@' + candidate.name }}</button>
          </template>
        </div>
        <div class="flex gap-3">
          <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 text-xs font-bold shrink-0">Y</div>
          <div class="flex-1 flex gap-2">
            <input
              type="text"
              x-value="newComment"
              @input="onCommentInput($event.target.value)"
              @keydown.enter="handlers.submitComment()"
              placeholder="Write a comment... use @ to mention"
              class="flex-1 px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
            />
            <button @click="handlers.submitComment()" class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition">Post</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if="deleted" class="text-center py-32">
    <p class="text-gray-900 dark:text-white font-semibold mb-1">Activity deleted</p>
    <p class="text-gray-500 dark:text-slate-400 text-sm">Its kudos and comments are gone too. Territory you captured stays yours.</p>
    <StxLink to="/feed" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Feed</StxLink>
  </div>

  <div :if="!activity && !deleted" class="text-center py-32">
    <p class="text-gray-500 font-medium">Activity not found</p>
    <StxLink to="/feed" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Feed</StxLink>
  </div>
@endsection
