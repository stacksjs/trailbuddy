@extends('layouts/default')

@section('title', 'Activity Details — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Activity Details — TrailBuddy' })

  const tb = useStore('tb')
  const hasKudos = state(false)
  const newComment = state('')

  const activityId = Number(
    (typeof window !== 'undefined' && (window as any).__routeParams?.id)
    ?? 1
  )

  const activity = derived(() => tb ? tb.findActivity(activityId) : null)

  const handlers = {
    toggleKudos() {
      if (!activity()) return
      const delta = hasKudos() ? -1 : 1
      tb.toggleKudos(activityId, delta)
      hasKudos.set(!hasKudos())
    },
    submitComment() {
      const text = newComment().trim()
      if (!text) return
      tb.addComment(activityId, text)
      newComment.set('')
    },
  }

  onMount(() => {
    setTimeout(() => {
      if (typeof L === 'undefined' || !tb) return
      const a = tb.findActivity(activityId)
      if (!a || !a.trail_id) return
      const route = tb.trailRoutes()[a.trail_id]
      if (!route) return
      const el = document.getElementById('activity-map')
      if (!el) return
      const map = L.map('activity-map', { scrollWheelZoom: false })
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 18 }).addTo(map)
      const polyline = L.polyline(route, { color: '#059669', weight: 4, opacity: 0.9 }).addTo(map)
      map.fitBounds(polyline.getBounds(), { padding: [30, 30] })
    }, 100)
  })
</script>

  <div :if="activity" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="card mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-lg font-bold" :text="activity.userName.charAt(0)"></div>
          <div>
            <p class="font-bold dark:text-white" :text="activity.userName"></p>
            <p class="text-sm text-gray-500 dark:text-slate-400">
              <span :text="activity.activityType"></span>
              <span class="mx-1">·</span>
              <span :text="tb.timeAgo(activity.created_at)"></span>
            </p>
          </div>
        </div>
      </div>

      <h1 class="text-2xl font-bold dark:text-white mb-2" :text="activity.title"></h1>
      <StxLink :if="activity.trail_id" x-to="'/trail/' + activity.trail_id" class="text-sm text-emerald-600 hover:underline" :text="'→ ' + activity.trail_name"></StxLink>
    </div>

    <!-- Map -->
    <div class="card p-0 overflow-hidden mb-6">
      <div id="activity-map" class="h-64"></div>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-4 mb-6">
      <div class="card text-center">
        <p class="text-xl font-bold text-emerald-600" :text="activity.distance.toFixed(1)"></p>
        <p class="metric-label">Miles</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white" :text="activity.duration"></p>
        <p class="metric-label">Duration</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white" :text="activity.pace"></p>
        <p class="metric-label">Pace</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-blue-600" :text="activity.elevation_gain.toLocaleString()"></p>
        <p class="metric-label">Elev (ft)</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-orange-600" :text="activity.calories || 0"></p>
        <p class="metric-label">Calories</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-red-500" :text="activity.heartRateAvg || '--'"></p>
        <p class="metric-label">Avg HR</p>
      </div>
    </div>

    <!-- Splits -->
    <div :if="activity.splits && activity.splits.length > 0" class="card mb-6">
      <h2 class="font-bold text-lg dark:text-white mb-4">Splits</h2>
      <div class="space-y-2">
        <template :for="split in activity.splits">
          <div class="grid grid-cols-3 items-center p-3 rounded-lg">
            <span class="text-sm font-medium dark:text-white" :text="'Mile ' + split.mile"></span>
            <span class="text-center text-sm font-semibold dark:text-white" :text="split.pace"></span>
            <span class="text-right text-sm text-gray-600 dark:text-slate-400" :text="split.elev + ' ft'"></span>
          </div>
        </template>
      </div>
    </div>

    <!-- Kudos & Comments -->
    <div class="card mb-6">
      <div class="flex items-center gap-6">
        <button @click="handlers.toggleKudos()" class="flex items-center gap-2 transition" x-class="hasKudos ? 'text-red-500' : 'text-gray-500 hover:text-red-500'">
          <span>♥</span>
          <span class="font-medium" :text="activity.kudos_count + ' Kudos'"></span>
        </button>
        <span class="flex items-center gap-2 text-gray-500">
          <span>💬</span>
          <span class="font-medium" :text="(activity.comments || []).length + ' Comments'"></span>
        </span>
      </div>
    </div>

    <!-- Comments -->
    <div class="card">
      <h2 class="font-bold text-lg dark:text-white mb-4">Comments</h2>
      <div class="space-y-4 mb-4">
        <template :for="comment in activity.comments">
          <div class="flex gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-gray-600 dark:text-slate-300 shrink-0" :text="comment.userName.charAt(0)"></div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-semibold dark:text-white" :text="comment.userName"></span>
                <span class="text-xs text-gray-400" :text="tb.timeAgo(comment.created_at)"></span>
              </div>
              <p class="text-sm text-gray-600 dark:text-slate-400" :text="comment.text"></p>
            </div>
          </div>
        </template>
        <div :if="!activity.comments || activity.comments.length === 0" class="text-center py-4 text-gray-400 text-sm">
          <p>No comments yet. Be the first!</p>
        </div>
      </div>

      <div class="flex gap-3 pt-4 border-t border-gray-100 dark:border-slate-700">
        <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 text-xs font-bold shrink-0">Y</div>
        <div class="flex-1 flex gap-2">
          <input
            type="text"
            x-value="newComment"
            @input="e => newComment.set(e.target.value)"
            @keydown.enter="handlers.submitComment()"
            placeholder="Write a comment..."
            class="flex-1 px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
          />
          <button @click="handlers.submitComment()" class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition">Post</button>
        </div>
      </div>
    </div>
  </div>

  <div :if="!activity" class="text-center py-32">
    <p class="text-gray-500 font-medium">Activity not found</p>
    <StxLink to="/feed" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Feed</StxLink>
  </div>
@endsection
