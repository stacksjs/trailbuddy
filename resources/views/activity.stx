@extends('layouts/default')

@section('title', 'Activity Details — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Activity Details — TrailBuddy' })

  const loading = state(true)
  const activity = state(null)
  const hasKudos = state(false)
  const newComment = state('')

  onMount(() => {
    const id = Number(route.params.id)
    const a = window.tb.findById('activities', id)
    activity.set(a)
    loading.set(false)
  })

  function toggleKudos() {
    if (!activity()) return
    const a = { ...activity() }
    if (hasKudos()) {
      a.kudos_count = (a.kudos_count || 1) - 1
      hasKudos.set(false)
    } else {
      a.kudos_count = (a.kudos_count || 0) + 1
      hasKudos.set(true)
    }
    activity.set(a)
    // persist to localStorage
    const all = window.tb.getList('activities')
    const idx = all.findIndex(x => x.id === a.id)
    if (idx >= 0) { all[idx] = a; window.tb.set('activities', all) }
  }

  function addComment() {
    const text = newComment().trim()
    if (!text || !activity()) return
    const a = { ...activity() }
    const user = window.tb.currentUser()
    a.comments = [...(a.comments || []), {
      user_id: user.id,
      userName: user.name,
      text,
      created_at: new Date().toISOString(),
    }]
    activity.set(a)
    newComment.set('')
    // persist
    const all = window.tb.getList('activities')
    const idx = all.findIndex(x => x.id === a.id)
    if (idx >= 0) { all[idx] = a; window.tb.set('activities', all) }
  }
</script>

  <!-- Loading -->
  <div @show="loading()" class="flex items-center justify-center py-32">
    <div class="animate-spin w-8 h-8 border-3 border-emerald-500 border-t-transparent rounded-full"></div>
  </div>

  <div @show="!loading() && activity()" class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <!-- Header -->
    <div class="card mb-6">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-lg font-bold" :text="(activity().userName || 'U').charAt(0)"></div>
          <div>
            <p class="font-bold dark:text-white" :text="activity().userName || 'Athlete'"></p>
            <p class="text-sm text-gray-500 dark:text-slate-400">
              <span :text="activity().activityType"></span>
              <span class="mx-1">·</span>
              <span :text="window.tb.timeAgo(activity().created_at)"></span>
            </p>
          </div>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/20 text-emerald-700 dark:text-emerald-400 font-medium" :text="activity().activityType"></span>
      </div>

      <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-2" :text="activity().title || 'Activity'"></h1>
      <StxLink @show="activity().trail_id" :to="'/trail/' + activity().trail_id" class="text-sm text-emerald-600 hover:underline flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        </svg>
        <span :text="activity().trail_name"></span>
      </StxLink>
    </div>

    <!-- Map -->
    <div class="card p-0 overflow-hidden mb-6">
      <div class="h-64 bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-slate-700 dark:to-slate-800 flex items-center justify-center">
        <div class="text-center text-gray-400 dark:text-slate-500">
          <svg class="w-12 h-12 mx-auto mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          <p class="text-sm font-medium">Route Map</p>
        </div>
      </div>
    </div>

    <!-- Stats grid -->
    <div class="grid grid-cols-3 sm:grid-cols-6 gap-4 mb-6">
      <div class="card text-center">
        <p class="text-xl font-bold text-emerald-600" :text="(activity().distance || 0).toFixed(1)"></p>
        <p class="metric-label">Miles</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white" :text="activity().duration || '0:00'"></p>
        <p class="metric-label">Duration</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold dark:text-white" :text="activity().pace || '--'"></p>
        <p class="metric-label">Pace</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-blue-600" :text="(activity().elevation_gain || 0).toLocaleString()"></p>
        <p class="metric-label">Elev (ft)</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-orange-600" :text="activity().calories || 0"></p>
        <p class="metric-label">Calories</p>
      </div>
      <div class="card text-center">
        <p class="text-xl font-bold text-red-500" :text="activity().heartRateAvg || '--'"></p>
        <p class="metric-label">Avg HR</p>
      </div>
    </div>

    <!-- Splits -->
    <div @show="activity().splits && activity().splits.length > 0" class="card mb-6">
      <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Splits</h2>
      <div class="space-y-2">
        <div class="grid grid-cols-3 text-xs text-gray-500 dark:text-slate-400 font-medium px-3 mb-1">
          <span>Mile</span>
          <span class="text-center">Pace</span>
          <span class="text-right">Elevation</span>
        </div>
        <template @for="split in (activity().splits || [])">
          <div class="grid grid-cols-3 items-center p-3 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700/50 transition">
            <span class="text-sm font-medium dark:text-white" :text="'Mile ' + split.mile"></span>
            <div class="text-center">
              <span class="text-sm font-semibold dark:text-white" :text="split.pace"></span>
              <span class="text-xs text-gray-400 dark:text-slate-500"> /mi</span>
            </div>
            <div class="text-right flex items-center justify-end gap-1">
              <svg class="w-3 h-3 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              <span class="text-sm text-gray-600 dark:text-slate-400" :text="split.elev + ' ft'"></span>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- Kudos & Actions -->
    <div class="card mb-6">
      <div class="flex items-center gap-6">
        <button @click="toggleKudos()" class="flex items-center gap-2 transition" :class="hasKudos() ? 'text-red-500' : 'text-gray-500 dark:text-slate-400 hover:text-red-500'">
          <svg class="w-6 h-6" :fill="hasKudos() ? 'currentColor' : 'none'" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="font-medium" :text="(activity().kudos_count || 0) + ' Kudos'"></span>
        </button>
        <span class="flex items-center gap-2 text-gray-500 dark:text-slate-400">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          <span class="font-medium" :text="(activity().comments || []).length + ' Comments'"></span>
        </span>
      </div>
    </div>

    <!-- Comments -->
    <div class="card">
      <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Comments</h2>
      <div class="space-y-4 mb-4">
        <template @for="comment in (activity().comments || [])">
          <div class="flex gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-xs font-bold text-gray-600 dark:text-slate-300 shrink-0" :text="(comment.userName || 'U').charAt(0)"></div>
            <div class="flex-1">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-sm font-semibold dark:text-white" :text="comment.userName"></span>
                <span class="text-xs text-gray-400 dark:text-slate-500" :text="window.tb.timeAgo(comment.created_at)"></span>
              </div>
              <p class="text-sm text-gray-600 dark:text-slate-400" :text="comment.text"></p>
            </div>
          </div>
        </template>
        <div @show="(activity().comments || []).length === 0" class="text-center py-4 text-gray-400 dark:text-slate-500 text-sm">
          <p>No comments yet. Be the first!</p>
        </div>
      </div>

      <!-- Comment input -->
      <div class="flex gap-3 pt-4 border-t border-gray-100 dark:border-slate-700">
        <div class="w-8 h-8 rounded-full bg-emerald-100 dark:bg-emerald-900/20 flex items-center justify-center text-emerald-600 text-xs font-bold shrink-0">Y</div>
        <div class="flex-1 flex gap-2">
          <input
            type="text"
            :value="newComment"
            @input="e => newComment.set(e.target.value)"
            @keydown.enter="addComment()"
            placeholder="Write a comment..."
            class="flex-1 px-3 py-2 border border-gray-200 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-700 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
          />
          <button @click="addComment()" class="px-4 py-2 bg-emerald-600 text-white text-sm font-medium rounded-lg hover:bg-emerald-700 transition">Post</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Not found -->
  <div @show="!loading() && !activity()" class="text-center py-32">
    <p class="text-gray-500 dark:text-slate-400 font-medium">Activity not found</p>
    <StxLink to="/feed" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Feed</StxLink>
  </div>
@endsection
