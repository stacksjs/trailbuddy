@extends('layouts/default')

@section('title', 'Territory Details — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Territory Details — TrailBuddy' })

  const tb = getStore<any>('tb')
  const territoryId = Number(
    (typeof window !== 'undefined' && (window as any).__routeParams?.id)
    ?? 1
  )

  const territory = derived(() => tb ? tb.findTerritory(territoryId) : null)
  const owner = derived(() => tb && territory ? tb.findUser(territory.user_id) : null)
  const history = derived(() => tb ? tb.territoryConquests(territoryId) : [])
  const isMine = derived(() => tb && territory ? territory.user_id === tb.currentUserId : false)

  onMount(() => {
    setTimeout(() => {
      if (typeof L === 'undefined' || !tb) return
      const poly = tb.territoryPolygons[territoryId]
      if (!poly) return
      const el = document.getElementById('territory-detail-map')
      if (!el) return
      const map = L.map('territory-detail-map', { scrollWheelZoom: false })
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 18 }).addTo(map)
      const polygon = L.polygon(poly, { color: '#059669', fillColor: '#34d399', fillOpacity: 0.3, weight: 3 }).addTo(map)
      map.fitBounds(polygon.getBounds(), { padding: [30, 30] })
    }, 100)
  })
</script>

  <div :if="territory">
    <section class="relative pt-24 pb-16 bg-gradient-to-br from-emerald-600 via-teal-600 to-emerald-700 overflow-hidden">
      <div class="relative mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div>
            <div class="flex gap-3 items-center mb-3">
              <span class="px-3 py-1 font-semibold text-sm rounded-full" :class="isMine ? 'bg-white/20 text-white' : 'bg-orange-500 text-white'" :text="isMine ? 'Your Territory' : 'Enemy Territory'"></span>
              <span class="px-3 py-1 font-semibold text-sm rounded-full" :class="territory.status === 'contested' ? 'bg-red-500 text-white' : 'bg-emerald-300/30 text-white'" :text="territory.status === 'contested' ? 'Contested' : 'Secure'"></span>
            </div>
            <h1 class="font-bold font-display text-3xl md:text-4xl text-white mb-2" :text="territory.name"></h1>
            <p class="text-lg text-white/70">Owned by <span class="font-semibold text-white" :text="isMine ? 'You' : (owner?.name || 'Unknown')"></span></p>
          </div>
          <StxLink to="/record" class="px-6 py-3 font-semibold text-sm rounded-xl transition" :class="isMine ? 'bg-white/20 text-white hover:bg-white/30' : 'bg-white text-orange-700 hover:bg-gray-100 shadow-lg'" :text="isMine ? 'Defend' : 'Conquer This'"></StxLink>
        </div>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <div class="card p-0 overflow-hidden">
            <div id="territory-detail-map" class="h-80"></div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            <div class="card text-center">
              <p class="text-2xl font-bold text-emerald-600" :text="(territory.areaSize / 1000).toFixed(1)"></p>
              <p class="metric-label">km²</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-blue-600" :text="territory.conquestCount"></p>
              <p class="metric-label">Times Conquered</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-orange-600" :text="territory.defendCount"></p>
              <p class="metric-label">Defenses</p>
            </div>
            <div class="card text-center">
              <p class="text-2xl font-bold text-purple-600" :text="territory.totalRunners"></p>
              <p class="metric-label">Runners</p>
            </div>
          </div>

          <div>
            <h2 class="font-bold text-xl dark:text-white mb-4">Conquest History</h2>
            <div class="space-y-3">
              <template :for="event in history">
                <div class="card flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold" :class="event.status === 'conquered' ? 'bg-orange-100 dark:bg-orange-900/20 text-orange-600' : 'bg-emerald-100 dark:bg-emerald-900/20 text-emerald-600'" :text="event.attackerName.charAt(0)"></div>
                  <div class="flex-1">
                    <p class="text-sm font-semibold dark:text-white">
                      <span :text="event.attackerName"></span>
                      <span :text="event.status === 'conquered' ? ' conquered this' : ' failed to conquer'"></span>
                    </p>
                    <p class="text-xs text-gray-500" :text="tb.timeAgo(event.created_at)"></p>
                  </div>
                  <span class="text-xs px-2 py-1 rounded-full font-medium" :class="event.status === 'conquered' ? 'bg-orange-100 text-orange-700' : 'bg-emerald-100 text-emerald-700'" :text="event.status === 'conquered' ? 'Conquered' : 'Defended'"></span>
                </div>
              </template>
              <div :if="history.length === 0" class="text-center py-8 text-gray-400 text-sm">
                <p>No conquest attempts yet.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">Current Owner</h3>
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 text-xl font-bold" :text="(owner?.name || 'U').charAt(0)"></div>
              <div>
                <p class="font-bold dark:text-white" :text="isMine ? 'You' : (owner?.name || 'Unknown')"></p>
                <p class="text-sm text-gray-500" :text="'Claimed ' + tb.timeAgo(territory.claimedAt)"></p>
              </div>
            </div>
          </div>

          <div class="card">
            <h3 class="font-bold text-lg dark:text-white mb-4">How to Conquer</h3>
            <div class="space-y-3 text-sm">
              <div class="flex gap-2"><span class="font-bold text-orange-600">1.</span><span class="dark:text-slate-300">Run through the territory boundary</span></div>
              <div class="flex gap-2"><span class="font-bold text-orange-600">2.</span><span class="dark:text-slate-300">Close your loop</span></div>
              <div class="flex gap-2"><span class="font-bold text-orange-600">3.</span><span class="dark:text-slate-300">The carved area becomes yours</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div :if="!territory" class="text-center py-32">
    <p class="text-gray-500 font-medium">Territory not found</p>
    <StxLink to="/territories" class="inline-block mt-4 px-6 py-2 bg-emerald-600 text-white text-sm font-semibold rounded-lg hover:bg-emerald-700 transition">Back to Territories</StxLink>
  </div>
@endsection
