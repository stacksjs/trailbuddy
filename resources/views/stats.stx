@extends('layouts/default')

@section('title', 'Training Stats — TrailBuddy')

@section('content')
<script client>
  useHead({ title: 'Training Stats — TrailBuddy' })

  const loading = state(true)
  const userStats = state(null)
  const activities = state([])
  const period = state('weekly')

  onMount(() => {
    const stats = window.tb.get('user_stats')
    userStats.set(stats)
    activities.set(window.tb.getList('activities').filter(a => a.user_id === 1))
    loading.set(false)
  })

  const maxDistance = () => {
    const hist = userStats()?.weeklyHistory || []
    return Math.max(...hist.map(w => w.distance), 1)
  }
</script>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold dark:text-white">Training Stats</h1>
        <p class="text-sm text-gray-500 dark:text-slate-400 mt-1">Your performance at a glance</p>
      </div>
      <div class="flex gap-2">
        <button @click="period.set('weekly')" :class="period() === 'weekly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">Weekly</button>
        <button @click="period.set('monthly')" :class="period() === 'monthly' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">Monthly</button>
        <button @click="period.set('alltime')" :class="period() === 'alltime' ? 'bg-emerald-600 text-white' : 'bg-gray-100 dark:bg-slate-800 text-gray-600 dark:text-slate-400'" class="px-4 py-2 rounded-lg text-sm font-medium transition">All Time</button>
      </div>
    </div>

    <!-- Loading -->
    <div @show="loading()" class="flex items-center justify-center py-20">
      <div class="animate-spin w-8 h-8 border-3 border-emerald-500 border-t-transparent rounded-full"></div>
    </div>

    <div @show="!loading() && userStats()">
      <!-- Summary cards -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
        <div class="card text-center">
          <p class="text-3xl font-bold text-emerald-600" :text="period() === 'weekly' ? userStats().weeklyDistance : period() === 'monthly' ? userStats().monthlyDistance : userStats().totalDistance"></p>
          <p class="metric-label">Miles</p>
          <p class="text-xs text-emerald-500 mt-1" :text="period() === 'weekly' ? '+2.4 from last week' : period() === 'monthly' ? '+8.1 from last month' : 'total'"></p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-blue-600" :text="(period() === 'weekly' ? userStats().weeklyElevation : period() === 'monthly' ? userStats().monthlyElevation : userStats().totalElevation).toLocaleString()"></p>
          <p class="metric-label">Elev (ft)</p>
          <p class="text-xs text-blue-500 mt-1" :text="period() === 'weekly' ? '+320 from last week' : period() === 'monthly' ? '+1,200 from last month' : 'total'"></p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-orange-600" :text="period() === 'weekly' ? userStats().weeklyActivities : period() === 'monthly' ? Math.round(userStats().weeklyActivities * 4.2) : userStats().totalActivities"></p>
          <p class="metric-label">Activities</p>
        </div>
        <div class="card text-center">
          <p class="text-3xl font-bold text-purple-600" :text="userStats().currentStreak"></p>
          <p class="metric-label">Day Streak</p>
          <p class="text-xs text-purple-500 mt-1" :text="'Best: ' + userStats().longestStreak + ' days'"></p>
        </div>
      </div>

      <!-- Weekly distance chart (CSS bar chart) -->
      <div class="card mb-8">
        <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-6">Weekly Distance</h2>
        <div class="flex items-end gap-3 h-40">
          <template @for="(week, i) in (userStats().weeklyHistory || [])">
            <div class="flex-1 flex flex-col items-center gap-2">
              <span class="text-xs font-semibold dark:text-white" :text="week.distance.toFixed(1)"></span>
              <div
                class="w-full rounded-t-lg transition-all duration-500"
                :class="i === (userStats().weeklyHistory || []).length - 1 ? 'bg-emerald-500' : 'bg-emerald-200 dark:bg-emerald-800'"
                :style="'height: ' + (week.distance / maxDistance() * 100) + '%'"
              ></div>
              <span class="text-xs text-gray-500 dark:text-slate-400 whitespace-nowrap" :text="week.week.split(' ')[1]"></span>
            </div>
          </template>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 mb-8">
        <!-- Personal Records -->
        <div class="card">
          <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
            Personal Records
          </h2>
          <div class="space-y-3">
            <div class="flex items-center justify-between p-3 bg-yellow-50 dark:bg-yellow-900/10 rounded-xl">
              <div class="flex items-center gap-3">
                <span class="text-lg">⚡</span>
                <span class="text-sm text-gray-600 dark:text-slate-400">Fastest Mile</span>
              </div>
              <span class="font-bold text-gray-900 dark:text-white" :text="userStats().personalRecords.fastestMile + ' /mi'"></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-emerald-50 dark:bg-emerald-900/10 rounded-xl">
              <div class="flex items-center gap-3">
                <span class="text-lg">🏃</span>
                <span class="text-sm text-gray-600 dark:text-slate-400">Longest Run</span>
              </div>
              <span class="font-bold text-gray-900 dark:text-white" :text="userStats().personalRecords.longestRun + ' mi'"></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-blue-50 dark:bg-blue-900/10 rounded-xl">
              <div class="flex items-center gap-3">
                <span class="text-lg">⛰️</span>
                <span class="text-sm text-gray-600 dark:text-slate-400">Biggest Climb</span>
              </div>
              <span class="font-bold text-gray-900 dark:text-white" :text="userStats().personalRecords.biggestClimb.toLocaleString() + ' ft'"></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-orange-50 dark:bg-orange-900/10 rounded-xl">
              <div class="flex items-center gap-3">
                <span class="text-lg">🔥</span>
                <span class="text-sm text-gray-600 dark:text-slate-400">Longest Streak</span>
              </div>
              <span class="font-bold text-gray-900 dark:text-white" :text="userStats().personalRecords.longestStreak + ' days'"></span>
            </div>
          </div>
        </div>

        <!-- Activity Breakdown -->
        <div class="card">
          <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            Activity Breakdown
          </h2>
          <div class="space-y-4">
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Trail Runs</span>
                <span class="text-sm font-medium dark:text-white" :text="activities().filter(a => a.activityType === 'Trail Run').length + ' activities'"></span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-emerald-500 rounded-full" :style="'width: ' + (activities().filter(a => a.activityType === 'Trail Run').length / Math.max(activities().length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Hikes</span>
                <span class="text-sm font-medium dark:text-white" :text="activities().filter(a => a.activityType === 'Hike').length + ' activities'"></span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-blue-500 rounded-full" :style="'width: ' + (activities().filter(a => a.activityType === 'Hike').length / Math.max(activities().length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Walks</span>
                <span class="text-sm font-medium dark:text-white" :text="activities().filter(a => a.activityType === 'Walk').length + ' activities'"></span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-purple-500 rounded-full" :style="'width: ' + (activities().filter(a => a.activityType === 'Walk').length / Math.max(activities().length, 1) * 100) + '%'"></div>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm text-gray-600 dark:text-slate-400">Bike Rides</span>
                <span class="text-sm font-medium dark:text-white" :text="activities().filter(a => a.activityType === 'Bike').length + ' activities'"></span>
              </div>
              <div class="h-2 bg-gray-200 dark:bg-slate-700 rounded-full overflow-hidden">
                <div class="h-full bg-orange-500 rounded-full" :style="'width: ' + (activities().filter(a => a.activityType === 'Bike').length / Math.max(activities().length, 1) * 100) + '%'"></div>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 dark:border-slate-700">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500 dark:text-slate-400">Total Time</span>
              <span class="font-bold dark:text-white" :text="userStats().totalTime"></span>
            </div>
            <div class="flex items-center justify-between text-sm mt-2">
              <span class="text-gray-500 dark:text-slate-400">Avg Pace</span>
              <span class="font-bold dark:text-white" :text="userStats().avgPace"></span>
            </div>
            <div class="flex items-center justify-between text-sm mt-2">
              <span class="text-gray-500 dark:text-slate-400">Total Calories</span>
              <span class="font-bold dark:text-white" :text="userStats().totalCalories.toLocaleString()"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Activities -->
      <div class="card">
        <h2 class="font-bold text-lg text-gray-900 dark:text-white mb-4">Recent Activities</h2>
        <div class="space-y-3">
          <template @for="activity in activities().slice(0, 5)">
            <StxLink :to="'/activity/' + activity.id" class="flex items-center gap-4 p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-700/50 transition block">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0" :class="activity.activityType === 'Trail Run' ? 'bg-emerald-100 dark:bg-emerald-900/20' : activity.activityType === 'Hike' ? 'bg-blue-100 dark:bg-blue-900/20' : activity.activityType === 'Walk' ? 'bg-purple-100 dark:bg-purple-900/20' : 'bg-orange-100 dark:bg-orange-900/20'">
                <svg class="w-5 h-5" :class="activity.activityType === 'Trail Run' ? 'text-emerald-600' : activity.activityType === 'Hike' ? 'text-blue-600' : activity.activityType === 'Walk' ? 'text-purple-600' : 'text-orange-600'" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-semibold text-sm dark:text-white truncate" :text="activity.title"></p>
                <p class="text-xs text-gray-500 dark:text-slate-400" :text="activity.activityType + ' · ' + window.tb.timeAgo(activity.created_at)"></p>
              </div>
              <div class="flex gap-4 text-right shrink-0">
                <div>
                  <p class="text-sm font-bold text-emerald-600" :text="activity.distance.toFixed(1) + ' mi'"></p>
                </div>
                <div>
                  <p class="text-sm font-bold dark:text-white" :text="activity.duration"></p>
                </div>
              </div>
            </StxLink>
          </template>
        </div>
      </div>
    </div>
  </div>
@endsection
