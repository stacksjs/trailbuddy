<script server>
import { defineProps, withDefaults } from 'stx'

interface SearchFilterProps {
  activeFilter?: string
}

const { activeFilter } = withDefaults(defineProps<SearchFilterProps>(), {
  activeFilter: 'all'
})

const filters = [
  { id: 'all', label: 'All Trails' },
  { id: 'easy', label: 'Easy' },
  { id: 'moderate', label: 'Moderate' },
  { id: 'hard', label: 'Hard' },
  { id: 'dog-friendly', label: 'Dog Friendly' }
]
</script>

<script>
import { state } from 'stx'

// Local state for current filter
const currentFilter = state('all')

// Handle filter change
function selectFilter(filterId) {
  currentFilter.set(filterId)
  // Dispatch custom event for parent to handle
  window.dispatchEvent(new CustomEvent('filter-change', { detail: { filter: filterId } }))
}
</script>

<template>
  <section class="relative -mt-8 z-20 px-4 mx-auto max-w-5xl sm:px-6 lg:px-8">
    <div class="bg-white rounded-2xl shadow-xl p-6">
      <div class="flex flex-col md:flex-row gap-4">
        <!-- Search input -->
        <div class="flex-1 relative">
          <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" placeholder="Search trails, parks, or cities..." class="w-full pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        </div>
        <!-- Location -->
        <div class="relative">
          <svg class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <input type="text" placeholder="Near me" class="w-full md:w-48 pl-12 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-transparent" />
        </div>
        <!-- Search button -->
        <button class="px-8 py-3 bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition shadow-lg hover:shadow-xl">
          Search
        </button>
      </div>

      <!-- Quick filters - SSR the buttons, client handles active state -->
      <div class="mt-4 flex flex-wrap gap-2">
        @foreach(filters as filter)
          <button
            @click="selectFilter('{{ filter.id }}')"
            :class="currentFilter() === '{{ filter.id }}' ? 'bg-emerald-600 text-white border-emerald-600' : 'text-gray-600 border-gray-200 hover:border-emerald-500 hover:text-emerald-600'"
            class="px-4 py-2 text-sm font-medium rounded-full border transition"
          >
            {{ filter.label }}
          </button>
        @endforeach
      </div>
    </div>
  </section>
</template>
