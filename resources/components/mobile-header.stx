<script client>
import { haptics } from '~/storage/framework/core/mobile/dist/index.js'

function tap(): void {
  void haptics.selection()
}
</script>

<header class="native-app-sticky-top sticky z-40 flex h-13 items-center justify-between border-b border-slate-200/70 bg-white/90 px-4 backdrop-blur-xl md:hidden dark:border-slate-700/70 dark:bg-slate-950/90">
  <StxLink to="/feed" class="flex items-center gap-2" aria-label="WildLoop feed" @click="tap()">
    <span class="relative inline-block h-5 w-5 shrink-0 rounded-full border-2 border-emerald-500" aria-hidden="true">
      <span class="absolute -top-0.5 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-emerald-400"></span>
    </span>
    <span class="font-display text-sm font-bold tracking-[0.12em] text-slate-950 dark:text-white">WILDLOOP</span>
  </StxLink>

  <div class="flex items-center gap-1">
    <StxLink to="/notifications" aria-label="Notifications" class="relative grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()">
      <i class="i-lucide-bell h-5 w-5" aria-hidden="true"></i>
      <span class="absolute right-2.5 top-2.5 h-2 w-2 rounded-full border-2 border-white bg-emerald-500 dark:border-slate-950"></span>
    </StxLink>
    <StxLink to="/settings" aria-label="Settings" class="grid h-11 w-11 place-items-center rounded-full text-slate-600 transition active:scale-95 dark:text-slate-300" @click="tap()">
      <i class="i-lucide-settings-2 h-5 w-5" aria-hidden="true"></i>
    </StxLink>
  </div>
</header>
