<script server>
import { defineProps } from 'stx'

/**
 * A form or page message: an error, a warning, a confirmation.
 *
 * This exists because every page that needed to say something to the user was
 * hand-rolling the same coloured div with a slightly different border radius
 * and no accessibility semantics at all. A screen reader announced none of
 * them, so a failed sign-in was silent for anyone not looking at that part of
 * the page.
 *
 * `role` and `aria-live` are the load-bearing part. An error is `role="alert"`
 * (assertive: interrupt, the person just pressed a button and needs to know it
 * failed), everything else is `role="status"` (polite: announce at the next
 * pause).
 */

type Tone = 'error' | 'success' | 'warning' | 'info'

interface AlertProps {
  tone?: Tone
  /** Icon override. Defaults per tone. */
  icon?: string
}

const { tone = 'info', icon } = defineProps<AlertProps>()

const TONES: Record<Tone, { classes: string, icon: string, assertive: boolean }> = {
  error: {
    classes: 'text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950/40 border-red-200 dark:border-red-900',
    icon: 'i-hugeicons-alert-circle',
    assertive: true,
  },
  success: {
    classes: 'text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/40 border-emerald-200 dark:border-emerald-900',
    icon: 'i-hugeicons-checkmark-circle-02',
    assertive: false,
  },
  warning: {
    classes: 'text-amber-800 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-900',
    icon: 'i-hugeicons-alert-02',
    assertive: false,
  },
  info: {
    classes: 'text-slate-700 dark:text-slate-300 bg-slate-50 dark:bg-slate-800/60 border-slate-200 dark:border-slate-700',
    icon: 'i-hugeicons-information-circle',
    assertive: false,
  },
}

const resolved = TONES[tone] ?? TONES.info
const glyph = icon || resolved.icon
</script>

<template>
  <div
    class="flex gap-3 items-start mb-6 p-4 text-sm border rounded-xl {{ resolved.classes }}"
    role="{{ resolved.assertive ? 'alert' : 'status' }}"
    aria-live="{{ resolved.assertive ? 'assertive' : 'polite' }}"
  >
    <i class="{{ glyph }} h-5 w-5 shrink-0 mt-px" aria-hidden="true"></i>
    <div class="min-w-0">
      <slot />
    </div>
  </div>
</template>
