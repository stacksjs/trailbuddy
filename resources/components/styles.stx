<style>
  /* ts-maps */
  .ts-map-container,
  .trail-map-panel {
    z-index: 1;
    font-family: inherit;
    width: 100%;
    min-height: 280px;
  }
  .trail-map-panel { height: 420px; }
  .trail-map-panel-lg { height: min(55vh, 520px); }
  .ts-map-container .map-attribution,
  .ts-map-container [class*='attribution'] {
    font-size: 9px !important;
  }
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 14px;
  }

  .font-display {
    font-family: 'Outfit', system-ui, sans-serif;
  }

  .nav-active {
    color: #059669 !important;
    font-weight: 600;
  }

  .gradient-text {
    background: linear-gradient(135deg, #059669, #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gradient-bg {
    background: linear-gradient(135deg, #065f46, #059669, #34d399);
  }

  /* Trail card hover */
  .trail-card { transition: all 0.3s ease; }
  .trail-card:hover { transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,0.12); }
  .trail-card:hover .trail-image { transform: scale(1.05); }
  .trail-image { transition: transform 0.5s ease; }

  /* Map preview */
  .map-preview {
    background: linear-gradient(135deg, #e0f2fe 0%, #bae6fd 100%);
    position: relative;
    overflow: hidden;
  }

  html.dark {
    background: #0f172a;
    color-scheme: dark;
  }

  .game-dashboard-card {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(52, 211, 153, 0.25);
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
  }

  .capture-bar {
    height: 8px;
    background: #e2e8f0;
    border-radius: 9999px;
    overflow: hidden;
  }

  .dark .capture-bar {
    background: #334155;
  }

  .capture-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #a855f7, #059669);
    border-radius: 9999px;
    transition: width 0.25s ease;
  }

  .capture-toast {
    animation: capture-pop 0.35s ease;
  }

  @keyframes capture-pop {
    0% { transform: translate(-50%, -8px) scale(0.9); opacity: 0; }
    100% { transform: translate(-50%, 0) scale(1); opacity: 1; }
  }

  .strava-stat {
    text-align: center;
    padding: 0.5rem;
    border-radius: 0.5rem;
    background: #f8fafc;
  }

  .dark .strava-stat {
    background: #0f172a;
  }

  .record-btn-start {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5rem;
    width: 5rem;
    font-size: 1.5rem;
    color: white;
    background: #059669;
    border-radius: 9999px;
    box-shadow: 0 10px 25px rgba(5, 150, 105, 0.35);
    transition: background 0.2s;
  }

  .record-btn-start:hover { background: #047857; }

  .record-btn-pause, .record-btn-resume {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 5rem;
    width: 5rem;
    font-size: 1.5rem;
    color: white;
    border-radius: 9999px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    transition: background 0.2s;
  }

  .record-btn-pause { background: #059669; }
  .record-btn-pause:hover { background: #047857; }
  .record-btn-resume { background: #eab308; }
  .record-btn-resume:hover { background: #ca8a04; }

  .record-btn-stop {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4rem;
    width: 4rem;
    font-size: 1.25rem;
    color: white;
    background: #ef4444;
    border-radius: 9999px;
    box-shadow: 0 8px 20px rgba(239, 68, 68, 0.35);
    transition: background 0.2s;
  }

  .record-btn-stop:hover { background: #dc2626; }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 3px; }
</style>
