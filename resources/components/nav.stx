        <button @click="dark.toggle()" class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">
          <Icon name="moon" size="18" class="dark:hidden" />
          <Icon name="sun" size="18" class="hidden dark:inline" />
        </button>
        <div class="flex gap-1 items-center pl-2 border-l border-slate-200 dark:border-slate-700">
          <StxLink to="/notifications" class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors relative">
