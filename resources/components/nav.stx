<script client>
  import { initializeAuthSession, token } from '../assets/scripts/auth'

  const mobileOpen = state(false)

  // Signed-in state is the presence of the bearer token the browser auth
  // client stores. The typeof guard keeps this safe during server rendering,
  // where the signed-out nav is also the right first paint for a visitor who
  // has never signed in.
  //
  // Declared on one line without braces on purpose: stx only exposes
  // declarations it finds at the top level of the script, so wrapping this in
  // an `if { … }` block keeps `signedIn` out of the component scope and every
  // `:if` that reads it silently drops its element.
  if (typeof signedIn === 'undefined') var signedIn = state(!!token())

  // The avatar showed a hardcoded "Y" (from the seeded demo athlete, "You"),
  // so every signed-in person saw someone else's initial. Read it from the
  // account established at sign-in, and fall back to a neutral glyph rather
  // than a letter that belongs to nobody.
  //
  // Same one-line, brace-free shape as above: stx only exposes declarations it
  // finds at the top level of the script.
  if (typeof accountInitial === 'undefined') var accountInitial = state('\u00B7')

  // Offer the Admin link only to an admin. This is presentation only: the
  // dashboard and its endpoint both re-check the role server-side, so a
  // visitor who edits this flag in devtools gains a link that refuses them.
  if (typeof isAdmin === 'undefined') var isAdmin = state(false)

  onMount(() => {
    void initializeAuthSession().then(() => signedIn.set(!!token()))
    const raw = typeof localStorage !== 'undefined' ? localStorage.getItem('auth_user') : null
    if (!raw) return
    try {
      const account = JSON.parse(raw)
      const source = (account?.name || account?.email || '').trim()
      if (source) accountInitial.set(source.charAt(0).toUpperCase())
      if (Array.isArray(account?.roles) && account.roles.includes('admin')) isAdmin.set(true)
    } catch {}
  })
</script>

<nav class="sticky top-0 z-50 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div class="flex items-center justify-between h-14">

      <div class="flex gap-6 items-center">
        <StxLink to="/" class="flex gap-2 items-center" aria-label="WildLoop home">
          <!-- Brand mark: a closed ring with the runner's position on it.
               Pure CSS on purpose, so the wordmark never depends on icon
               resolution the way the rest of the UI's glyphs do. -->
          <span class="relative inline-block h-5 w-5 shrink-0 rounded-full border-2 border-emerald-500" aria-hidden="true">
            <span class="absolute -top-0.5 left-1/2 h-1.5 w-1.5 -translate-x-1/2 rounded-full bg-emerald-400"></span>
          </span>
          <span class="font-bold text-sm tracking-wide">WILDLOOP</span>
        </StxLink>

        <div class="hidden md:flex gap-1 items-center">
          <StxLink to="/trails" activeClass="nav-active" class="px-3 py-2 font-medium text-slate-500 text-sm dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">Trails</StxLink>
          <StxLink to="/feed" activeClass="nav-active" class="px-3 py-2 font-medium text-slate-500 text-sm dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">Feed</StxLink>
          <StxLink to="/territories" activeClass="nav-active" class="px-3 py-2 font-medium text-slate-500 text-sm dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">Territory</StxLink>
          <StxLink to="/leaderboard" activeClass="nav-active" class="px-3 py-2 font-medium text-slate-500 text-sm dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">Leaderboard</StxLink>
          <StxLink to="/clubs" activeClass="nav-active" class="px-3 py-2 font-medium text-slate-500 text-sm dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded transition-colors">Clubs</StxLink>
        </div>
      </div>

      <div class="hidden md:flex gap-2 items-center">
        <button @click="useDark().toggle()" aria-label="Toggle dark mode" class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors">
          <Icon name="moon" size="18" class="dark:hidden" />
          <Icon name="sun" size="18" class="hidden dark:inline" />
        </button>

        <!-- Signed out: the job is to get someone in, not to ask them to record
             an activity they have not started. -->
        <div :if="!signedIn()" class="flex gap-2 items-center">
          <StxLink to="/login" class="px-3 py-2 font-medium text-sm text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors">Log in</StxLink>
          <StxLink to="/register" class="px-4 py-2 font-semibold text-sm text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition-colors active:scale-[0.98]">Sign up</StxLink>
        </div>

        <!-- Signed in: recording is a real intent now, but it stays secondary
             to the account, which is what people reach for most often. -->
        <div :if="signedIn()" class="flex gap-2 items-center">
          <StxLink :if="isAdmin()" to="/admin" class="px-3 py-2 font-medium text-sm text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors">Admin</StxLink>
          <StxLink to="/record" class="px-3.5 py-2 font-medium text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-full transition-colors active:scale-[0.98]">Record</StxLink>
          <StxLink to="/notifications" aria-label="Alerts" class="relative p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors">
            <Icon name="bell" size="20" />
            <span class="absolute top-1 right-1 h-2 w-2 bg-emerald-500 rounded-full"></span>
          </StxLink>
          <StxLink to="/settings" aria-label="Settings" class="p-2 text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white rounded-lg transition-colors">
            <i class="i-hugeicons-settings-02 h-5 w-5" aria-hidden="true"></i>
          </StxLink>
          <StxLink to="/profile" class="flex items-center gap-2 pl-1 pr-3 py-1 font-medium text-sm text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 rounded-full transition-colors">
            <span class="flex items-center justify-center h-6 w-6 rounded-full bg-emerald-600 text-white text-xs font-bold" aria-hidden="true">{{ accountInitial }}</span>
            Account
          </StxLink>
        </div>
      </div>

      <button class="md:hidden p-2 text-slate-500 dark:text-slate-400" @click="mobileOpen.set(!mobileOpen())">
        <Icon :show="!mobileOpen()" name="menu" size="24" />
        <Icon :show="mobileOpen()" name="x" size="24" />
      </button>
    </div>

    <div :show="mobileOpen()" x-cloak class="md:hidden pb-4 space-y-1">
      <StxLink to="/trails" class="block px-3 py-2 text-slate-500 text-sm dark:text-slate-400 rounded">Trails</StxLink>
      <StxLink to="/feed" class="block px-3 py-2 text-slate-500 text-sm dark:text-slate-400 rounded">Feed</StxLink>
      <StxLink to="/territories" class="block px-3 py-2 text-slate-500 text-sm dark:text-slate-400 rounded">Territory</StxLink>
      <StxLink to="/leaderboard" class="block px-3 py-2 text-slate-500 text-sm dark:text-slate-400 rounded">Leaderboard</StxLink>
      <StxLink to="/clubs" class="block px-3 py-2 text-slate-500 text-sm dark:text-slate-400 rounded">Clubs</StxLink>
      <div :if="!signedIn()" class="pt-2 space-y-1">
        <StxLink to="/login" class="block px-3 py-2 text-slate-600 text-sm dark:text-slate-400 rounded">Log in</StxLink>
        <StxLink to="/register" class="block mt-1 px-4 py-2.5 text-center font-semibold text-sm text-white bg-emerald-600 rounded-full">Sign up</StxLink>
      </div>

      <div :if="signedIn()" class="pt-2 space-y-1">
        <StxLink to="/record" class="block px-3 py-2 font-medium text-emerald-700 dark:text-emerald-400 text-sm rounded">Record an activity</StxLink>
        <StxLink to="/stats" class="block px-3 py-2 text-slate-600 text-sm dark:text-slate-400 rounded">Stats</StxLink>
        <StxLink to="/notifications" class="block px-3 py-2 text-slate-600 text-sm dark:text-slate-400 rounded">Alerts</StxLink>
        <StxLink to="/profile" class="block px-3 py-2 text-slate-600 text-sm dark:text-slate-400 rounded">Account</StxLink>
      </div>
    </div>
  </div>
</nav>
