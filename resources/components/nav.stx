<script client>
  if (typeof navLinks === 'undefined') var navLinks = state([
    { to: '/feed', label: 'Feed' },
    { to: '/trails', label: 'Trails' },
    { to: '/territories', label: 'Turf' },
    { to: '/battles', label: 'Battles' },
    { to: '/leaderboard', label: 'Rank' },
    { to: '/athletes', label: 'Athletes' },
  ])
  const mobileOpen = state(false)
</script>

