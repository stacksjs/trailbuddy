@include('styles')
@include('theme')
<link rel="stylesheet" href="/css/ts-maps.css" data-ts-maps-css>
@include('stores')

<script client>
  import { useTrailCatalog } from '../composables/useTrailCatalog'
  import { useTerritoryCatalog } from '../composables/useTerritoryCatalog'
  import { useActivityCatalog } from '../composables/useActivityCatalog'
  import { useFollows } from '../composables/useFollows'
  import { ensureSession } from '../assets/scripts/game-api'
  const tb = useStore('tb')
  useTrailCatalog(tb)
  useTerritoryCatalog(tb)
  useActivityCatalog(tb)
  useFollows(tb)
  // Establish the demo athlete's session early so authenticated writes
  // (record/kudos/comment/claim) are instant. Idempotent + non-blocking.
  ensureSession()
</script>

@include('nav')

<main class="flex-1">
  @slot('content')
</main>

@include('footer')
