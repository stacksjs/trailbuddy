<script server>
definePageMeta({
  middleware: ['auth']
})

import { useOrders } from '../../../../functions/commerce/orders'
import OrdersTable from '../../../../components/Dashboard/Commerce/OrdersTable.stx'
import Pagination from '../../../../components/Dashboard/Commerce/Delivery/Pagination.stx'
import SearchFilter from '../../../../components/Dashboard/Commerce/Delivery/SearchFilter.stx'

// Get orders data and functions from the composable
const { orders, createOrder, fetchOrders, deleteOrder } = useOrders()

// Available statuses
const statuses = ['all', 'Completed', 'Processing', 'Shipped', 'Cancelled', 'Refunded'] as const
let statusFilter = 'all'
let sortBy = 'date'
let sortOrder = 'desc'

// Search and filtering
let searchQuery = ''
let currentPage = 1
let itemsPerPage = 5

// Computed filtered orders
function filteredOrders() {
  return orders
    .filter(order => {
      // Apply search filter
      const matchesSearch =
        order.id.toString().toLowerCase().includes(searchQuery.toLowerCase()) ||
        order.customer_id.toString().toLowerCase().includes(searchQuery.toLowerCase()) ||
        order.order_type.toLowerCase().includes(searchQuery.toLowerCase())

      // Apply status filter
      const matchesStatus = statusFilter === 'all' || order.status === statusFilter

      return matchesSearch && matchesStatus
    })
    .sort((a, b) => {
      // Apply sorting
      let comparison = 0
      if (sortBy === 'total_amount') {
        comparison = a.total_amount - b.total_amount
      } else if (sortBy === 'customer_id') {
        comparison = a.customer_id - b.customer_id
      }

      return sortOrder === 'asc' ? comparison : -comparison
    })
}

function paginatedOrders() {
  const start = (currentPage - 1) * itemsPerPage
  const end = start + itemsPerPage
  return filteredOrders().slice(start, end)
}

// Event handlers
const handleSearch = (query: string) => {
  searchQuery = query
  currentPage = 1
}

const handlePrevPage = () => {
  if (currentPage > 1) {
    currentPage--
  }
}

const handleNextPage = () => {
  const totalPages = Math.ceil(filteredOrders().length / itemsPerPage)
  if (currentPage < totalPages) {
    currentPage++
  }
}

const handlePageChange = (page: number) => {
  currentPage = page
}

// Toggle sort order
function toggleSort(column: string): void {
  if (sortBy === column) {
    sortOrder = sortOrder === 'asc' ? 'desc' : 'asc'
  } else {
    sortBy = column
    sortOrder = 'desc'
  }
}

// Order actions
function viewOrder(order: any): void {
  window.location.href = `/dashboard/commerce/orders/${order.id}`
}

function editOrder(order: any): void {
  window.location.href = `/dashboard/commerce/orders/${order.id}?edit=true`
}

function removeOrder(order: any): void {
  orderToDelete = order
  showDeleteModal = true
}

// Define new order type
interface NewOrder {
  customer_id: number
  total_amount: number
  status: string
  order_type: string
}

// Modal state
let showAddModal = false
let showDeleteModal = false
let orderToDelete = null
let newOrder = {
  customer_id: 1,
  total_amount: 0,
  status: 'Processing',
  order_type: 'delivery'
}

function openAddModal(): void {
  newOrder = {
    customer_id: 1,
    total_amount: 0,
    status: 'Processing',
    order_type: 'delivery'
  }
  showAddModal = true
}

function closeAddModal(): void {
  showAddModal = false
}

function closeDeleteModal(): void {
  showDeleteModal = false
  orderToDelete = null
}

async function confirmDelete(): Promise<void> {
  if (!orderToDelete) return

  const orderId = orderToDelete.id

  // Remove from local state for immediate UI update
  orders = orders.filter(o => o.id !== orderId)

  try {
    // Use the composable's deleteOrder function
    const success = await deleteOrder(orderId)
    if (success) {
      closeDeleteModal()
    } else {
      // If server request fails, restore to local state
      orders.push(orderToDelete)
      console.error('Failed to delete order')
    }
  } catch (error) {
    // If server request fails, restore to local state
    orders.push(orderToDelete)
    console.error('Failed to delete order:', error)
  }
}

async function addOrder(): Promise<void> {
  // First add to local state for immediate UI update
  const id = Math.max(...orders.map(o => o.id || 0)) + 1
  const newOrderData = {
    id,
    customer_id: newOrder.customer_id,
    coupon_id: 0,
    status: newOrder.status,
    total_amount: newOrder.total_amount,
    order_type: newOrder.order_type
  }
  orders.unshift(newOrderData)

  try {
    // Use the composable's createOrder function
    const createdOrder = await createOrder(newOrderData)
    if (createdOrder) {
      closeAddModal()
    } else {
      // If server request fails, remove from local state
      orders = orders.filter(o => o.id !== id)
      console.error('Failed to create order')
    }
  } catch (error) {
    // If server request fails, remove from local state
    orders = orders.filter(o => o.id !== id)
    console.error('Failed to create order:', error)
  }
}
</script>

@title('Dashboard - Commerce Orders')
<div class="py-6">
  <div class="mx-auto px-4 sm:px-6 md:px-8 max-w-7xl">
    <div class="overflow-hidden mt-6 bg-white dark:bg-gray-800 rounded-lg shadow">
      <div class="px-4 py-5 sm:px-6 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between">
          <h2 class="font-medium text-gray-900 text-lg dark:text-white">Orders</h2>
          <button
            @click="openAddModal"
            type="button"
            class="inline-flex items-center px-3 py-2 font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm"
          >
            <div class="mr-2 h-5 w-5 i-hugeicons-plus-sign" />
            Add Order
          </button>
        </div>
        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between mt-4">
          <SearchFilter
            placeholder="Search orders..."
            @search="handleSearch"
            class="w-full md:w-96"
          />
          <div class="flex flex-col gap-4 sm:flex-row">
            <select
              v-model="statusFilter"
              class="block pl-3 pr-10 py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-blue-gray-800 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-700 focus:ring-2 focus:ring-blue-600 focus:ring-inset"
            >
              @foreach(statuses as status)
                <option :value="status">{{ status }}</option>
              @endforeach
            </select>

            <select
              v-model="itemsPerPage"
              class="block pl-3 pr-10 py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-blue-gray-800 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-700 focus:ring-2 focus:ring-blue-600 focus:ring-inset"
            >
              <option :value="5">5 per page</option>
              <option :value="10">10 per page</option>
              <option :value="25">25 per page</option>
              <option :value="50">50 per page</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Orders Table Component -->
      <OrdersTable
        :orders="paginatedOrders"
        :search-query="searchQuery"
        :status-filter="statusFilter"
        :sort-by="sortBy"
        :sort-order="sortOrder"
        :current-page="currentPage"
        :items-per-page="itemsPerPage"
        :statuses="statuses"
        @toggle-sort="toggleSort"
        @change-page="handlePageChange"
        @previous-page="handlePrevPage"
        @next-page="handleNextPage"
        @view-order="viewOrder"
        @edit-order="editOrder"
        @delete-order="removeOrder"
      />

      <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 border-gray-200 border-t dark:border-gray-700">
        <Pagination
          :current-page="currentPage"
          :total-items="filteredOrders.length"
          :items-per-page="itemsPerPage"
          @prev="handlePrevPage"
          @next="handleNextPage"
          @page="handlePageChange"
        />
      </div>
    </div>
  </div>

  <!-- Add Order Modal -->
  @if(showAddModal)
    <div class="fixed inset-0 overflow-y-auto z-10">
      <div class="flex items-end justify-center sm:items-center p-4 sm:p-0 min-h-full text-center">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeAddModal"></div>

        <div class="overflow-hidden relative pb-4 pt-5 px-4 sm:my-8 sm:p-6 sm:max-w-lg sm:w-full text-left bg-white dark:bg-blue-gray-800 rounded-lg shadow-xl transition-all transform">
          <div>
            <div class="mt-3 sm:mt-5 text-center">
              <h3 class="font-semibold leading-6 text-base text-gray-900 dark:text-white">Add New Order</h3>
              <div class="mt-4">
                <div class="space-y-4">
                  <div>
                    <label for="order-customer" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-gray-200">Customer ID</label>
                    <div class="mt-2">
                      <input
                        type="number"
                        id="order-customer"
                        v-model="newOrder.customer_id"
                        class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-blue-gray-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm"
                        placeholder="Enter customer ID"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="order-total" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-gray-200">Total Amount</label>
                    <div class="mt-2">
                      <input
                        type="number"
                        id="order-total"
                        v-model="newOrder.total_amount"
                        step="0.01"
                        class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white placeholder:text-gray-400 dark:bg-blue-gray-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm"
                        placeholder="Enter total amount"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="order-type" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-gray-200">Order Type</label>
                    <div class="mt-2">
                      <select
                        id="order-type"
                        v-model="newOrder.order_type"
                        class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-blue-gray-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm"
                      >
                        <option value="delivery">Delivery</option>
                        <option value="pickup">Pickup</option>
                        <option value="dine-in">Dine-in</option>
                      </select>
                    </div>
                  </div>

                  <div>
                    <label for="order-status" class="block font-medium leading-6 text-gray-900 text-left text-sm dark:text-gray-200">Status</label>
                    <div class="mt-2">
                      <select
                        id="order-status"
                        v-model="newOrder.status"
                        class="block py-1.5 w-full text-gray-900 sm:leading-6 sm:text-sm dark:text-white dark:bg-blue-gray-700 border-0 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 focus:ring-2 focus:ring-blue-600 focus:ring-inset shadow-sm"
                      >
                        @foreach(statuses.slice(1) as status)
                          <option :value="status">{{ status }}</option>
                        @endforeach
                      </select>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="sm:grid sm:gap-3 sm:grid-cols-2 sm:grid-flow-row-dense mt-5 sm:mt-6">
            <button
              type="button"
              @click="addOrder"
              class="inline-flex justify-center sm:col-start-2 px-3 py-2 w-full font-semibold text-sm text-white bg-blue-600 hover:bg-blue-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-blue-600 focus-visible:outline-offset-2 shadow-sm"
            >
              Add Order
            </button>
            <button
              type="button"
              @click="closeAddModal"
              class="inline-flex justify-center sm:col-start-1 mt-3 px-3 py-2 sm:mt-0 w-full font-semibold text-gray-900 text-sm dark:text-white bg-white dark:bg-blue-gray-700 hover:bg-gray-50 dark:hover:bg-blue-gray-600 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 shadow-sm"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  @endif

  <!-- Delete Order Confirmation Modal -->
  @if(showDeleteModal)
    <div class="fixed inset-0 overflow-y-auto z-10">
      <div class="flex items-end justify-center sm:items-center p-4 sm:p-0 min-h-full text-center">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" @click="closeDeleteModal"></div>

        <div class="overflow-hidden relative pb-4 pt-5 px-4 sm:my-8 sm:p-6 sm:max-w-lg sm:w-full text-left bg-white dark:bg-blue-gray-800 rounded-lg shadow-xl transition-all transform">
          <div>
            <div class="flex items-center justify-center mx-auto h-12 w-12 bg-red-100 dark:bg-red-900 rounded-full">
              <div class="h-6 w-6 text-red-600 dark:text-red-400 i-hugeicons-alert-triangle"></div>
            </div>
            <div class="mt-3 sm:mt-5 text-center">
              <h3 class="font-semibold leading-6 text-base text-gray-900 dark:text-white">Delete Order</h3>
              <div class="mt-2">
                <p class="text-gray-500 text-sm dark:text-gray-400">
                  Are you sure you want to delete order <strong>#{{ orderToDelete?.id }}</strong>? This action cannot be undone.
                </p>
              </div>
            </div>
          </div>
          <div class="sm:grid sm:gap-3 sm:grid-cols-2 sm:grid-flow-row-dense mt-5 sm:mt-6">
            <button
              type="button"
              @click="confirmDelete"
              class="inline-flex justify-center sm:col-start-2 px-3 py-2 w-full font-semibold text-sm text-white bg-red-600 hover:bg-red-500 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-600 shadow-sm"
            >
              Delete Order
            </button>
            <button
              type="button"
              @click="closeDeleteModal"
              class="inline-flex justify-center sm:col-start-1 mt-3 px-3 py-2 sm:mt-0 w-full font-semibold text-gray-900 text-sm dark:text-white bg-white dark:bg-blue-gray-700 hover:bg-gray-50 dark:hover:bg-blue-gray-600 ring-1 ring-gray-300 ring-inset rounded-md dark:ring-gray-600 shadow-sm"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    </div>
  @endif
</div>
<script client lang="ts">
import { onMount } from 'stx'

onMount(async () => {
  await fetchOrders()
})
</script>
