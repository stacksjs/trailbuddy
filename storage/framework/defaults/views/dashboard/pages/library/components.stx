<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let components = []
let categories = ['All', 'Forms', 'Layout', 'Overlay', 'Data', 'Display', 'Navigation']

try {
  const res = await fetch(API_URL + '/library/components')
  if (res.ok) {
    const json = await res.json()
    components = json.components || []
    categories = json.categories || categories
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Components</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Browse and manage your UI component library</p>
      </div>
      <div class="flex gap-3 items-center">
        <button class="px-4 py-2 font-medium text-gray-700 text-sm dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600">Import</button>
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">New Component</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <!-- Filter Tabs -->
      <div class="flex gap-2">
        @foreach (categories as category)
          <button class="px-3 py-1.5 font-medium text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 bg-blue-600 hover:bg-blue-700' hover:bg-gray-100 dark:hover:bg-gray-700' rounded-lg : ? 'All' 'text-gray-500 'text-white {{ }} === category">
            {{ category }}
          </button>
        @endforeach
      </div>

      <!-- Components Grid -->
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        @foreach (components as component)
          <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
            <div class="flex items-center justify-between mb-4">
              <span class="font-semibold text-gray-900 dark:text-white">{{ component.name }}</span>
              <span class="px-2.5 py-1 font-semibold text-blue-700 text-xs dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 rounded-full">{{ component.category }}</span>
            </div>
            <div class="text-gray-600 dark:text-gray-400">
              <p class="text-gray-500 dark:text-gray-400">{{ component.description }}</p>
              <div class="flex items-center justify-between mt-4">
                <span class="text-gray-500 text-sm dark:text-gray-400">{{ component.instances }} instances</span>
                <button class="px-3 py-1.5 font-medium text-gray-500 text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">View</button>
              </div>
            </div>
          </div>
        @endforeach
      </div>
    </div>
  </div>
