<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let stats = []
let topProducts = []
let salesByRegion = []
let revenueByChannel = []

try {
  const res = await fetch(API_URL + '/analytics/commerce')
  if (res.ok) {
    const json = await res.json()
    stats = json.stats || []
    topProducts = json.topProducts || []
    salesByRegion = json.salesByRegion || []
    revenueByChannel = json.revenueByChannel || []
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Commerce Analytics</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Sales and revenue insights</p>
      </div>
      <div class="flex gap-3 items-center">
        <select class="px-3 py-2 w-40 text-gray-900 text-sm dark:text-white bg-white dark:bg-gray-800 border border-gray-300 rounded-lg dark:border-gray-600 focus:ring-2 focus:ring-blue-500">
          <option>Last 7 days</option>
          <option>Last 30 days</option>
          <option>Last 90 days</option>
          <option>This year</option>
        </select>
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Export</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        @foreach (stats as stat)
          <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
            <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stat.value }}</div>
            <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">{{ stat.label }}</div>
            <div class="font-medium text-sm dark:text-gray-400' dark:text-green-400' dark:text-red-400' : : ? ? 'text-gray-500 'text-green-600 'text-red-600 {{ }} stat.change.startsWith('-') stat.change.startsWith('+')">{{ stat.change }}</div>
          </div>
        @endforeach
      </div>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2">
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Top Products</span>
          </div>
          <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
            <table class="w-full text-sm">
              <thead class="bg-gray-50 dark:bg-gray-700/50">
                <tr>
                  <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Product</th>
                  <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Revenue</th>
                  <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Units</th>
                  <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Growth</th>
                </tr>
              </thead>
              <tbody>
                @foreach (topProducts as product)
                  <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                    <td class="px-4 py-3 font-medium text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ product.name }}</td>
                    <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ product.revenue }}</td>
                    <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ product.units }}</td>
                    <td class="px-4 py-3 text-green-600 dark:text-green-400 border-gray-100 border-t dark:border-gray-700">{{ product.growth }}</td>
                  </tr>
                @endforeach
              </tbody>
            </table>
          </div>
        </div>

        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Sales by Region</span>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (salesByRegion as region)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ region.region }}</div>
                  <div class="overflow-hidden mt-1 h-2 w-32 bg-gray-200 rounded-full">
                    <div class="h-full bg-blue-500 rounded-full" style="width: {{ region.percentage }}%;"></div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="font-semibold">{{ region.revenue }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ region.orders }} orders</div>
                </div>
              </div>
            @endforeach
          </div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Revenue by Channel</span>
        </div>
        <div class="p-6">
          <div class="flex justify-around">
            @foreach (revenueByChannel as channel)
              <div class="text-center">
                <div class="font-bold text-3xl">{{ channel.percentage }}%</div>
                <div class="mt-1 text-gray-500 dark:text-gray-400">{{ channel.channel }}</div>
                <div class="mt-2 font-semibold text-success">{{ channel.revenue }}</div>
              </div>
            @endforeach
          </div>
        </div>
      </div>
    </div>
  </div>
