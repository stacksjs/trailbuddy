<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let stats = []
let dailySales = []
let paymentMethods = []
let salesTeam = []

try {
  const res = await fetch(API_URL + '/analytics/sales')
  if (res.ok) {
    const json = await res.json()
    stats = json.stats || []
    dailySales = json.dailySales || []
    paymentMethods = json.paymentMethods || []
    salesTeam = json.salesTeam || []
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Sales Analytics</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Detailed sales performance</p>
      </div>
      <div class="flex gap-3 items-center">
        <select class="px-3 py-2 w-40 text-gray-900 text-sm dark:text-white bg-white dark:bg-gray-800 border border-gray-300 rounded-lg dark:border-gray-600 focus:ring-2 focus:ring-blue-500">
          <option>Last 7 days</option>
          <option>Last 30 days</option>
          <option>Last 90 days</option>
        </select>
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Export</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        @foreach (stats as stat)
          <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
            <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stat.value }}</div>
            <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">{{ stat.label }}</div>
            <div class="font-medium text-sm dark:text-gray-400' dark:text-green-400' dark:text-red-400' : : ? ? 'text-gray-500 'text-green-600 'text-red-600 {{ }} stat.change.startsWith('-') stat.change.startsWith('+')">
              {{ stat.change }}
            </div>
          </div>
        @endforeach
      </div>

      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Daily Sales</span>
        </div>
        <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 dark:bg-gray-700/50">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Date</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Sales</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Orders</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Avg Order</th>
              </tr>
            </thead>
            <tbody>
              @foreach (dailySales as day)
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ day.date }}</td>
                  <td class="px-4 py-3 font-semibold text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ day.sales }}</td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ day.orders }}</td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ day.avgOrder }}</td>
                </tr>
              @endforeach
            </tbody>
          </table>
        </div>
      </div>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2">
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Payment Methods</span>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (paymentMethods as pm)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ pm.method }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ pm.transactions }} transactions</div>
                </div>
                <div class="text-right">
                  <div class="font-semibold">{{ pm.amount }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ pm.percentage }}%</div>
                </div>
              </div>
            @endforeach
          </div>
        </div>

        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Sales Team Performance</span>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (salesTeam as member)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ member.name }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ member.deals }} deals &middot; {{ member.avgDeal }} avg</div>
                </div>
                <span class="font-semibold text-green-600 dark:text-green-400">{{ member.closed }}</span>
              </div>
            @endforeach
          </div>
        </div>
      </div>
    </div>
  </div>
