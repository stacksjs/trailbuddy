<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let declared = []
let transitive = []
let thirdParty = []
let workspace = []
let stats = []
let totalCount = 0
let transitiveCount = 0
let workspaceCount = 0
let thirdPartyCount = 0

try {
  const res = await fetch(API_URL + '/library/dependencies')
  if (res.ok) {
    const json = await res.json()
    declared = json.declared || []
    transitive = json.transitive || []
    thirdParty = json.thirdParty || []
    workspace = json.workspace || []
    stats = json.stats || []
    totalCount = json.totalCount || 0
    transitiveCount = json.transitiveCount || 0
    workspaceCount = json.workspaceCount || 0
    thirdPartyCount = json.thirdPartyCount || 0
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Dependencies</h1>
      <p class="mt-1 text-gray-500 dark:text-gray-400">{{ totalCount }} packages — {{ declared.length }} declared, {{ transitiveCount }} transitive</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4 mb-6">
    @foreach (stats as stat)
      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
        <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stat.value }}</div>
        <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">{{ stat.label }}</div>
      </div>
    @endforeach
  </div>

  <!-- Third-Party Packages (declared) -->
  <div class="mb-6 p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
    <div class="flex items-center justify-between mb-4">
      <span class="font-semibold text-gray-900 dark:text-white">Third-Party Packages</span>
      <span class="text-gray-500 text-xs dark:text-gray-400">{{ thirdPartyCount }} declared</span>
    </div>
    <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-700/50">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Package</th>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Version</th>
          </tr>
        </thead>
        <tbody>
          @foreach (thirdParty as pkg)
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 border-gray-200 border-t dark:border-gray-700">
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{{ pkg.name }}</td>
              <td class="px-4 py-3 font-mono text-gray-500 text-xs dark:text-gray-400">{{ pkg.version }}</td>
            </tr>
          @endforeach
        </tbody>
      </table>
    </div>
  </div>

  <!-- Workspace Packages (declared) -->
  <div class="mb-6 p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
    <div class="flex items-center justify-between mb-4">
      <span class="font-semibold text-gray-900 dark:text-white">Workspace Packages</span>
      <span class="text-gray-500 text-xs dark:text-gray-400">{{ workspaceCount }} packages</span>
    </div>
    <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-700/50">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Package</th>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Version</th>
          </tr>
        </thead>
        <tbody>
          @foreach (workspace as pkg)
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 border-gray-200 border-t dark:border-gray-700">
              <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">{{ pkg.name }}</td>
              <td class="px-4 py-3 font-mono text-gray-500 text-xs dark:text-gray-400">{{ pkg.version }}</td>
            </tr>
          @endforeach
        </tbody>
      </table>
    </div>
  </div>

  <!-- Transitive Dependencies -->
  <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
    <div class="flex items-center justify-between mb-4">
      <span class="font-semibold text-gray-900 dark:text-white">Transitive Dependencies</span>
      <span class="text-gray-500 text-xs dark:text-gray-400">{{ transitiveCount }} packages</span>
    </div>
    <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 dark:bg-gray-700/50">
          <tr>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Package</th>
            <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Version</th>
          </tr>
        </thead>
        <tbody>
          @foreach (transitive as pkg)
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30 border-gray-200 border-t dark:border-gray-700">
              <td class="px-4 py-3 font-medium text-gray-500 dark:text-gray-400">{{ pkg.name }}</td>
              <td class="px-4 py-3 font-mono text-gray-400 text-xs dark:text-gray-500">{{ pkg.version }}</td>
            </tr>
          @endforeach
        </tbody>
      </table>
    </div>
  </div>
</div>
