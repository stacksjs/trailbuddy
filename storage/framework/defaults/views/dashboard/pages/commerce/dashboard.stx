<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let stats = []
let recentOrders = []
let topProducts = []

try {
  const res = await fetch(API_URL + '/commerce/dashboard')
  if (res.ok) {
    const json = await res.json()
    stats = json.stats || []
    recentOrders = json.recentOrders || []
    topProducts = json.topProducts || []
  }
} catch (e) {
  // API not available
}

function statusClass(s) {
  if (!s) return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
  s = String(s).toLowerCase()
  if (['active','success','healthy','connected','running','published','approved','valid','up-to-date'].indexOf(s) >= 0)
    return 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400'
  if (['pending','scheduled','warning','low-stock','draft','update-available'].indexOf(s) >= 0)
    return 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400'
  if (['failed','error','inactive','cancelled','spam','rejected','out-of-stock'].indexOf(s) >= 0)
    return 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'
  if (['info','completed','processing'].indexOf(s) >= 0)
    return 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'
  return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Commerce Dashboard</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Sales overview and analytics</p>
      </div>
      <div class="flex gap-3 items-center">
        <button class="px-4 py-2 font-medium text-gray-700 text-sm dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600">Export Report</button>
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">New Order</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        @foreach (stats as stat)
          <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
            <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stat.value }}</div>
            <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">{{ stat.label }}</div>
            <div class="font-medium text-green-600 text-sm dark:text-green-400">{{ stat.change }}</div>
          </div>
        @endforeach
      </div>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2">
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Recent Orders</span>
            <button class="px-3 py-1.5 font-medium text-gray-500 text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">View All</button>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (recentOrders as order)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ order.id }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ order.customer }} &middot; {{ order.time }}</div>
                </div>
                <div class="flex gap-3 items-center">
                  <span class="font-semibold">{{ order.total }}</span>
                  <span class="px-2.5 py-1 font-semibold text-xs rounded-full {{ }} statusClass(order.status)">{{ order.status }}</span>
                </div>
              </div>
            @endforeach
          </div>
        </div>

        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Top Products</span>
            <button class="px-3 py-1.5 font-medium text-gray-500 text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">View All</button>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (topProducts as product)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ product.name }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ product.sales }} sales</div>
                </div>
                <span class="font-semibold text-green-600 dark:text-green-400">{{ product.revenue }}</span>
              </div>
            @endforeach
          </div>
        </div>
      </div>
    </div>
  </div>
