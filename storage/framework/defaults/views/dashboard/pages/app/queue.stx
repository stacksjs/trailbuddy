<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let queues = []
let stats = { totalQueues: 0, totalJobs: 0, activeJobs: 0, completedJobs: 0, failedJobs: 0, throughputPerMinute: 0 }
let queueConnected = false

try {
  const res = await fetch(API_URL + '/queue/stats')
  if (res.ok) {
    const json = await res.json()
    queues = json.queues || []
    stats = json.stats || { totalQueues: 0, totalJobs: 0, activeJobs: 0, completedJobs: 0, failedJobs: 0, throughputPerMinute: 0 }
    queueConnected = json.queueConnected || false
  }
} catch (e) {
  // API not available
}

function statusClass(s) {
  if (!s) return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
  s = String(s).toLowerCase()
  if (s === 'active' || s === 'healthy' || s === 'running')
    return 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400'
  if (s === 'paused' || s === 'idle')
    return 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400'
  if (s === 'failed' || s === 'error' || s === 'stopped')
    return 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'
  return 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Queue</h1>
      <p class="mt-1 text-gray-500 dark:text-gray-400">Monitor job queues powered by bun-queue</p>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="grid gap-4 grid-cols-2 md:grid-cols-4 mb-6">
    <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <div class="font-medium text-gray-500 text-sm dark:text-gray-400">Total Queues</div>
      <div class="mt-1 font-bold text-2xl text-gray-900 dark:text-white">{{ stats.totalQueues }}</div>
    </div>
    <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <div class="font-medium text-gray-500 text-sm dark:text-gray-400">Active Jobs</div>
      <div class="mt-1 font-bold text-2xl text-blue-600 dark:text-blue-400">{{ stats.activeJobs }}</div>
    </div>
    <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <div class="font-medium text-gray-500 text-sm dark:text-gray-400">Completed</div>
      <div class="mt-1 font-bold text-2xl text-green-600 dark:text-green-400">{{ stats.completedJobs }}</div>
    </div>
    <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <div class="font-medium text-gray-500 text-sm dark:text-gray-400">Failed</div>
      <div class="mt-1 font-bold text-2xl text-red-600 dark:text-red-400">{{ stats.failedJobs }}</div>
    </div>
  </div>

  @if (!queueConnected)
    <div class="p-12 text-center bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 rounded-xl dark:border-yellow-800">
      <svg class="mx-auto h-12 w-12 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h3 class="mt-4 font-medium text-lg text-yellow-900 dark:text-yellow-200">Queue Not Connected</h3>
      <p class="mt-2 text-yellow-700 dark:text-yellow-300">The bun-queue devtools API is not running on port 4400. Start your queue worker to see queue data here.</p>
    </div>
  @elseif (queues.length === 0)
    <div class="p-12 text-center bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
      </svg>
      <h3 class="mt-4 font-medium text-gray-900 text-lg dark:text-white">No Queues Found</h3>
      <p class="mt-2 text-gray-500 dark:text-gray-400">Start a queue worker to see queue data here.</p>
    </div>
  @else
    <!-- Queue Cards -->
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3 mb-6">
      @foreach (queues as queue)
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">{{ queue.name }}</span>
            <span class="px-2.5 py-1 font-semibold text-xs rounded-full {{ }} statusClass(queue.status)">{{ queue.status }}</span>
          </div>
          <div class="grid gap-4 grid-cols-2 mt-4">
            <div>
              <div class="font-semibold text-2xl text-gray-900 dark:text-white">{{ queue.pending }}</div>
              <div class="text-gray-500 text-sm dark:text-gray-400">Pending</div>
            </div>
            <div>
              <div class="font-semibold text-2xl text-blue-600 dark:text-blue-400">{{ queue.active }}</div>
              <div class="text-gray-500 text-sm dark:text-gray-400">Active</div>
            </div>
            <div>
              <div class="font-semibold text-2xl text-red-600 dark:text-red-400">{{ queue.failed }}</div>
              <div class="text-gray-500 text-sm dark:text-gray-400">Failed</div>
            </div>
            <div>
              <div class="font-semibold text-2xl text-green-600 dark:text-green-400">{{ queue.completed }}</div>
              <div class="text-gray-500 text-sm dark:text-gray-400">Completed</div>
            </div>
          </div>
        </div>
      @endforeach
    </div>
  @endif

</div>
