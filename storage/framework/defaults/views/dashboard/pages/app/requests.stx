<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let requests = []
let stats = []

try {
  const res = await fetch(API_URL + '/infrastructure/requests')
  if (res.ok) {
    const json = await res.json()
    requests = json.requests || []
    stats = json.stats || []
  }
} catch (e) {
  // API not available
}

function methodClass(m) {
  if (!m) return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
  m = String(m).toUpperCase()
  if (m === 'GET') return 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400'
  if (m === 'POST') return 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'
  if (m === 'PUT' || m === 'PATCH') return 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400'
  if (m === 'DELETE') return 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'
  return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Requests</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Monitor API requests and responses</p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-4">
        @foreach (stats as stat)
          <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
            <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stat.value }}</div>
            <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">{{ stat.label }}</div>
          </div>
        @endforeach
      </div>

      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Recent Requests</span>
          <button class="px-3 py-1.5 font-medium text-gray-500 text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Live</button>
        </div>
        <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 dark:bg-gray-700/50">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Method</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Path</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Status</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Time</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Timestamp</th>
              </tr>
            </thead>
            <tbody>
              @foreach (requests as req)
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">
                    <span class="px-2.5 py-1 font-semibold text-xs rounded-full {{ }} methodClass(req.method)">{{ req.method }}</span>
                  </td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700"><code class="px-1.5 py-0.5 font-mono text-xs bg-gray-100 dark:bg-gray-700 rounded">{{ req.path }}</code></td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">
                    <span class="px-2.5 py-1 font-semibold text-green-700 text-red-700 text-xs dark:text-green-400' dark:text-red-400' dark:bg-green-900/30 dark:bg-red-900/30 rounded-full : ? 'bg-green-100 'bg-red-100 {{ }} < 400 req.status">{{ req.status }}</span>
                  </td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ req.time }}</td>
                  <td class="px-4 py-3 text-gray-500 dark:text-gray-400 border-gray-100 border-t dark:border-gray-700">{{ req.timestamp }}</td>
                </tr>
              @endforeach
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
