<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let channels = []
let stats = { activeConnections: 0, messagesPerMinute: '0', avgLatency: '-' }

try {
  const res = await fetch(API_URL + '/realtime/stats')
  if (res.ok) {
    const json = await res.json()
    channels = json.channels || []
    stats = json.stats || { activeConnections: 0, messagesPerMinute: '0', avgLatency: '-' }
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Realtime</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">WebSocket connections and channels</p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
          <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stats.activeConnections }}</div>
          <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">Active Connections</div>
        </div>
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
          <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stats.messagesPerMinute }}</div>
          <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">Messages/min</div>
        </div>
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
          <div class="font-bold text-2xl text-gray-900 dark:text-white">{{ stats.avgLatency }}</div>
          <div class="mt-1 text-gray-500 text-sm dark:text-gray-400">Avg Latency</div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Active Channels</span>
        </div>
        <div class="divide-gray-100 divide-y dark:divide-gray-700">
          @foreach (channels as channel)
            <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
              <div class="flex-1 min-w-0">
                <div class="font-medium text-gray-900 dark:text-white">{{ channel.name }}</div>
                <div class="text-gray-500 text-sm dark:text-gray-400">{{ channel.messages }}</div>
              </div>
              <span class="px-2.5 py-1 font-semibold text-green-700 text-xs dark:text-green-400 bg-green-100 dark:bg-green-900/30 rounded-full">{{ channel.connections }} connected</span>
            </div>
          @endforeach
        </div>
      </div>
    </div>
  </div>
