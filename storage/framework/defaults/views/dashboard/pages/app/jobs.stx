<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let jobs = []
let queueConnected = false

try {
  const res = await fetch(API_URL + '/jobs/')
  if (res.ok) {
    const json = await res.json()
    jobs = json.jobs || []
    queueConnected = json.queueConnected || false
  }
} catch (e) {
  // API not available
}

function statusClass(s) {
  if (!s) return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
  s = String(s).toLowerCase()
  if (s === 'active' || s === 'processing')
    return 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400'
  if (s === 'completed' || s === 'success')
    return 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400'
  if (s === 'pending' || s === 'waiting')
    return 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400'
  if (s === 'failed' || s === 'error')
    return 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'
  return 'bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300'
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Jobs</h1>
      <p class="mt-1 text-gray-500 dark:text-gray-400">Background job management powered by bun-queue</p>
    </div>
  </div>

  @if (!queueConnected)
    <div class="p-12 text-center bg-yellow-50 dark:bg-yellow-900/20 border border-yellow-200 rounded-xl dark:border-yellow-800">
      <svg class="mx-auto h-12 w-12 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h3 class="mt-4 font-medium text-lg text-yellow-900 dark:text-yellow-200">Queue Not Connected</h3>
      <p class="mt-2 text-yellow-700 dark:text-yellow-300">The bun-queue devtools API is not running on port 4400. Start your queue worker to see job data here.</p>
    </div>
  @elseif (jobs.length === 0)
    <div class="p-12 text-center bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
      </svg>
      <h3 class="mt-4 font-medium text-gray-900 text-lg dark:text-white">No Jobs Found</h3>
      <p class="mt-2 text-gray-500 dark:text-gray-400">Dispatch a job to see it here.</p>
    </div>
  @else
    <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
      <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-700/50">
            <tr>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Job</th>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Queue</th>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Attempts</th>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Duration</th>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Created</th>
              <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Status</th>
            </tr>
          </thead>
          <tbody>
            @foreach (jobs as job)
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ job.name }}</td>
                <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">
                  <span class="px-2.5 py-1 font-semibold text-gray-600 text-xs dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-full">{{ job.queue }}</span>
                </td>
                <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">{{ job.attempts }}/{{ job.maxAttempts }}</td>
                <td class="px-4 py-3 font-mono text-gray-500 text-xs dark:text-gray-400 border-gray-100 border-t dark:border-gray-700">{{ job.duration }}</td>
                <td class="px-4 py-3 text-gray-500 text-xs dark:text-gray-400 border-gray-100 border-t dark:border-gray-700">{{ job.createdAt }}</td>
                <td class="px-4 py-3 border-gray-100 border-t dark:border-gray-700">
                  <span class="px-2.5 py-1 font-semibold text-xs rounded-full {{ }} statusClass(job.status)">{{ job.status }}</span>
                </td>
              </tr>
            @endforeach
          </tbody>
        </table>
      </div>
    </div>
  @endif
</div>
