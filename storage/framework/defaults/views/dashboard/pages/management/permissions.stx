<script server>
const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

let roles = []
let permissions = []
let recentChanges = []

try {
  const res = await fetch(API_URL + '/infrastructure/permissions')
  if (res.ok) {
    const json = await res.json()
    roles = json.roles || []
    permissions = json.permissions || []
    recentChanges = json.recentChanges || []
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Permissions</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Roles and access control</p>
      </div>
      <div class="flex gap-3 items-center">
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Create Role</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2">
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Roles</span>
          </div>
          <div class="divide-gray-100 divide-y dark:divide-gray-700">
            @foreach (roles as role)
              <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-gray-900 dark:text-white">{{ role.name }}</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ role.description }}</div>
                </div>
                <div class="text-right">
                  <div class="text-sm">{{ role.users }} users</div>
                  <div class="text-gray-500 text-sm dark:text-gray-400">{{ role.permissions }}</div>
                </div>
              </div>
            @endforeach
          </div>
        </div>

        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex items-center justify-between mb-4">
            <span class="font-semibold text-gray-900 dark:text-white">Permission Groups</span>
          </div>
          <div class="p-4">
            @foreach (permissions as group)
              <div class="mb-4">
                <div class="mb-2 font-medium">{{ group.group }}</div>
                <div class="flex flex-wrap gap-2">
                  @foreach (group.items as item)
                    <span class="px-2.5 py-1 font-semibold text-gray-600 text-xs dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-full">{{ item }}</span>
                  @endforeach
                </div>
              </div>
            @endforeach
          </div>
        </div>
      </div>

      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Recent Changes</span>
        </div>
        <div class="divide-gray-100 divide-y dark:divide-gray-700">
          @foreach (recentChanges as change)
            <div class="flex gap-3 items-center p-4 hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
              <div class="flex-1 min-w-0">
                <div class="font-medium text-gray-900 dark:text-white">{{ change.action }}: {{ change.target }}</div>
                <div class="text-gray-500 text-sm dark:text-gray-400">by {{ change.user }}</div>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{{ change.time }}</span>
            </div>
          @endforeach
        </div>
      </div>
    </div>
  </div>
