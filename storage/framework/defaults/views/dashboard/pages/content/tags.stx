<script server>
/**
 * Tags Page
 *
 * Manage content tags.
 */

const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

var tags = []

try {
  const res = await fetch(API_URL + '/dashboard/cms/tags')
  if (res.ok) {
    const json = await res.json()
    tags = json.tags || []
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Tags</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Manage content tags</p>
      </div>
      <div class="flex gap-3 items-center">
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">New Tag</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      @if (tags.length === 0)
        <div class="p-12 text-center bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
          </svg>
          <h3 class="mt-4 font-medium text-gray-900 text-lg dark:text-white">No tags yet</h3>
          <p class="mt-2 text-gray-500 dark:text-gray-400">Get started by creating your first tag.</p>
          <button class="mt-4 px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Create Tag</button>
        </div>
      @else
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
          <div class="flex flex-wrap gap-2">
            @foreach (tags as tag)
              <span class="px-4 py-2 font-semibold text-blue-700 text-sm dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                #{{ tag.name }} ({{ tag.count }})
              </span>
            @endforeach
          </div>
        </div>
      @endif
    </div>
  </div>
