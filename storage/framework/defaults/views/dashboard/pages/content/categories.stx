<script server>
/**
 * Categories Page
 */

const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

var categories = []

try {
  const res = await fetch(API_URL + '/dashboard/cms/categories')
  if (res.ok) {
    const json = await res.json()
    categories = json.categories || []
  }
} catch (e) {
  // API not available
}
</script>

<div ref="pageRoot">
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
  <div class="flex items-start justify-between mb-8">
    <div>
      <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Categories</h1>
      <p class="mt-1 text-gray-500 dark:text-gray-400">Organize your content with categories</p>
    </div>
    <div class="flex gap-3 items-center">
      <button id="newCategoryBtn" class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">
        <span class="flex gap-2 items-center">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          New Category
        </span>
      </button>
    </div>
  </div>

  <div class="flex flex-col gap-6">
    <!-- Stats -->
    <div class="grid gap-4 grid-cols-1 md:grid-cols-3">
      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
        <div class="flex gap-4 items-center">
          <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
            <svg class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
            </svg>
          </div>
          <div>
            <p class="text-gray-500 text-sm dark:text-gray-400">Total Categories</p>
            <p class="font-bold text-2xl text-gray-900 dark:text-white">{{ categories.length }}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 lg:grid-cols-3" id="categoriesGrid">
      @foreach (categories as category)
        <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow category-card" data-id="{{ category.id }}">
          <div class="flex items-center justify-between mb-4">
            <div class="flex gap-3 items-center">
              <div class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg">
                <svg class="h-5 w-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
              </div>
              <span class="font-semibold text-gray-900 dark:text-white">{{ category.name }}</span>
            </div>
            <span class="px-2.5 py-1 font-semibold text-blue-700 text-xs dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 rounded-full">{{ category.postCount }} posts</span>
          </div>
          <div class="mb-4 text-gray-600 dark:text-gray-400">
            <p class="line-clamp-2 text-sm">{{ category.description || 'No description' }}</p>
            <div class="mt-3">
              <code class="px-2 py-1 text-xs bg-gray-100 dark:bg-gray-700 rounded">/{{ category.slug }}</code>
            </div>
          </div>
          <div class="flex gap-2 items-center justify-end pt-3 border-gray-100 border-t dark:border-gray-700">
            <button class="px-3 py-1.5 font-medium text-blue-600 text-xs hover:text-blue-700 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-lg transition-colors edit-category-btn" data-id="{{ category.id }}" data-name="{{ category.name }}" data-slug="{{ category.slug }}" data-description="{{ category.description }}">Edit</button>
            <button class="px-3 py-1.5 font-medium text-red-600 text-xs hover:text-red-700 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-lg transition-colors delete-category-btn" data-id="{{ category.id }}">Delete</button>
          </div>
        </div>
      @endforeach
    </div>

    @if (categories.length === 0)
      <div class="p-12 text-center bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700">
        <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"></path>
        </svg>
        <h3 class="mt-4 font-medium text-gray-900 text-lg dark:text-white">No categories yet</h3>
        <p class="mt-2 text-gray-500 dark:text-gray-400">Get started by creating your first category.</p>
        <button id="emptyStateNewCategory" class="mt-4 px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Create Category</button>
      </div>
    @endif
  </div>
</div>

<!-- Category Modal -->
<div id="categoryModal" role="dialog" aria-modal="true" aria-label="Category editor" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50" style="display: none;">
  <div class="m-4 max-w-md w-full bg-white dark:bg-gray-800 rounded-2xl shadow-2xl">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 id="modalTitle" class="font-semibold text-gray-900 text-xl dark:text-white">New Category</h2>
      <button id="closeModal" aria-label="Close" class="p-2 text-gray-400 hover:text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <form id="categoryForm" class="p-6 space-y-4">
      <input type="hidden" id="categoryId" name="id" value="">

      <div>
        <label for="name" class="block mb-2 font-medium text-gray-700 text-sm dark:text-gray-300">Name</label>
        <input type="text" id="name" name="name" required
          class="px-4 py-3 w-full dark:text-white dark:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600 focus:border-transparent focus:ring-2 focus:ring-blue-500"
          placeholder="Category name...">
      </div>

      <div>
        <label for="slug" class="block mb-2 font-medium text-gray-700 text-sm dark:text-gray-300">Slug</label>
        <input type="text" id="slug" name="slug"
          class="px-4 py-3 w-full dark:text-white dark:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600 focus:border-transparent focus:ring-2 focus:ring-blue-500"
          placeholder="category-slug">
        <p class="mt-1 text-gray-500 text-xs dark:text-gray-400">Leave empty to auto-generate from name</p>
      </div>

      <div>
        <label for="description" class="block mb-2 font-medium text-gray-700 text-sm dark:text-gray-300">Description</label>
        <textarea id="description" name="description" rows="3"
          class="px-4 py-3 w-full dark:text-white dark:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600 focus:border-transparent focus:ring-2 focus:ring-blue-500 resize-none"
          placeholder="Category description..."></textarea>
      </div>

      <div class="flex gap-3 items-center justify-end pt-4">
        <button type="button" id="cancelBtn" class="px-4 py-2 font-medium text-gray-700 text-sm dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">Cancel</button>
        <button type="submit" class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors">Save Category</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" role="dialog" aria-modal="true" aria-label="Delete confirmation" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50" style="display: none;">
  <div class="m-4 p-6 max-w-md w-full bg-white dark:bg-gray-800 rounded-xl shadow-2xl">
    <div class="text-center">
      <svg class="mx-auto h-12 w-12 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
      </svg>
      <h3 class="mt-4 font-semibold text-gray-900 text-lg dark:text-white">Delete Category</h3>
      <p class="mt-2 text-gray-500 dark:text-gray-400">Are you sure you want to delete this category? Posts in this category will become uncategorized.</p>
    </div>
    <div class="flex gap-3 items-center justify-center mt-6">
      <button id="cancelDeleteBtn" class="px-4 py-2 font-medium text-gray-700 text-sm dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">Cancel</button>
      <button id="confirmDeleteBtn" class="px-4 py-2 font-medium text-sm text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors">Delete</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="bottom-4 fixed right-4 z-50 opacity-0 duration-300 transition-all transform translate-y-full">
  <div class="px-4 py-3 text-white dark:text-gray-900 bg-gray-900 dark:bg-white rounded-lg shadow-lg">
    <span id="toastMessage">Category saved!</span>
  </div>
</div>
</div>

<script client>
var _root = useRef('pageRoot')
const API_BASE = 'http://localhost:3000/cms'
let deleteCategoryId = null

let categoryModal, deleteModal, categoryForm, nameField, slugField

function openNewCategoryModal() {
  var el = _root.current
  if (!el) return
  el.querySelector('#modalTitle').textContent = 'New Category'
  el.querySelector('#categoryId').value = ''
  categoryForm.reset()
  categoryModal.style.display = 'flex'
}

function openEditCategoryModal(id, name, slug, description) {
  var el = _root.current
  if (!el) return
  el.querySelector('#modalTitle').textContent = 'Edit Category'
  el.querySelector('#categoryId').value = id
  nameField.value = name
  slugField.value = slug
  el.querySelector('#description').value = description
  categoryModal.style.display = 'flex'
}

function closeModal() {
  categoryModal.style.display = 'none'
  deleteModal.style.display = 'none'
}

function showToast(message) {
  var el = _root.current
  if (!el) return
  const toast = el.querySelector('#toast')
  el.querySelector('#toastMessage').textContent = message
  toast.style.transform = 'translateY(0)'
  toast.style.opacity = '1'
  useTimeout(() => {
    toast.style.transform = 'translateY(100%)'
    toast.style.opacity = '0'
  }, 3000)
}

function saveCategory(e) {
  e.preventDefault()
  const formData = new FormData(categoryForm)
  const id = formData.get('id')
  const name = formData.get('name')
  const slug = formData.get('slug') || name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')

  fetch(id ? `${API_BASE}/categories/${id}` : `${API_BASE}/categories`, {
    method: id ? 'PATCH' : 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, slug, description: formData.get('description') })
  })
    .then(r => r.json())
    .then(() => {
      showToast(id ? 'Category updated!' : 'Category created!')
      closeModal()
      useTimeout(() => location.reload(), 1000)
    })
    .catch(() => showToast('Failed to save category'))
}

function deleteCategory() {
  if (!deleteCategoryId) return
  fetch(`${API_BASE}/categories/${deleteCategoryId}`, { method: 'DELETE' })
    .then(r => r.json())
    .then(() => {
      showToast('Category deleted!')
      closeModal()
      useTimeout(() => location.reload(), 1000)
    })
    .catch(() => showToast('Failed to delete category'))
}

onMount(function() {
  var el = _root.current
  if (!el) return

  categoryModal = el.querySelector('#categoryModal')
  deleteModal = el.querySelector('#deleteModal')
  categoryForm = el.querySelector('#categoryForm')
  nameField = el.querySelector('#name')
  slugField = el.querySelector('#slug')

  // Auto-generate slug
  nameField.oninput = function() {
    if (!slugField.value || slugField.dataset.auto === 'true') {
      slugField.value = this.value.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '')
      slugField.dataset.auto = 'true'
    }
  }
  slugField.oninput = function() { this.dataset.auto = 'false' }

  // Event bindings
  el.querySelector('#newCategoryBtn').onclick = openNewCategoryModal
  var emptyBtn = el.querySelector('#emptyStateNewCategory')
  if (emptyBtn) emptyBtn.addEventListener('click', openNewCategoryModal)
  el.querySelector('#closeModal').onclick = closeModal
  el.querySelector('#cancelBtn').onclick = closeModal
  el.querySelector('#cancelDeleteBtn').onclick = closeModal
  el.querySelector('#confirmDeleteBtn').onclick = deleteCategory
  categoryForm.onsubmit = saveCategory

  el.querySelectorAll('.edit-category-btn').forEach(btn => {
    btn.onclick = function() {
      openEditCategoryModal(this.dataset.id, this.dataset.name, this.dataset.slug, this.dataset.description)
    }
  })

  el.querySelectorAll('.delete-category-btn').forEach(btn => {
    btn.onclick = function() { deleteCategoryId = this.dataset.id; deleteModal.style.display = 'flex' }
  })

  categoryModal.onclick = e => { if (e.target === categoryModal) closeModal() }
  deleteModal.onclick = e => { if (e.target === deleteModal) closeModal() }

  // Escape key closes modals
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal()
  })
})
</script>
