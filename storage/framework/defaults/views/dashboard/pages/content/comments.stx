                <td class="px-4 py-3">
                  @if (comment.status === 'approved')
                    <span class="px-2.5 py-1 font-semibold text-green-700 text-xs dark:text-green-400 bg-green-100 dark:bg-green-900/30 rounded-full">Approved</span>
