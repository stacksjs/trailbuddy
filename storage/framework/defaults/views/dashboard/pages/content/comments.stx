<script server>
/**
 * Comments Moderation Page
 */

const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

var comments = []
var stats = { total: 0, pending: 0, approved: 0, spam: 0 }

try {
  const res = await fetch(API_URL + '/dashboard/cms/comments')
  if (res.ok) {
    const json = await res.json()
    comments = json.comments || []
    stats = json.stats || { total: 0, pending: 0, approved: 0, spam: 0 }
  }
} catch (e) {
  // API not available
}
</script>

