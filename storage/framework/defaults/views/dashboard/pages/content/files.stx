<script server>
/**
 * Files Page
 *
 * File browser and media management.
 */

const API_URL = 'http://localhost:' + (process.env.PORT_API || '3008')

var files = []
var storage = { used: 0, total: 0, percentage: 0 }

try {
  const res = await fetch(API_URL + '/cms/files')
  if (res.ok) {
    const json = await res.json()
    files = json.files || []
    storage = json.storage || { used: 0, total: 0, percentage: 0 }
  }
} catch (e) {
  // API not available
}
</script>
<div class="p-6 min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="flex items-start justify-between mb-8">
      <div>
        <h1 class="font-bold text-3xl text-gray-900 dark:text-white">Files</h1>
        <p class="mt-1 text-gray-500 dark:text-gray-400">Manage your media and documents</p>
      </div>
      <div class="flex gap-3 items-center">
        <button class="px-4 py-2 font-medium text-gray-700 text-sm dark:text-gray-200 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 border border-gray-300 rounded-lg dark:border-gray-600">New Folder</button>
        <button class="px-4 py-2 font-medium text-sm text-white bg-blue-600 hover:bg-blue-700 rounded-lg">Upload</button>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <!-- Storage Info -->
      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="flex items-center justify-between mb-4">
          <span class="font-semibold text-gray-900 dark:text-white">Storage</span>
          <span class="text-gray-500 dark:text-gray-400">{{ storage.used }} GB of {{ storage.total }} GB used</span>
        </div>
        <div class="overflow-hidden h-2 bg-gray-200 dark:bg-gray-700 rounded-full">
          <div class="h-full bg-blue-600 rounded-full" style="width: {{ storage.percentage }}%"></div>
        </div>
      </div>

      <!-- Files Table -->
      <div class="p-5 bg-white dark:bg-gray-800 border border-gray-200 rounded-xl dark:border-gray-700 hover:shadow-lg transition-shadow">
        <div class="overflow-x-auto border border-gray-200 rounded-xl dark:border-gray-700">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 dark:bg-gray-700/50">
              <tr>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Name</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Type</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Size</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Modified</th>
                <th scope="col" class="px-4 py-3 font-semibold text-gray-500 text-left text-xs tracking-wider uppercase dark:text-gray-400">Actions</th>
              </tr>
            </thead>
            <tbody>
              @foreach (files as file)
                <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                  <td class="px-4 py-3 border-gray-100 border-t dark:border-gray-700">
                    <div class="flex gap-3 items-center">
                      <div class="flex items-center justify-center h-9 w-9 text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-700 rounded-lg">
                        @if (file.type === 'folder')
                          F
                        @elseif (file.type === 'image')
                          I
                        @elseif (file.type === 'document')
                          D
                        @else
                          V
                        @endif
                      </div>
                      <span class="font-medium text-gray-900 dark:text-white">{{ file.name }}</span>
                    </div>
                  </td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">
                    <span class="px-2.5 py-1 font-semibold text-gray-600 text-xs dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-full">{{ file.type }}</span>
                  </td>
                  <td class="px-4 py-3 text-gray-500 dark:text-gray-400 border-gray-100 border-t dark:border-gray-700">
                    @if (file.items)
                      {{ file.items }} items
                    @else
                      {{ file.size }}
                    @endif
                  </td>
                  <td class="px-4 py-3 text-gray-500 dark:text-gray-400 border-gray-100 border-t dark:border-gray-700">{{ file.modified }}</td>
                  <td class="px-4 py-3 text-gray-900 dark:text-white border-gray-100 border-t dark:border-gray-700">
                    <button class="px-3 py-1.5 font-medium text-gray-500 text-xs dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Open</button>
                  </td>
                </tr>
              @endforeach
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
