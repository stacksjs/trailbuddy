      <h1 class="font-semibold text-2xl text-neutral-900 dark:text-white">Dashboard</h1>
      <p class="mt-1 text-neutral-500 text-sm dark:text-neutral-400">
        Welcome back! Here's an overview of your system.
      </p>
    </div>
    <div class="w-44">
      <Select
        value="{{ timeRange }}"
        data-model="timeRange"
      >
        @foreach(timeRangeOptions as option)
          <option value="{{ option }}">{{ option.label }}</option>
        @endforeach
      </Select>
    </div>
  </div>

  <!-- Stats Cards -->
  <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 mb-8">
    @foreach(stats as stat)
      <StatsCard
        title="{{ stat.title }}"
        value="{{ stat }}"
        trend="{{ stat.trend }}"
        trendLabel="{{ stat.trendLabel }}"
        icon="{{ stat.icon }}"
        iconBg="{{ stat.iconBg }}"
      />
    @endforeach
  </div>

  <!-- Quick Links -->
  <div class="mb-8">
    <h2 class="mb-4 font-semibold text-base text-neutral-900 dark:text-white">Quick Links</h2>
    <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      @foreach(quickLinks as link)
        <a href="{{ link.href }}">
          <Card hoverable class="h-full">
            <div class="flex gap-4 items-center">
              <div class="flex-shrink-0 p-3 rounded-xl {{ }} link.color">
                <div class="h-6 w-6 text-white {{ }} link.icon"></div>
              </div>
              <div class="flex-1 min-w-0">
                <p class="font-medium text-neutral-900 text-sm dark:text-white">{{ link.name }}</p>
                <p class="mt-0.5 text-neutral-500 text-sm truncate dark:text-neutral-400">
                  {{ link.description }}
                </p>
              </div>
              <div class="flex-shrink-0 h-5 w-5 text-neutral-400 i-hugeicons-arrow-right-01"></div>
            </div>
          </Card>
        </a>
      @endforeach
    </div>
  </div>

  <!-- System Health and Recent Activity -->
  <div class="grid gap-6 grid-cols-1 lg:grid-cols-2">
    <!-- System Health -->
    <Card>
      <div slot="header" class="flex items-center justify-between">
        <h3 class="font-semibold text-base text-neutral-900 dark:text-white">System Health</h3>
        <a href="/health">
          <Button variant="ghost" size="sm">
            View all
            <div class="ml-1 h-4 w-4 i-hugeicons-arrow-right-01"></div>
          </Button>
        </a>
      </div>

      <div class="-mb-6 -mx-6 divide-neutral-200 divide-y dark:divide-neutral-700">
        @foreach(systemHealth as service)
          <div class="flex items-center justify-between px-6 py-3.5">
            <div class="flex gap-3 items-center">
              <span class="h-2.5 w-2.5 rounded-full {{ }} getStatusDotClass(service.status)"></span>
              <span class="font-medium text-neutral-700 text-sm dark:text-neutral-200">
                {{ service.name }}
              </span>
            </div>
            <div class="flex gap-4 items-center">
              <span class="text-neutral-500 text-sm dark:text-neutral-400">
                {{ service.latency }}
              </span>
              <span class="hidden sm:block text-neutral-500 text-sm dark:text-neutral-400">
                {{ service.uptime }}
              </span>
              <Badge variant="{{ getStatusVariant(service.status) }}" size="sm">
                {{ service.status }}
              </Badge>
            </div>
          </div>
        @endforeach
      </div>
    </Card>

    <!-- Recent Activity -->
    <Card>
      <div slot="header" class="flex items-center justify-between">
        <h3 class="font-semibold text-base text-neutral-900 dark:text-white">Recent Activity</h3>
        <a href="/data/activity">
          <Button variant="ghost" size="sm">
            View all
            <div class="ml-1 h-4 w-4 i-hugeicons-arrow-right-01"></div>
          </Button>
        </a>
      </div>

      <div class="-mb-6 -mx-6 divide-neutral-200 divide-y dark:divide-neutral-700">
        @foreach(recentActivity as activity)
          <div class="flex gap-4 items-center px-6 py-3.5">
            <div class="flex-shrink-0 p-2 rounded-lg {{ }} getActivityStyles(activity.status)">
              <div class="h-5 w-5 {{ }} getActivityIcon(activity.type)"></div>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-medium text-neutral-900 text-sm truncate dark:text-white">
                {{ activity.title }}
              </p>
              <p class="text-neutral-500 text-sm dark:text-neutral-400">
                {{ activity.time }}
              </p>
            </div>
          </div>
        @endforeach
      </div>
    </Card>
  </div>

  <!-- Resources and Documentation -->
  <div class="mt-8">
    <Card>
      <div slot="header">
        <h3 class="font-semibold text-base text-neutral-900 dark:text-white">Resources & Documentation</h3>
      </div>

      <div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        <div class="p-5 bg-blue-50 dark:bg-blue-900/20 rounded-xl">
          <div class="flex gap-4">
            <div class="flex-shrink-0 p-2 bg-blue-100 dark:bg-blue-900/40 rounded-lg">
              <div class="h-5 w-5 text-blue-600 dark:text-blue-400 i-hugeicons-book-open-02"></div>
            </div>
            <div>
              <h4 class="font-semibold text-blue-900 text-sm dark:text-blue-200">Documentation</h4>
              <p class="mt-1 text-blue-700 text-sm dark:text-blue-300">
                Comprehensive guides and API references for developers.
              </p>
              <a
                href="https://docs.stacksjs.org"
                target="_blank"
                class="inline-flex gap-1 items-center mt-3 font-medium text-blue-600 text-sm dark:text-blue-400 hover:text-blue-500"
              >
                View documentation
                <div class="h-4 w-4 i-hugeicons-arrow-right-01"></div>
              </a>
            </div>
          </div>
        </div>

        <div class="p-5 bg-green-50 dark:bg-green-900/20 rounded-xl">
          <div class="flex gap-4">
            <div class="flex-shrink-0 p-2 bg-green-100 dark:bg-green-900/40 rounded-lg">
              <div class="h-5 w-5 text-green-600 dark:text-green-400 i-hugeicons-video-01"></div>
            </div>
            <div>
              <h4 class="font-semibold text-green-900 text-sm dark:text-green-200">Video Tutorials</h4>
              <p class="mt-1 text-green-700 text-sm dark:text-green-300">
                Step-by-step video guides for common tasks and features.
              </p>
              <a
                href="#"
                class="inline-flex gap-1 items-center mt-3 font-medium text-green-600 text-sm dark:text-green-400 hover:text-green-500"
              >
                Watch tutorials
                <div class="h-4 w-4 i-hugeicons-arrow-right-01"></div>
              </a>
            </div>
          </div>
        </div>

        <div class="p-5 bg-purple-50 dark:bg-purple-900/20 rounded-xl">
          <div class="flex gap-4">
            <div class="flex-shrink-0 p-2 bg-purple-100 dark:bg-purple-900/40 rounded-lg">
              <div class="h-5 w-5 text-purple-600 dark:text-purple-400 i-hugeicons-user-group"></div>
            </div>
            <div>
              <h4 class="font-semibold text-purple-900 text-sm dark:text-purple-200">Community</h4>
              <p class="mt-1 text-purple-700 text-sm dark:text-purple-300">
                Join our community forums for support and discussions.
              </p>
              <a
                href="https://discord.gg/stacksjs"
                target="_blank"
                class="inline-flex gap-1 items-center mt-3 font-medium text-purple-600 text-sm dark:text-purple-400 hover:text-purple-500"
              >
                Join community
                <div class="h-4 w-4 i-hugeicons-arrow-right-01"></div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </Card>
  </div>
</DashboardLayout>
<script client lang="ts">
import { onMount } from 'stx'

